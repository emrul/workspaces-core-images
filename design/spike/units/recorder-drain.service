[Unit]
Description=Recorder drain — fired via OnFailure= from window-manager.service
# Skipped (no-op for OnFailure) when no recorder is active. This is
# what makes probe E vs probe D differ: with KASM_SVC_RECORDER unset,
# OnFailure has nothing to invoke and Restart=on-failure fires on
# the WM instead.
ConditionEnvironment=KASM_SVC_RECORDER=1

[Service]
Type=oneshot
ExecStart=/usr/local/bin/recorder-drain.sh
ExitContainerOnFailure=true
