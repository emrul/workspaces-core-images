[Unit]
Description=Webcam helper (PyInstaller bundle)
Requires=webcam.socket
After=kasm-setup.service
ConditionEnvironment=KASM_VNC=1
# No ConditionPathExists=/dev/video0 here: this service is driven by
# webcam.socket in ActivationMode=proxy, and container-init evaluates
# Condition* once at parse/boot time — the proxy accept→spawn path
# (driveProxy→runHelperLoop→spawnAndWait) never re-checks it. A guard
# here would be dead code. The socket listens unconditionally (like
# gamepad/audio-in); the server needs a real /dev/video0 to function
# and exits/StartLimits out on connect if none is present.

[Service]
Type=simple
User=${KASM_OS_USER:-kasm-user}
Group=${KASM_OS_GROUP:-kasm-user}
WorkingDirectory=${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}
ExecStart=/dockerstartup/webcam/kasm_webcam_server --port 14905 --ssl --cert ${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}/.vnc/self.pem --certkey ${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}/.vnc/self.pem
Restart=on-failure
RestartSec=2s
StartLimitBurst=3
StartLimitIntervalSec=60s
