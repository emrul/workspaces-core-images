[Unit]
Description=Back-compat shim — runs /dockerstartup/custom_startup.sh if present
After=window-manager.service
ConditionPathExists=/dockerstartup/custom_startup.sh

[Service]
Type=simple
User=${KASM_OS_USER:-kasm-user}
Group=${KASM_OS_GROUP:-kasm-user}
WorkingDirectory=${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}
Environment=DISPLAY=:1
# Same env handoff as window-manager.service: real bus address +
# XDG_RUNTIME_DIR, overriding orchestrator-injected placeholders.
EnvironmentFile=/tmp/kasm-dbus.env
ExecStart=/dockerstartup/custom_startup.sh
Restart=no
