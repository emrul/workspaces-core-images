[Unit]
Description=Smartcard bridge (kasm_smartcard_bridge)
# See note in printer.service — same correction applies. Xvnc owns
# /tmp/smartcard via its -UnixRelay; smartcard.service is the client.
After=kasmvnc.service pcscd.service
Requires=kasmvnc.service
ConditionEnvironment=KASM_VNC=1
# Auto-skip when the helper binary isn't installed (INCLUDE_SMARTCARD=0).
ConditionPathExists=/dockerstartup/smartcard/kasm_smartcard_bridge

[Service]
Type=simple
User=${KASM_OS_USER:-kasm-user}
Group=${KASM_OS_GROUP:-kasm-user}
WorkingDirectory=${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}
# Gated + relay-waited by kasm-relay-client: KASM_SVC_SMARTCARD uses kasm-xvnc's
# default-enabled semantics, which ConditionEnvironment= cannot express,
# and the relay is created by Xvnc so it may not exist yet.
ExecStart=/usr/local/bin/kasm-relay-client KASM_SVC_SMARTCARD /tmp/smartcard /dockerstartup/smartcard/kasm_smartcard_bridge --relay /tmp/smartcard
Restart=on-failure
RestartSec=2s
StartLimitBurst=3
StartLimitIntervalSec=60s
