[Unit]
Description=Audio-out websocket helper (jsmpeg)
Requires=audio-out-ws.socket
After=kasm-setup.service
ConditionEnvironment=KASM_VNC=1

[Service]
Type=simple
User=${KASM_OS_USER:-kasm-user}
Group=${KASM_OS_GROUP:-kasm-user}
WorkingDirectory=${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}
# Auth token "<user>:<password>". This is NOT prompted to the human — Kasm's
# proxy (nginx) injects the Basic-auth header when it proxies the audio
# websocket, using the fixed KasmVNC *web* username `kasm_user` (from
# .kasmpasswd) : $VNC_PW. So the username MUST be the literal `kasm_user`
# (underscore), NOT $KASM_OS_USER — the OS user is `kasm-user` (hyphen) and a
# per-session rename makes them differ, which 401s the proxied audio and kills
# sound (regression from the bash chain, which used literal `kasm_user`).
# Override the whole token with KASM_AUDIO_AUTH if a deployment differs.
ExecStart=/dockerstartup/jsmpeg/kasm_audio_out-linux kasmaudio 14081 4901 ${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}/.vnc/self.pem ${KASM_OS_HOME:-/home/${KASM_OS_USER:-kasm-user}}/.vnc/self.pem ${KASM_AUDIO_AUTH:-kasm_user:${VNC_PW}}
Restart=on-failure
RestartSec=500ms
StartLimitBurst=5
StartLimitIntervalSec=30s
