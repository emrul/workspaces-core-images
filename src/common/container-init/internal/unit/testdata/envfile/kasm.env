# Kasm-style env file — typical of what kasm-setup.service exports.
# Matches the directives the bash vnc_startup.sh today reads from
# /proc/1/environ.

VNC_RESOLUTION=1280x800
VNC_COL_DEPTH=24
NO_VNC_PORT=6901
MAX_FRAME_RATE=24
KASM_VNC_PATH=/usr/share/kasmvnc
DRINODE=/dev/dri/renderD128

; Workspaces server orchestration vars
KASM_API_HOST=kasm_api
KASM_API_PORT=443

# Service toggles (defaulted on; set to 0 to gate units off)
KASM_VNC=1
KASM_PROFILE_PULL=1
KASM_SVC_AUDIO=1
KASM_SVC_AUDIO_INPUT=1
KASM_SVC_UPLOADS=1
KASM_SVC_GAMEPAD=1
KASM_SVC_WEBCAM=1
KASM_SVC_PRINTER=1
KASM_SVC_SMARTCARD=1
