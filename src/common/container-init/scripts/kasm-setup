#!/bin/sh
# kasm-setup — privileged-context oneshot for Kasm session bootstrap.
# Runs as root from kasm-setup.service before any other unit.
#
#  1. (Phase 4.10) Optional OS-user rename when KASM_OS_USER / _UID /
#     _GID / _GROUP / _HOME differ from defaults.
#  2. mkdirs (/var/run/pulse, /var/log/journal, ${KASM_OS_HOME}/.vnc)
#  3. dbus-launch + export the session-bus address into /tmp/kasm.env
#     so subsequent units can pick it up.
#  4. Cert install: /etc/kasm/self-default.pem -> ${KASM_OS_HOME}/.vnc/self.pem
#     (overrideable via KASM_TLS_CERT_PATH).
#  5. kasmvncpasswd from $VNC_PW.
#  6. Stale X1 lock cleanup so kasmvnc.service can bind :1.
set -eu

KASM_OS_USER=${KASM_OS_USER:-kasm-user}
KASM_OS_UID=${KASM_OS_UID:-1000}
KASM_OS_GID=${KASM_OS_GID:-1000}
KASM_OS_GROUP=${KASM_OS_GROUP:-kasm-user}
if [ -z "${KASM_OS_HOME:-}" ]; then
    if [ "$KASM_OS_USER" = "kasm-user" ]; then
        KASM_OS_HOME=/home/kasm-user
    else
        KASM_OS_HOME=/home/$KASM_OS_USER
    fi
fi

# 1) OS-user rename (Phase 4.10) — no-op when every value matches the default.
if [ "$KASM_OS_USER" != kasm-user ] || [ "$KASM_OS_UID" != 1000 ] \
        || [ "$KASM_OS_GID" != 1000 ] || [ "$KASM_OS_GROUP" != kasm-user ] \
        || [ "$KASM_OS_HOME" != /home/kasm-user ]; then
    /usr/local/bin/kasm-os-user-rename
fi

# 2) Required runtime directories.
install -d -m 0755 -o "$KASM_OS_USER" -g "$KASM_OS_GROUP" "$KASM_OS_HOME/.vnc" "$KASM_OS_HOME/.config" "$KASM_OS_HOME/Uploads" "$KASM_OS_HOME/Downloads" "$KASM_OS_HOME/Desktop" "$KASM_OS_HOME/PDF" 2>/dev/null || true
install -d -m 0755 /var/run/pulse /var/log/journal 2>/dev/null || true
install -d -m 1777 /tmp/.ICE-unix /tmp/.X11-unix 2>/dev/null || true

# 2a) Default-profile sync. The bash chain's kasm_default_profile.sh
# copied /home/kasm-default-profile/. into the user's $HOME on first
# boot — that's where the OOTB image's customised XFCE config
# (xfce4-panel.xml, xfwm4.xml, xfce4-desktop.xml, theme, background)
# lives. Without this step the user gets vanilla XFCE — different
# panel, missing background, etc. Skip when the user already has a
# .bashrc (i.e. profile-pull or operator volume already populated it).
if [ -d /home/kasm-default-profile ] && [ ! -f "$KASM_OS_HOME/.bashrc" ]; then
    cp -rp /home/kasm-default-profile/. "$KASM_OS_HOME/"
    chown -R "$KASM_OS_USER:$KASM_OS_GROUP" "$KASM_OS_HOME"
fi

# 2b) Desktop shortcuts for Uploads/Downloads. Mirrors the bash
# chain's kasm_default_profile.sh `verify_profile_config` step —
# OOTB Kasm puts both folders on the desktop so users have a one-
# click path to drop files into the upload pipeline / pull files
# out via the noVNC RX panel. ln -sfn keeps the link idempotent
# across container restarts and survives profile-sync replays.
ln -sfn "$KASM_OS_HOME/Uploads"   "$KASM_OS_HOME/Desktop/Uploads"   2>/dev/null || true
ln -sfn "$KASM_OS_HOME/Downloads" "$KASM_OS_HOME/Desktop/Downloads" 2>/dev/null || true
chown -h "$KASM_OS_USER:$KASM_OS_GROUP" "$KASM_OS_HOME/Desktop/Uploads" "$KASM_OS_HOME/Desktop/Downloads" 2>/dev/null || true

# 2c) RX-panel Downloads symlink. The KasmVNC HTTP server serves
# /Downloads/ from $KASM_VNC_PATH/www/Downloads — the noVNC client
# reads it to render the in-browser file list. Point it at the
# active user's home so files written there show up in the RX UI.
if [ -n "${KASM_VNC_PATH:-}" ] && [ -d "$KASM_VNC_PATH/www/Downloads" ]; then
    rm -f "$KASM_VNC_PATH/www/Downloads/Downloads"
    ln -sfn "$KASM_OS_HOME/Downloads" "$KASM_VNC_PATH/www/Downloads/Downloads"
fi

# 3) Session D-Bus. Spawn dbus-launch AS the OS user — XFCE's
# xfconfd / xfsettingsd autostart breaks if the bus belongs to a
# different uid. Mirrors what OOTB's vnc_startup.sh does
# (`export $(dbus-launch)` after the su to kasm-user, line 33).
if command -v dbus-launch >/dev/null 2>&1; then
    su -s /bin/sh "$KASM_OS_USER" -c '
        dbus-launch --sh-syntax \
        | sed -n "s/^\(DBUS_SESSION_BUS_ADDRESS\|DBUS_SESSION_BUS_PID\)=\\(.*\\);$/\\1=\\2/p"
    ' > /tmp/kasm-dbus.env
    chmod 0644 /tmp/kasm-dbus.env
fi

# 4) TLS cert: bake-time copy with operator override.
cert_src=${KASM_TLS_CERT_PATH:-/etc/kasm/self-default.pem}
if [ -f "$cert_src" ]; then
    cp -f "$cert_src" "$KASM_OS_HOME/.vnc/self.pem"
    chown "$KASM_OS_USER:$KASM_OS_GROUP" "$KASM_OS_HOME/.vnc/self.pem"
    chmod 0600 "$KASM_OS_HOME/.vnc/self.pem"
fi

# 5) kasmvncpasswd. The binary picks $HOME/.kasmpasswd from the env;
# run it as root with HOME pointing at the target user's home and
# chown the resulting file. Avoids `su` entirely — the login-shell
# form hangs when invoked from container-init's supervised child
# (PAM-session setup races against pid1 reaping on Ubuntu/Noble).
# Full-access record uses the OS username so the noVNC connect prompt
# accepts the same name operators set via KASM_OS_USER. Read-only
# record stays "kasm_viewer" — it's a role designator, not an OS user
# (matches the bash chain's two-record split).
if command -v kasmvncpasswd >/dev/null 2>&1 && [ -n "${VNC_PW:-}" ]; then
    HOME="$KASM_OS_HOME" sh -c "printf '%s\n%s\n\n' '$VNC_PW' '$VNC_PW' | kasmvncpasswd -u '$KASM_OS_USER' -wo" >/dev/null 2>&1 || true
    if [ -n "${VNC_VIEW_ONLY_PW:-}" ]; then
        HOME="$KASM_OS_HOME" sh -c "printf '%s\n%s\n\n' '$VNC_VIEW_ONLY_PW' '$VNC_VIEW_ONLY_PW' | kasmvncpasswd -u kasm_viewer -r" >/dev/null 2>&1 || true
    fi
    if [ -f "$KASM_OS_HOME/.kasmpasswd" ]; then
        chown "$KASM_OS_USER:$KASM_OS_GROUP" "$KASM_OS_HOME/.kasmpasswd"
        chmod 0600 "$KASM_OS_HOME/.kasmpasswd"
    fi
fi

# 6) Disable legacy VncAuth. KasmVNC's perl `vncserver` wrapper has
# a `DisableLegacyVncAuth` sub that writes a fixed 8-byte sentinel
# (base64 "WrLNwLrcrxM=" → bytes 5a b2 cd c0 ba dc af 13) to
# ~/.vnc/passwd. Xvnc reads it via -rfbauth and treats VncAuth as
# disabled; real auth happens at the BasicAuth / WebSocket layer
# via ~/.kasmpasswd. Without this file Xvnc errors out
# mid-handshake with "No password configured for VNC Auth".
# (POSIX `printf '\xHH'` is unreliable across dash/busybox; use
# base64 -d the same way the perl wrapper does.)
sentinel_passwd="$KASM_OS_HOME/.vnc/passwd"
echo 'WrLNwLrcrxM=' | base64 -d > "$sentinel_passwd"
chown "$KASM_OS_USER:$KASM_OS_GROUP" "$sentinel_passwd"
chmod 0600 "$sentinel_passwd"

# 7) Stale X1 lock cleanup.
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true

exit 0
