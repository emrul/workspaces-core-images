#!/bin/sh
# angelfish-launch — GPU-aware launcher for the Nix-built KDE Angelfish browser.
#
# Does the Angelfish-specific desktop tweaks (mobile UI, start maximised) and
# then hands off to /usr/local/bin/nix-launch, which auto-detects an allocated
# GPU and runs Angelfish either GPU-accelerated (Nix VirtualGL + Nix
# vulkan-loader + ANGLE-Vulkan, via nix-gpu-run) or software-rendered.
#
# Angelfish embeds QtWebEngine (Chromium), so it needs the same
# sandbox/zygote handling as Chrome inside a rootless KasmVNC container.
# We resolve the binary by absolute profile path rather than PATH, because
# container-init services don't source /etc/profile.d.
set -u

PROFILE=/nix/var/nix/profiles/angelfish
BIN="${PROFILE}/bin/angelfish"

# ── Mobile device mode ──────────────────────────────────────────────
# Angelfish IS KDE's Plasma Mobile browser; on a desktop it defaults to
# the desktop layout. QT_QUICK_CONTROLS_MOBILE=1 forces Kirigami's
# mobile/touch UI (the phone-style navbar etc. — note the kcfg navBar*
# defaults key off isMobile()). Toggle off with ANGELFISH_MOBILE=0.
# NOTE: this changes the in-app UI, not the web User-Agent — Angelfish
# exposes no UA setting, so sites still see QtWebEngine's default UA.
if [ "${ANGELFISH_MOBILE:-1}" != 0 ]; then
    export QT_QUICK_CONTROLS_MOBILE=1
fi

# ── Start maximised ─────────────────────────────────────────────────
# Angelfish has no --start-maximized flag, so maximise via the window
# manager once its window appears. Backgrounded (with `&`) so it
# survives the `exec` below; the maximised STATE tracks KasmVNC dynamic
# resolution changes, unlike a fixed window geometry. Matches the
# window by WM_CLASS. Toggle off with ANGELFISH_MAXIMIZE=0.
if [ "${ANGELFISH_MAXIMIZE:-1}" != 0 ] && command -v wmctrl >/dev/null 2>&1; then
    (
        i=0
        while [ "$i" -lt 60 ]; do
            win=$(wmctrl -l -x 2>/dev/null | awk 'tolower($3) ~ /angelfish/ {print $1; exit}')
            if [ -n "$win" ]; then
                wmctrl -i -r "$win" -b add,maximized_vert,maximized_horz 2>/dev/null
                break
            fi
            i=$((i + 1))
            sleep 0.5
        done
    ) &
fi

# QtWebEngine keeps its real multi-process userns sandbox (KASM_QTWEBENGINE_SANDBOX=1
# → nix-launch omits --no-sandbox/--single-process/--no-zygote). Angelfish's Kasm
# run_config carries the tuned chrome.json seccomp (unprivileged clone/unshare/
# setns), same as standalone Chrome, so the sandbox comes up. This replaces the
# old --no-sandbox --single-process envelope, whose --single-process aborted
# QtWebEngine's WebEngineContext init (crash-loop, no window). Validated live on
# the published image with chrome.json seccomp alone (no apparmor override).
export KASM_QTWEBENGINE_SANDBOX=1

# Hand off to nix-launch for the dbus / XDG_RUNTIME_DIR env and rendering path.
# Angelfish renders in SOFTWARE: it is QtWebEngine, which binds chromium's GL to
# Qt's own integration (SurfaceFactoryQt), ignores --use-angle=vulkan, and
# qFatal-aborts on "Invalid visual ID" under VirtualGL — so unlike standalone
# Chrome it cannot use the session GPU here. nix-launch's GPU path is restricted
# to standalone chromium-family binaries; Angelfish (not a chromium-named binary)
# correctly takes nix-launch's software path even when a GPU is allocated.
echo "angelfish-launch: handing off to nix-launch (software render; QtWebEngine GPU unsupported under VGL; sandbox retained)" >&2
exec /usr/local/bin/nix-launch "${BIN}" "$@"
