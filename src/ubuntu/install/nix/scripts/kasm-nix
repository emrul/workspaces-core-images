#!/bin/sh
# kasm-nix — user-facing CLI for managing Kasm Nix profiles.
#
# Subcommands:
#   kasm-nix list                       — profiles in the mounted volume
#   kasm-nix activated                  — currently activated profiles
#   kasm-nix activate <name>            — add to active set (user view)
#   kasm-nix deactivate <name>          — remove from active set (user view)
#   kasm-nix info <name>                — closure paths + size
#
# The boot-time system-wide activation (in /etc/profile.d/kasm-nix.sh and
# /usr/share/applications/kasm-nix-*) is owned by kasm-nix-activate.service
# and reads KASM_NIX_PROFILES or $HOME/.config/kasm-nix/active. This CLI
# manages USER-LEVEL changes mid-session:
#
#   - updates $HOME/.config/kasm-nix/active (consumed at next boot)
#   - drops/removes per-user .desktop shims at
#     $HOME/.local/share/applications/kasm-nix-*
#     so XFCE picks them up without waiting for a restart
#
# PATH for existing shells is NOT updated; new logins via /etc/profile.d
# inherit the boot-time set. To pick up a CLI activation in the current
# shell, source $HOME/.config/kasm-nix/profile.sh.

set -eu

KASM_PROFILE_DIR=/nix/var/nix/profiles
META_JSON=/nix/var/nix/profiles/_meta.json
ACTIVE_FILE="${HOME}/.config/kasm-nix/active"
USER_APPS="${HOME}/.local/share/applications"
USER_SHIM_PREFIX="${USER_APPS}/kasm-nix-"
USER_PROFILE_SH="${HOME}/.config/kasm-nix/profile.sh"

# ───── helpers ─────────────────────────────────────────────────────────
need_volume() {
  [ -f "${META_JSON}" ] || {
    echo "kasm-nix: /nix volume not mounted (expected ${META_JSON})" >&2
    exit 1
  }
}

read_active() {
  if [ -f "${ACTIVE_FILE}" ]; then
    cat "${ACTIVE_FILE}"
  else
    printf '%s' "${KASM_NIX_ACTIVE:-${KASM_NIX_PROFILES:-}}" | tr ',' '\n' \
      | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
      | grep -v '^$' || true
  fi
}

write_active_set() {
  install -d -m 0755 "$(dirname "${ACTIVE_FILE}")"
  printf '%s\n' "$@" | grep -v '^$' | sort -u > "${ACTIVE_FILE}"
}

# Fixed-point closure of `requires` from the volume's _meta.json. Reads
# names on stdin, emits the transitively-closed set on stdout.
# Mirrors kasm-nix-activate(8). No-op when meta is absent or jq missing.
expand_deps() {
  if ! [ -f "${META_JSON}" ] || ! command -v jq >/dev/null 2>&1; then
    cat
    return 0
  fi
  current="$(grep -v '^$' || true)"
  prev=""
  while [ "${prev}" != "${current}" ]; do
    prev="${current}"
    additions=""
    for p in ${current}; do
      deps="$(jq -r --arg p "$p" '.profiles[$p].requires[]? // empty' \
                  "${META_JSON}" 2>/dev/null)"
      for d in ${deps}; do
        case " ${current} " in
          *" ${d} "*) ;;
          *) additions="${additions} ${d}" ;;
        esac
      done
    done
    current="$(printf '%s\n' ${current} ${additions} | grep -v '^$' | sort -u)"
  done
  printf '%s\n' ${current}
}

# Names in arg list that are NOT in stdin's effective set.
deps_pulled_in() {
  requested="$1"  # space-separated original names
  effective="$(printf '%s\n' ${requested} | expand_deps)"
  for d in ${effective}; do
    case " ${requested} " in
      *" ${d} "*) ;;
      *) printf '%s\n' "$d" ;;
    esac
  done
}

regen_user_profile_sh() {
  active_list="$1"
  install -d -m 0755 "$(dirname "${USER_PROFILE_SH}")"
  {
    echo "# Generated by kasm-nix. Source this from \$HOME/.bashrc"
    echo "# to pick up CLI activations in the current shell."
    if [ -n "${active_list}" ]; then
      bin_paths=""
      data_paths=""
      for p in ${active_list}; do
        bin_paths="${KASM_PROFILE_DIR}/${p}/bin${bin_paths:+:}${bin_paths}"
        data_paths="${KASM_PROFILE_DIR}/${p}/share${data_paths:+:}${data_paths}"
      done
      echo "export PATH=\"${bin_paths}:\${PATH}\""
      echo "export XDG_DATA_DIRS=\"${data_paths}:\${XDG_DATA_DIRS:-/usr/local/share:/usr/share}\""
    fi
  } > "${USER_PROFILE_SH}"
  chmod 0644 "${USER_PROFILE_SH}"
}

# Re-create per-user .desktop shims for the given active list.
regen_user_shims() {
  active_list="$1"
  install -d -m 0755 "${USER_APPS}"
  find "${USER_APPS}" -maxdepth 1 -name 'kasm-nix-*.desktop' \
       -delete 2>/dev/null || true
  for p in ${active_list}; do
    prof_path="${KASM_PROFILE_DIR}/${p}"
    apps_dir="${prof_path}/share/applications"
    [ -d "${apps_dir}" ] || continue
    for src in "${apps_dir}"/*.desktop; do
      [ -e "${src}" ] || continue
      bn="$(basename "${src}")"
      dst="${USER_SHIM_PREFIX}${bn}"
      cp -f "${src}" "${dst}"
      sed -i \
          -e "s#^Exec=\\([^/]\\)#Exec=${prof_path}/bin/\\1#" \
          -e "s#^TryExec=\\([^/]\\)#TryExec=${prof_path}/bin/\\1#" \
          "${dst}"
      chmod 0644 "${dst}"
      # gio trust (best-effort; depends on gvfsd-metadata being reachable).
      if command -v gio >/dev/null 2>&1; then
        h="$(sha256sum "${dst}" | awk '{print $1}')"
        gio set -t string "${dst}" metadata::xfce-exe-checksum "${h}" 2>/dev/null || true
      fi
    done
  done
}

# ───── subcommands ─────────────────────────────────────────────────────
cmd_list() {
  need_volume
  printed=0
  for p in "${KASM_PROFILE_DIR}"/*; do
    [ -e "$p" ] || continue
    n="$(basename "$p")"
    case "$n" in
      # Internal: bootstrap (nix CLI), _base (shared closure).
      # Bundled by nixos/nix base image: default, per-user.
      # Metadata: _meta.json. Generation links: <name>-<N>-link.
      bootstrap|_base|default|per-user|_meta.json) continue ;;
      *-link) continue ;;
    esac
    bin_count=0
    [ -d "$p/bin" ] && bin_count="$(find "$p/bin" -maxdepth 1 -type f -executable 2>/dev/null | wc -l | tr -d ' ')"
    size="$(du -sh -L "$p" 2>/dev/null | awk '{print $1}')"
    printf '%-22s  %-8s  %s binaries\n' "$n" "${size:-?}" "${bin_count}"
    printed=1
  done
  [ "${printed}" = 1 ] || echo "(no profiles in volume)"
}

cmd_activated() {
  requested="$(read_active | tr '\n' ' ')"
  if [ -z "$(printf '%s' "${requested}" | tr -d ' ')" ]; then
    echo "(none)"
    return 0
  fi
  effective="$(printf '%s\n' ${requested} | expand_deps)"
  for p in ${effective}; do
    case " ${requested} " in
      *" ${p} "*) printf '%s\n' "${p}" ;;
      *)          printf '%s   (auto: required by another active profile)\n' "${p}" ;;
    esac
  done
}

cmd_activate() {
  [ -n "${1:-}" ] || { echo "usage: kasm-nix activate <name>" >&2; exit 2; }
  need_volume
  name="$1"
  [ -L "${KASM_PROFILE_DIR}/${name}" ] || [ -d "${KASM_PROFILE_DIR}/${name}" ] \
    || { echo "kasm-nix: no such profile: ${name}" >&2; exit 1; }
  current="$(read_active)"
  write_active_set ${current} "${name}"
  new_requested="$(read_active | tr '\n' ' ')"
  new_effective="$(printf '%s\n' ${new_requested} | expand_deps)"
  regen_user_profile_sh "${new_effective}"
  regen_user_shims "${new_effective}"

  # Report deps that got pulled in by this activation.
  pulled="$(deps_pulled_in "${new_requested}" | grep -v '^$' || true)"
  echo "kasm-nix: activated ${name}."
  if [ -n "${pulled}" ]; then
    echo "  Also activated (transitive deps):"
    for d in ${pulled}; do echo "    - ${d}"; done
  fi
  echo "  Per-user .desktop shims dropped at ${USER_APPS}/kasm-nix-*."
  echo "  PATH for the current shell: source ${USER_PROFILE_SH}"
}

cmd_deactivate() {
  [ -n "${1:-}" ] || { echo "usage: kasm-nix deactivate <name>" >&2; exit 2; }
  name="$1"
  current="$(read_active | tr '\n' ' ')"
  new="$(printf '%s\n' ${current} | grep -vxF "${name}" || true)"
  write_active_set ${new}
  new_effective="$(printf '%s\n' ${new} | expand_deps)"
  regen_user_profile_sh "${new_effective}"
  regen_user_shims "${new_effective}"

  # If something else still requires this profile, surface that.
  if printf '%s\n' ${new_effective} | grep -qxF "${name}"; then
    echo "kasm-nix: removed ${name} from the requested set, but it's still active."
    echo "  Another active profile declares 'requires = [\"${name}\"]'. Deactivate"
    echo "  that profile first if you really want to drop ${name}."
  else
    echo "kasm-nix: deactivated ${name}."
    echo "  XFCE panel may cache the launcher; restart with: xfce4-panel --restart"
  fi
}

cmd_info() {
  [ -n "${1:-}" ] || { echo "usage: kasm-nix info <name>" >&2; exit 2; }
  need_volume
  name="$1"
  prof="${KASM_PROFILE_DIR}/${name}"
  [ -e "${prof}" ] || { echo "kasm-nix: no such profile: ${name}" >&2; exit 1; }
  echo "Profile:     ${name}"
  echo "Symlinks to: $(readlink "${prof}" 2>/dev/null || echo '<not a symlink>')"
  ns_bin="${KASM_PROFILE_DIR}/bootstrap/bin/nix-store"
  if [ -x "${ns_bin}" ]; then
    n_paths="$("${ns_bin}" -qR "${prof}" 2>/dev/null | wc -l | tr -d ' ')"
    echo "Closure:     ${n_paths} store paths"
  fi
  size="$(du -sh -L "${prof}" 2>/dev/null | awk '{print $1}')"
  echo "Size (-L):   ${size:-?}"
}

cmd_help() {
  cat <<EOF
kasm-nix — manage activated Kasm Nix profiles

  kasm-nix list                  Profiles available in the /nix volume
  kasm-nix activated             Currently activated profiles
  kasm-nix activate <name>       Add to active set (user view)
  kasm-nix deactivate <name>     Remove from active set (user view)
  kasm-nix info <name>           Closure paths and size

Boot-time activation is wired by kasm-nix-activate.service from
KASM_NIX_PROFILES (CSV) or \$HOME/.config/kasm-nix/active. The CLI
manages a USER-LEVEL view at \$HOME/.local/share/applications/kasm-nix-*
that XFCE picks up without a container restart. PATH for existing
shells is not updated automatically; source \$HOME/.config/kasm-nix/profile.sh
to pick up changes.
EOF
}

# ───── dispatch ────────────────────────────────────────────────────────
case "${1:-help}" in
  list)            shift; cmd_list "$@" ;;
  activated)       shift; cmd_activated "$@" ;;
  activate)        shift; cmd_activate "$@" ;;
  deactivate)      shift; cmd_deactivate "$@" ;;
  info)            shift; cmd_info "$@" ;;
  help|-h|--help)  cmd_help ;;
  *) printf 'kasm-nix: unknown subcommand: %s\n' "$1" >&2; cmd_help >&2; exit 2 ;;
esac
