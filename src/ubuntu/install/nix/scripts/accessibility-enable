#!/bin/sh
# accessibility-enable — turn on the AT-SPI accessibility bridge for this
# session, before any application starts.
#
# Why this exists. Toolkits ship the bridge but gate it on a master switch that
# is off by default: GTK, Qt and LibreOffice's VCL all consult
# org.a11y.Status.IsEnabled (fed from the GSettings key
# org.gnome.desktop.interface toolkit-accessibility). With it off, an
# application loads libatk-bridge and still publishes no widget tree, so the
# AT-SPI registry lists only the desktop's own components.
#
# Measured on the nix LibreOffice image: at-spi2-registryd running,
# libatk-bridge-2.0 and libatspi loaded into soffice, IsEnabled false, and
# soffice absent from the registry. Setting the key made it register within
# seconds and needed no restart of the application.
#
# Why it must run before the app. Enabling the switch while an application is
# still starting does NOT make it register — the toolkits read the setting
# during initialisation and only some watch it afterwards. An agent that flips
# the switch at run time therefore races app startup and frequently loses,
# which is why this is a boot unit ordered Before=custom-startup.service
# rather than something the consumer does for itself.
#
# Opt-in on purpose: the bridge adds startup cost and D-Bus traffic to every
# application, and the great majority of sessions have no accessibility client
# attached and should not pay for one.
set -u

log() { echo "accessibility-enable: $*" >&2; }

if [ "${ACCESSIBILITY_ENABLE:-0}" != "1" ]; then
    # The unit's ConditionEnvironment already gates this; belt and braces for
    # anyone invoking the script directly.
    log "ACCESSIBILITY_ENABLE is not 1 — nothing to do"
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    log "no DBUS_SESSION_BUS_ADDRESS — cannot reach the session bus"
    exit 1
fi

rc=1

# Preferred: the GSettings key. at-spi-bus-launcher reads it and republishes it
# as org.a11y.Status.IsEnabled, so this is the durable form and it applies to
# applications that start later.
if command -v gsettings >/dev/null 2>&1; then
    if gsettings set org.gnome.desktop.interface toolkit-accessibility true 2>/dev/null; then
        log "toolkit-accessibility set via gsettings"
        rc=0
    else
        log "gsettings set failed (schema missing?) — falling back to the bus property"
    fi
fi

# Fallback: write org.a11y.Status.IsEnabled directly. Equivalent for toolkits
# that are already running, and the only route on an image with no GSettings
# schemas installed.
if [ "$rc" -ne 0 ] && command -v gdbus >/dev/null 2>&1; then
    if gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
        --method org.freedesktop.DBus.Properties.Set \
        org.a11y.Status IsEnabled "<true>" >/dev/null 2>&1; then
        log "IsEnabled set via the a11y bus property"
        rc=0
    fi
fi

if [ "$rc" -ne 0 ]; then
    log "could not enable accessibility (no working gsettings or gdbus route)"
    exit 1
fi

# Report what the bus actually believes, so a session that looks enabled but
# is not shows up in the boot log rather than only when a client fails.
if command -v gdbus >/dev/null 2>&1; then
    state="$(gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
        --method org.freedesktop.DBus.Properties.Get \
        org.a11y.Status IsEnabled 2>/dev/null)"
    log "org.a11y.Status.IsEnabled now ${state:-<unreadable>}"
fi

exit 0
