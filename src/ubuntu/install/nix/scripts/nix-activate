#!/bin/sh
# nix-activate — wire activated Nix profiles into PATH,
# XDG_DATA_DIRS, and the XFCE-visible application menu at boot.
#
# Runs as root from nix-activate.service. Performs:
#   1. /run/nix-state bootstrap (writable; the read-only /nix volume
#      cannot host db-WAL, temproots, or gcroots)
#   2. system-wide PATH/XDG_DATA_DIRS export via /etc/profile.d/nix-app.sh
#   3. system-wide .desktop shims at /usr/share/applications/nix-*
#      (Exec= rewritten to absolute paths)
#   4. user-context gio set metadata::xfce-exe-checksum for each shim,
#      via `su` so gvfsd-metadata writes land in the user's home
#
# Profile source order (first non-empty wins, else nothing activated):
#   - $HOME/.config/nix-app/active     (per-user override; one name per line)
#   - Kasm launch-form selections file (see below)
#   - NIX_APP_PROFILES                  (CSV; e.g. run_config default)
#
# Kasm launch forms (guide/launch_config) can't set env vars — they write the
# user's choices as JSON to a file (default /tmp/launch_selections.json, baked
# in BEFORE PID 1). We read profile names from it so a per-session form can pick
# apps. Configurable:
#   NIX_LAUNCH_SELECTIONS  file path (default /tmp/launch_selections.json)
#   NIX_LAUNCH_KEY         primary key (default nix_profiles)
# We accept, and merge, ALL of these form styles (no Kasm patch needed):
#   - text field  keyed nix_profiles        -> "chrome,firefox,vlc"
#   - select      keyed nix_profiles         -> option value may be a CSV bundle
#   - array value keyed nix_profiles         -> ["chrome","firefox"] (future multi)
#   - chained single-selects nix_profiles_1,nix_profiles_2 … -> merged
# The last covers real multi-select using only the product's current single
# select: any key equal to the primary key or starting with "<key>_" (jq only).
#
# The script is idempotent. The nix-app CLI does NOT re-invoke this;
# it manages a USER-LEVEL view via ~/.local/share/applications (see
# nix-app(1)). Boot-time system shims persist until next container
# restart.

set -eu

KASM_PROFILE_DIR=/nix/var/nix/profiles
META_JSON=/nix/var/nix/profiles/_meta.json
SHIM_PREFIX=/usr/share/applications/nix-
PROFILE_D=/etc/profile.d/nix-app.sh
PROFILE_D_STATE=/etc/profile.d/nix-app-state.sh
NIX_STATE=/run/nix-state

KASM_OS_USER="${KASM_OS_USER:-kasm-user}"
KASM_OS_GROUP="${KASM_OS_GROUP:-kasm-user}"
KASM_OS_HOME="${KASM_OS_HOME:-/home/${KASM_OS_USER}}"

NIX_LAUNCH_SELECTIONS="${NIX_LAUNCH_SELECTIONS:-/tmp/launch_selections.json}"
NIX_LAUNCH_KEY="${NIX_LAUNCH_KEY:-nix_profiles}"

log()  { printf 'nix-activate: %s\n' "$*" >&2; }
warn() { printf 'nix-activate: WARN %s\n' "$*" >&2; }

# ───── 0. populate /opt/nix-libs with narrow graphics symlinks ───
# Symlinks ONLY the libEGL/libGL family from the system mesa libdir so
# nix-built apps that dlopen unversioned libEGL.so find the system mesa
# libs without dragging in libc.so.6 (which would clash with their
# bundled glibc's GLIBC_PRIVATE symbols). The libdir differs by distro —
# Debian/Ubuntu multiarch (/usr/lib/<arch>-linux-gnu), Fedora/RHEL
# (/usr/lib64), generic /usr/lib — so we search a candidate list per lib.
setup_narrow_lib_dir() {
  # On musl hosts (Alpine) the system mesa/GL stack is musl-built, but Nix apps
  # are glibc — they CANNOT dlopen the system libGL (libc mismatch). Skip the
  # compat dir entirely so apps fall back to their OWN bundled (glibc) mesa /
  # llvmpipe from the Nix closure (software GL). No hardware/system-GL interop
  # on musl; that's expected.
  if [ -e /lib/ld-musl-x86_64.so.1 ] || [ -e /lib/ld-musl-aarch64.so.1 ]; then
    log "musl host; skipping system-GL compat dir (Nix apps use bundled mesa)"
    return 0
  fi
  arch="$(uname -m)"
  lib_search="/usr/lib/${arch}-linux-gnu /usr/lib64 /lib64 /usr/lib /lib"
  out=/opt/nix-libs
  install -d -m 0755 "${out}"
  _find_syslib() {
    for d in ${lib_search}; do
      [ -e "${d}/$1" ] && { printf '%s' "${d}/$1"; return 0; }
    done
    return 1
  }
  # Versioned libs that exist on the kasm-core image (any supported distro).
  for v in libEGL.so.1 libEGL_mesa.so.0 libGL.so.1 libGLX.so.0 \
           libGLX_mesa.so.0 libGLX_indirect.so.0 \
           libGLdispatch.so.0 libGLESv2.so.2 libglapi.so.0; do
    p="$(_find_syslib "${v}")" && ln -sfn "${p}" "${out}/${v}"
  done
  # Unversioned aliases some Nix-built apps dlopen.
  p="$(_find_syslib libEGL.so.1)" && ln -sfn "${p}" "${out}/libEGL.so"
  p="$(_find_syslib libGL.so.1)"  && ln -sfn "${p}" "${out}/libGL.so"

  # Add /opt/nix-libs to the system ld.so.cache so the libs above
  # are discoverable via /etc/ld.so.cache lookup — lower priority than
  # any binary's DT_RUNPATH, which means nix-bundled libs still win for
  # things in their closure. Used by Qt apps (e.g. KDE Angelfish) that
  # need libGLX_mesa.so.0 as a libglvnd backend; libglvnd itself ships
  # with nix but has no vendor implementation in its closure.
  echo "${out}" > /etc/ld.so.conf.d/nix-app.conf
  ldconfig 2>/dev/null || true
}

# ───── 1. /run/nix-state bootstrap (root) ──────────────────────────────
setup_state() {
  install -d -m 0755 \
    "${NIX_STATE}/db" \
    "${NIX_STATE}/temproots" \
    "${NIX_STATE}/gcroots" \
    "${NIX_STATE}/profiles"
  if [ -f /nix/var/nix/db/db.sqlite ] && \
     [ ! -f "${NIX_STATE}/db/db.sqlite" ]; then
    cp -a /nix/var/nix/db/db.sqlite "${NIX_STATE}/db/db.sqlite"
    chmod 0644 "${NIX_STATE}/db/db.sqlite"
  fi
  chmod -R go+rX "${NIX_STATE}" 2>/dev/null || true
  # XDG_RUNTIME_DIR for the OS user. logind isn't present in the container, so
  # /run/user/<uid> is never created — Electron apps (VS Code) put their IPC
  # socket there and crash with EACCES if it's missing or root-owned. Create it
  # here (as root) with the right owner/mode; nix-launch exports it.
  os_uid="$(id -u "${KASM_OS_USER}" 2>/dev/null || echo 1000)"
  install -d -m 0700 -o "${KASM_OS_USER}" -g "${KASM_OS_GROUP}" \
    "/run/user/${os_uid}" 2>/dev/null || true
  cat > "${PROFILE_D_STATE}" <<EOF
# Generated by nix-activate. Do not edit.
export NIX_STATE_DIR=${NIX_STATE}
export NIX_REMOTE=
export PATH=${KASM_PROFILE_DIR}/bootstrap/bin:\${PATH}
EOF
  chmod 0644 "${PROFILE_D_STATE}"
}

# Normalise a CSV/space list on stdin/args to one trimmed name per line.
csv_to_lines() {
  printf '%s' "$1" | tr ', ' '\n\n' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    | grep -v '^$' || true
}

# ───── 2a. Kasm launch-form selections → profile names ─────────────────
resolve_launch_form() {
  [ -f "${NIX_LAUNCH_SELECTIONS}" ] || return 0
  val=""
  if command -v jq >/dev/null 2>&1; then
    # Merge every key named like the primary key (nix_profiles,
    # nix_profile_1, …); array values are joined. Covers text CSV,
    # comma-valued selects, future array multi-select, and chained
    # single-selects — all at once.
    val="$(jq -r --arg k "${NIX_LAUNCH_KEY}" '
        to_entries
        | map(select(.key == $k or (.key | startswith($k + "_"))))
        | map(.value
              | if   type == "array" then join(",")
                elif . == null       then empty
                else tostring end)
        | join(",")' "${NIX_LAUNCH_SELECTIONS}" 2>/dev/null || true)"
  else
    # Portable fallback (no jq). Handles the primary key as either a
    # string ("a,b") or a JSON array (["a","b"]) — the latter is the
    # likely shape once Kasm ships native multi-select. Chained
    # nix_profiles_N keys need jq (and are redundant with a comma-valued
    # select or the string form anyway).
    raw="$(tr -d '\n\r' < "${NIX_LAUNCH_SELECTIONS}" 2>/dev/null || true)"
    # array form: "<key>" : [ "a", "b" ] — quoted items after the key name
    val="$(printf '%s' "${raw}" \
        | grep -oE "\"${NIX_LAUNCH_KEY}\"[[:space:]]*:[[:space:]]*\[[^]]*\]" \
        | grep -oE '"[^"]*"' | sed -n '2,$p' | tr -d '"' \
        | paste -sd, - 2>/dev/null || true)"
    if [ -z "${val}" ]; then
      # string form: "<key>" : "..."
      val="$(printf '%s' "${raw}" \
          | sed -n "s/.*\"${NIX_LAUNCH_KEY}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
          | head -n1)"
    fi
  fi
  [ -n "${val}" ] || return 0
  csv_to_lines "${val}"
}

# ───── 2b. resolve active profile list ─────────────────────────────────
resolve_active() {
  user_file="${KASM_OS_HOME}/.config/nix-app/active"
  if [ -f "${user_file}" ]; then
    cat "${user_file}"
    return 0
  fi
  lf="$(resolve_launch_form)"
  if [ -n "${lf}" ]; then
    printf '%s\n' "${lf}"
    return 0
  fi
  if [ -n "${NIX_APP_PROFILES:-}" ]; then
    csv_to_lines "${NIX_APP_PROFILES}"
  fi
}

# ───── 3a. expand `requires` from _meta.json (fixed-point closure) ─────
# Reads names on stdin, emits the transitively-closed set on stdout.
# Cycle-safe (set only grows; bounded by total profile count).
expand_deps() {
  if ! [ -f "${META_JSON}" ] || ! command -v jq >/dev/null 2>&1; then
    cat
    return 0
  fi
  current="$(grep -v '^$' || true)"
  prev=""
  while [ "${prev}" != "${current}" ]; do
    prev="${current}"
    additions=""
    for p in ${current}; do
      deps="$(jq -r --arg p "$p" '.profiles[$p].requires[]? // empty' \
                  "${META_JSON}" 2>/dev/null)"
      for d in ${deps}; do
        case " ${current} " in
          *" ${d} "*) ;;
          *) additions="${additions} ${d}"; warn "pulling in '${d}' (required by '${p}')" ;;
        esac
      done
    done
    current="$(printf '%s\n' ${current} ${additions} | grep -v '^$' | sort -u)"
  done
  printf '%s\n' ${current}
}

# ───── 3b. validate names against the volume ───────────────────────────
filter_existing() {
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    if [ -L "${KASM_PROFILE_DIR}/${p}" ] || [ -d "${KASM_PROFILE_DIR}/${p}" ]; then
      printf '%s\n' "$p"
    else
      warn "profile not found, skipping: ${p}"
    fi
  done
}

# ───── 4. write /etc/profile.d/nix-app.sh ─────────────────────────────
write_profile_d() {
  active_list="$1"
  {
    echo "# Generated by nix-activate. Do not edit."
    # Always-on: redirect npm / pipx / python user-site to ~/.local/share
    # so per-project installs survive container restarts under profile
    # sync. Harmless when node / python profiles aren't activated.
    cat <<'USERPKG'
export NPM_CONFIG_PREFIX="${HOME}/.local/share/npm"
export PIPX_HOME="${HOME}/.local/share/pipx"
export PIPX_BIN_DIR="${HOME}/.local/share/pipx/bin"
export PYTHONUSERBASE="${HOME}/.local/share/python"
export PATH="${NPM_CONFIG_PREFIX}/bin:${PIPX_BIN_DIR}:${PYTHONUSERBASE}/bin:${PATH}"
# Narrow LD_LIBRARY_PATH: only the graphics-lib symlinks in
# /opt/nix-libs (libEGL, libGL, libGLX, libGLdispatch). System
# libc and friends are NOT in this dir, so nix-built binaries' bundled
# glibc stays in effect — avoids the GLIBC_PRIVATE symbol mismatch a
# broad path like /usr/lib/<arch>-linux-gnu would cause.
[ -d /opt/nix-libs ] && \
    export LD_LIBRARY_PATH="/opt/nix-libs${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
USERPKG
    if [ -n "${active_list}" ]; then
      active_csv="$(echo "${active_list}" | tr '\n' ',' | sed 's/,$//')"
      echo "NIX_APP_ACTIVE=\"${active_csv}\""
      echo "export NIX_APP_ACTIVE"
      bin_paths=""
      data_paths=""
      for p in ${active_list}; do
        bin_paths="${KASM_PROFILE_DIR}/${p}/bin${bin_paths:+:}${bin_paths}"
        data_paths="${KASM_PROFILE_DIR}/${p}/share${data_paths:+:}${data_paths}"
      done
      echo "export PATH=\"${bin_paths}:\${PATH}\""
      echo "export XDG_DATA_DIRS=\"${data_paths}:\${XDG_DATA_DIRS:-/usr/local/share:/usr/share}\""
    else
      echo "# (no active profiles)"
    fi
  } > "${PROFILE_D}"
  chmod 0644 "${PROFILE_D}"
}

# ───── 5. /usr/share/applications/nix-* shims ─────────────────────
clear_shims() {
  find /usr/share/applications -maxdepth 1 -name 'nix-*.desktop' \
       -delete 2>/dev/null || true
}

# Resolve a freedesktop icon NAME to an absolute file under a profile's
# share/icons or share/pixmaps. Nix apps ship their icons inside the profile,
# which isn't on XFCE's icon-theme search path — so a bare `Icon=chromium`
# name won't resolve and the launcher shows no icon. Rewriting Icon= to an
# absolute path fixes that without touching the icon theme. Prefers scalable,
# then large rasters.
resolve_icon() {
  name="$1"; base="$2"
  for d in \
    "${base}/share/icons/hicolor/scalable/apps" \
    "${base}/share/icons/hicolor/512x512/apps" \
    "${base}/share/icons/hicolor/256x256/apps" \
    "${base}/share/icons/hicolor/128x128/apps" \
    "${base}/share/pixmaps"; do
    for ext in svg png; do
      [ -e "${d}/${name}.${ext}" ] && { printf '%s' "${d}/${name}.${ext}"; return 0; }
    done
  done
  find -L "${base}/share/icons" "${base}/share/pixmaps" \
       \( -name "${name}.svg" -o -name "${name}.png" \) 2>/dev/null | head -n1
}

shim_profile() {
  prof="$1"
  prof_path="${KASM_PROFILE_DIR}/${prof}"
  apps_dir="${prof_path}/share/applications"
  [ -d "${apps_dir}" ] || {
    warn "${prof}: no share/applications directory; nothing to shim"
    return 0
  }
  for src in "${apps_dir}"/*.desktop; do
    [ -e "${src}" ] || continue
    # Skip launchers explicitly hidden from menus. e.g. Chrome ships a
    # NoDisplay reverse-DNS alias (com.google.Chrome.desktop) alongside
    # google-chrome.desktop; shimming both yields two identical icons.
    if grep -qiE '^(NoDisplay|Hidden)[[:space:]]*=[[:space:]]*true' "${src}"; then
      continue
    fi
    bn="$(basename "${src}")"
    dst="${SHIM_PREFIX}${bn}"
    cp -f "${src}" "${dst}"
    # 1) Rewrite Exec= and TryExec= to absolute paths in the profile.
    # 2) Wrap Exec= through /usr/local/bin/nix-launch so the
    #    menu-launched app gets DBUS_SESSION_BUS_ADDRESS (GTK4 apps
    #    like ptyxis need it) and LD_LIBRARY_PATH=/usr/lib/<arch>
    #    (wezterm and other nix-built GUI apps that dlopen libEGL/GL
    #    from the system mesa). Multiple Exec= lines per file (e.g.
    #    Desktop Actions) all get the same wrapping.
    sed -i \
        -e "s#^Exec=\\([^/]\\)#Exec=${prof_path}/bin/\\1#" \
        -e "s#^TryExec=\\([^/]\\)#TryExec=${prof_path}/bin/\\1#" \
        -e "s#^Exec=\\(.\\)#Exec=/usr/local/bin/nix-launch \\1#" \
        "${dst}"
    # 3) Rewrite Icon= name -> absolute path so XFCE shows the icon.
    icon="$(sed -n 's/^Icon=//p' "${dst}" | head -n1)"
    case "${icon}" in
      ''|/*) ;;  # empty or already absolute — leave alone
      *)
        abs="$(resolve_icon "${icon}" "${prof_path}")"
        [ -n "${abs}" ] && sed -i "s#^Icon=.*#Icon=${abs}#" "${dst}" \
          || warn "${prof}: no icon file for '${icon}'"
        ;;
    esac
    chmod 0644 "${dst}"
  done
}

# ───── 6. drop activated launchers on the user's Desktop ──────────────
# Copies the shimmed launchers (already Exec/Icon-rewritten) onto the OS
# user's Desktop so they show as desktop icons. Toggle with
# NIX_APP_DESKTOP_ICONS=0. Idempotent: clears prior nix-* desktop
# entries first.
populate_desktop() {
  [ "${NIX_APP_DESKTOP_ICONS:-1}" = "1" ] || return 0
  desk="${KASM_OS_HOME}/Desktop"
  mkdir -p "${desk}"
  find "${desk}" -maxdepth 1 -name 'nix-*.desktop' -delete 2>/dev/null || true
  for f in ${SHIM_PREFIX}*.desktop; do
    [ -e "${f}" ] || continue
    cp -f "${f}" "${desk}/$(basename "${f}")"
  done
  chmod 0755 "${desk}"/nix-*.desktop 2>/dev/null || true
  chown "${KASM_OS_USER}:${KASM_OS_GROUP}" "${desk}"/nix-*.desktop 2>/dev/null || true
}

# ───── 7. user-context gio set trust ───────────────────────────────────
# Runs as the OS user so gvfsd-metadata writes to ~/.local/share/gvfs-
# metadata/. Trusts BOTH the menu shims and the Desktop copies so XFCE
# launches them without the "untrusted launcher" prompt.
# /tmp/kasm-dbus.env was written by kasm-setup.service.
trust_shims_as_user() {
  [ -f /tmp/kasm-dbus.env ] || {
    warn "no /tmp/kasm-dbus.env; skipping gio trust (XFCE may warn once)"
    return 0
  }
  su -s /bin/sh "${KASM_OS_USER}" -c '
    set -eu
    . /tmp/kasm-dbus.env
    export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
    for f in /usr/share/applications/nix-*.desktop \
             "$HOME"/Desktop/nix-*.desktop; do
      [ -e "$f" ] || continue
      h=$(sha256sum "$f" | awk "{print \$1}")
      gio set -t string "$f" metadata::xfce-exe-checksum "$h" 2>/dev/null || true
    done
  '
}

# ───── 8. single-app desktop toggle (runtime) ─────────────────────────
# When exactly one app is active, switch XFCE to the no-panel "single
# application" layout so the session opens straight into the app — the runtime
# replacement for the old finish build's `apt-get remove xfce4-panel`. Multi-app
# (desktop) sessions keep the full panel. Both layouts ship in the core image.
# Toggle off with NIX_SINGLE_APP_DESKTOP=0.
apply_single_app_desktop() {
  [ "${NIX_SINGLE_APP_DESKTOP:-1}" = "1" ] || return 0
  n="$(printf '%s\n' $1 | grep -c . || true)"
  [ "${n}" = "1" ] || return 0
  for home in "${KASM_OS_HOME}" /home/kasm-default-profile; do
    src="${home}/.config/xfce4/xfconf/single-application-xfce-perchannel-xml"
    dst="${home}/.config/xfce4/xfconf/xfce-perchannel-xml"
    [ -d "${src}" ] && [ -d "${dst}" ] || continue
    cp -f "${src}"/*.xml "${dst}"/ 2>/dev/null || true
    chown -R "${KASM_OS_USER}:${KASM_OS_GROUP}" "${dst}" 2>/dev/null || true
  done
  log "single app active; applied no-panel XFCE layout"
}

# ───── main ────────────────────────────────────────────────────────────
[ -f "${META_JSON}" ] || {
  log "no /nix volume mounted (${META_JSON} absent); nothing to do"
  exit 0
}

setup_state
setup_narrow_lib_dir

active="$(resolve_active | expand_deps | filter_existing | sort -u | grep -v '^$' || true)"
log "activating: ${active:-<none>}"

clear_shims
write_profile_d "${active}"

if [ -n "${active}" ]; then
  for p in ${active}; do
    shim_profile "${p}"
  done
  populate_desktop
  trust_shims_as_user
  apply_single_app_desktop "${active}"
fi

log "complete"
