#!/bin/sh
# nix-bwrap-run — run a Nix buildFHSEnv/bubblewrap-wrapped app under the
# /nix/store->/store symlink layout used by the assembled Nix images.
#
# Usage: nix-bwrap-run <program> [args...]
#
# Why this exists
# ---------------
# Per-app (and image-mount) Nix images keep the store at /store, with
# /nix/store a *symlink* to it, so the fat store and per-app OCI layer tars
# stay byte-identical and dedup (see bin/build-nix-store-volume). nixpkgs'
# buildFHSEnv wrapper for an FHS/bwrap app does `--bind /nix /nix` and then
# hardcodes early `--tmpfs /nix/store/<glibc>/etc` + related binds. bwrap
# builds those mount targets by walking the path literally and REFUSES to
# traverse the /nix/store symlink, so it dies with
#   bwrap: Can't mkdir parents for /nix/store/<glibc>/etc: No such file or directory
# before the app starts. (Just binding /store isn't enough — bwrap still
# won't follow the symlink; /nix/store must be a real directory.)
#
# Fix: run the FHS app inside an OUTER bwrap that presents a real /nix/store —
# /nix as a fresh tmpfs, then /store bind-mounted onto /nix/store (and /var
# onto /nix/var). The inner wrapper's `--bind /nix /nix` then carries real
# content and its glibc mounts resolve. bwrap supplies its own user namespace
# (CAP_SYS_ADMIN inside it), so this needs no container capabilities; the inner
# nix-bwrap nests fine.
#
# Self-guarding: the outer bwrap is applied ONLY when the store is a symlink
# (assembled image) AND the target is actually an FHS/bwrap wrapper. Any other
# program is exec'd unchanged, so callers can route everything through here.
set -u

BWRAP=/usr/bin/bwrap
prog="${1:-}"
[ -n "${prog}" ] || { echo "nix-bwrap-run: no program given" >&2; exit 2; }

# Resolve to a concrete store path in the host mount ns (where the /nix/store
# symlink/farm still works) so the outer bwrap gets a real target to exec.
real="$(readlink -f "${prog}" 2>/dev/null || printf '%s' "${prog}")"

# Composed multi-store layout (nix-compose): /nix/store is a real directory of
# per-path symlinks into /nix-stores/<id>/store. Collect the backing stores.
stores=""
for s in /nix-stores/*/store; do
    [ -d "${s}" ] && stores="${stores} ${s}"
done

# Does this need the fix? A usable bwrap, a store layout bwrap can't traverse
# (legacy single /nix/store->/store symlink, OR the composed farm), and a
# buildFHSEnv wrapper. nixpkgs names those <name>-bwrap; else sniff the body.
needs_fix=0
if [ -x "${BWRAP}" ] && { [ -L /nix/store ] || [ -n "${stores}" ]; }; then
    case "${real}" in
        *-bwrap) needs_fix=1 ;;
        *) LC_ALL=C head -c 8192 "${real}" 2>/dev/null | grep -qa 'bubblewrap\|bin/bwrap' && needs_fix=1 ;;
    esac
fi

if [ "${needs_fix}" = 1 ]; then
    shift  # $@ now holds the app's own args
    if [ -n "${stores}" ]; then
        # Composed world: present the UNION of all stores as one real /nix/store
        # via bwrap's read-only overlay (bwrap >= 0.9.0). Each --overlay-src adds
        # a layer; --ro-overlay materialises them at /nix/store. Build the argv by
        # PREPENDING (keeping the app args, which may contain spaces, at the tail);
        # overlay order is irrelevant (content-addressed ⇒ identical paths).
        set -- --ro-overlay /nix/store --bind /nix/var /nix/var -- "${real}" "$@"
        for s in ${stores}; do
            set -- --overlay-src "${s}" "$@"
        done
        set -- --bind / / --dev-bind /dev /dev --proc /proc --tmpfs /nix "$@"
        # NOTE: fallback for bwrap < 0.9.0 (no --overlay-src) is to bind the
        # single store that contains this app's closure; add if a base ships an
        # older bwrap (noble is 0.9.0 — see RUNBOOK §5 / design Component 3).
        exec "${BWRAP}" "$@"
    fi
    # Legacy single-store symlink layout (/nix/store -> /store).
    exec "${BWRAP}" \
        --bind / / \
        --dev-bind /dev /dev \
        --proc /proc \
        --tmpfs /nix \
        --bind /store /nix/store \
        --bind /var /nix/var \
        -- "${real}" "$@"
fi

exec "$@"
