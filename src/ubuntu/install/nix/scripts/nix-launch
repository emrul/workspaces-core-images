#!/bin/sh
# nix-launch — exec wrapper for menu-launched Nix-built apps.
#
# Sets the env Nix-built GUI apps need to run inside Kasm's KasmVNC
# headless container. The WM-inherited env is wrong for them in
# several ways, and we correct each here:
#
#   - DBUS_SESSION_BUS_ADDRESS: from /tmp/kasm-dbus.env (kasm-setup
#     spawned). GTK4 apps and KDE KDBusService need this.
#
#   - XDG_RUNTIME_DIR: KDE/Qt apps consult this for sockets and lock
#     files. Default /run/user/<uid> isn't pre-created by Kasm.
#
#   - LD_LIBRARY_PATH: UNSET. Kasm's image bakes a path including
#     /opt/libjpeg-turbo, /usr/lib/x86_64-linux-gnu, /usr/local/nvidia
#     into the WM's env — designed for system apps, breaks Nix-built
#     apps that find mismatched libva/libjpeg/etc. The activation
#     script has already added /opt/nix-libs to ld.so.conf.d
#     and rebuilt the cache, so libGLX_mesa et al are reachable via
#     the system cache (lower-priority than RUNPATH — nix's own libs
#     still win for things in their closure).
#
#   - QtWebEngine envelope: --no-sandbox + zygote disabled. Chromium's
#     sandbox model needs CAP_SYS_ADMIN which rootless podman doesn't
#     grant, and its zygote IPC fails in this environment. Single-
#     process collapses Chromium to one PID. dev-shm-usage disabled
#     because /dev/shm is small and chromium falls back to /tmp.
#
#   - Software rendering: LIBGL_ALWAYS_SOFTWARE + Qt software backends
#     keep Qt/QtWebEngine from probing EGL on Xvnc (which doesn't
#     expose it). Slight CPU cost for chromium/electron apps that
#     could otherwise GPU-accelerate, but in software-Xvnc that path
#     was never going to work anyway.

[ -f /tmp/kasm-dbus.env ] && {
    . /tmp/kasm-dbus.env 2>/dev/null
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && export DBUS_SESSION_BUS_ADDRESS
    [ -n "${DBUS_SESSION_BUS_PID:-}" ]     && export DBUS_SESSION_BUS_PID
}

# XDG_RUNTIME_DIR for KDE/Qt apps; create on demand.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    uid=$(id -u)
    XDG_RUNTIME_DIR="/run/user/${uid}"
    [ -d "${XDG_RUNTIME_DIR}" ] || install -d -m 0700 -o "${uid}" -g "${uid}" "${XDG_RUNTIME_DIR}" 2>/dev/null || \
        mkdir -p "${XDG_RUNTIME_DIR}" 2>/dev/null
    export XDG_RUNTIME_DIR
fi

# Drop the Kasm-baked LD_LIBRARY_PATH (designed for system apps; breaks
# Nix apps with library version clashes). Nix's RUNPATH already finds
# its own libs; system fallbacks come via /etc/ld.so.cache. (The GPU path
# below sets its own clean LD_LIBRARY_PATH via nix-gpu-run.)
unset LD_LIBRARY_PATH

prog="${1:-}"
case "$(basename "${prog}" 2>/dev/null)" in
  *chrome*|*chromium*|*brave*|electron|electron[0-9]*|code) is_chromium=1 ;;
  *) is_chromium=0 ;;
esac

# ── GPU path: standalone Chromium/Chrome/Electron, GPU allocated ──────────────
# vglrun + ANGLE-Vulkan reach the real GPU ("ANGLE (NVIDIA, Vulkan ...)") — see
# nix-gpu-run for the recipe. Restricted to STANDALONE chromium-family binaries:
#   - --use-angle=vulkan is the only ANGLE backend that works under VGL here
#     (ANGLE-GL hits "Invalid visual ID" on VGL's surfaceless EGL).
#   - QtWebEngine apps (e.g. Angelfish) are deliberately EXCLUDED: QtWebEngine
#     binds chromium's GL to Qt's own integration (SurfaceFactoryQt), ignores
#     --use-angle, forces the ANGLE-EGL GL path, and qFatal-ABORTS on the same
#     "Invalid visual ID". They must take the software path below. (Pure-GL apps
#     like blender can opt in by calling nix-gpu-run directly in their launcher.)
#   - --no-sandbox so the GPU process can open the dri device nodes (mirrors
#     kasmweb/chrome).
if [ "${is_chromium}" = 1 ] && nix-gpu-run --available; then
    shift
    exec nix-gpu-run "${prog}" \
        --password-store=basic \
        --no-sandbox \
        --ignore-gpu-blocklist \
        --use-angle=vulkan \
        --ozone-platform=x11 \
        --disable-dev-shm-usage \
        --no-first-run \
        --disable-search-engine-choice-screen \
        "$@"
fi

# ── Software path: no GPU allocated, OR a QtWebEngine / non-chromium app ──────
# (QtWebEngine can't use the GPU under VGL here — see above.) Xvnc exposes no
# GPU/EGL; keep Qt/Chromium off the GL probe path.
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QUICK_BACKEND=software
export QSG_RHI_BACKEND=software
export QT_XCB_GL_INTEGRATION=none

# QtWebEngine in rootless container: bypass sandbox/zygote/dev-shm.
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-seccomp-sandbox --disable-gpu --disable-software-rasterizer --no-zygote --single-process --disable-dev-shm-usage"

# Standalone Chromium/Chrome/Electron need their flags on argv — the
# QTWEBENGINE_* env above only reaches Qt-EMBEDDED chromium.
#   --password-store=basic  — without it Chrome blocks on the gnome-keyring /
#                             dbus secret service (absent here) and pages hang.
#   --disable-gpu + software GL — Xvnc exposes no GPU/EGL in this (no-GPU) path.
# Sandbox: relies on the container's tuned seccomp profile
# (src/common/seccomp/chrome.json) permitting unprivileged userns, so Chrome
# keeps its namespace sandbox (no --no-sandbox). Run with that profile.
if [ "${is_chromium}" = 1 ]; then
    shift
    exec "${prog}" \
        --password-store=basic \
        --disable-gpu \
        --disable-dev-shm-usage \
        --no-first-run \
        --disable-search-engine-choice-screen \
        "$@"
fi

exec "$@"
