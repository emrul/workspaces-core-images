[Unit]
Description=Compose N Nix stores (/nix-stores/*) into a unified /nix
# Runs FIRST — before kasm-setup and before every unit that execs a binary from a
# farmed store. Distros with no per-distro service artifact (resolute) bake their
# Kasm services into /nix-stores/services, so /usr/bin/{Xvnc,kasmvncpasswd},
# kasm-profile-sync, kasm_audio_input_server, … resolve their /nix/store
# interpreter/RUNPATH only after nix-compose builds the /nix/store farm.
# CRITICAL: kasm-setup runs kasmvncpasswd to create ~/.kasmpasswd, so nix-compose
# must precede kasm-setup or KasmVNC auth has no password file. nix-compose needs
# nothing from kasm-setup (it only farms /nix-stores -> /nix as root).
# No Condition* here: nix-compose self-guards (no-ops when no /nix-stores/*/store
# is mounted), so it is safe/inert on the single-/nix-mount desktops too.
Before=kasm-setup.service nix-activate.service kasmvnc.service profile-pull.service audio-in.service recorder-watch.service recorder-drain.service webcam.service gamepad.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/nix-compose
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
