#!/bin/sh
# wine-app-photodemon-launch -- the single-app image's entry for PhotoDemon (a wine-assess
# packaged Windows app: wine-assess/docs/wine-nix-packaging.md). The profile's own
# launcher materialises the app's prefix under $HOME on first run and execs wine;
# nix-launch supplies the env a Nix-built GUI app needs inside KasmVNC.
set -u
exec /usr/local/bin/nix-launch /nix/var/nix/profiles/wine-app-photodemon/bin/wine-app-photodemon "$@"
