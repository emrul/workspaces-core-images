#!/bin/sh
# steam-launch — GPU steam via VirtualGL for headless KasmVNC.
#
# Steam's top-level client is the legacy 32-bit VGUI2 process
# (~/.local/share/Steam/ubuntu12_32/steam). It HARD-REQUIRES a GLX visual at
# startup (glXChooseVisual -> fatal assert if none), and on KasmVNC's headless
# Xvnc the only source of a GLX visual is VirtualGL. nix-launch's GPU path is
# chromium-only, so steam needs this bespoke launcher.
#
# How it works (see bin/nix-steam-overlay):
#   - The steam profile carries VirtualGL (vglrun + the 32- AND 64-bit faker)
#     INSIDE steam's FHS, plus `steam-run` (runs an arbitrary command in that
#     FHS).
#   - We run `steam-run vglrun -d egl steam`: enter the FHS and launch Valve's
#     steam under REAL vglrun. vglrun (unlike a bare LD_PRELOAD, which segfaults
#     the faker's constructor) sets up VGL's full env so the faker stays DORMANT
#     in steam's multi-process bootstrap (bash, pressure-vessel, srt tools) and
#     activates ONLY when the VGUI2 client calls glXChooseVisual — giving it a
#     GPU-backed visual. `-d egl` picks the allocated GPU's EGL device.
#   - nix-bwrap-run wraps the whole thing so steam-run's FHS gets a real
#     /nix/store under the per-app /nix/store->/store symlink layout.
#
# custom_startup.sh runs this foreground in its respawn loop (PGREP=steam).
set -u

RUN=/nix/var/nix/profiles/steam/bin/steam-run

# dbus + XDG_RUNTIME_DIR (mirror nix-launch): steam's CEF/dbus need them.
[ -f /tmp/kasm-dbus.env ] && {
    . /tmp/kasm-dbus.env 2>/dev/null
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && export DBUS_SESSION_BUS_ADDRESS
    [ -n "${DBUS_SESSION_BUS_PID:-}" ]     && export DBUS_SESSION_BUS_PID
}
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    uid=$(id -u)
    XDG_RUNTIME_DIR="/run/user/${uid}"
    [ -d "${XDG_RUNTIME_DIR}" ] || \
        install -d -m 0700 "${XDG_RUNTIME_DIR}" 2>/dev/null || \
        mkdir -p "${XDG_RUNTIME_DIR}" 2>/dev/null
    export XDG_RUNTIME_DIR
fi

# vdso trap: never leak Kasm's baked system LD_LIBRARY_PATH into the nix chain
# (mixes system glibc into nix binaries → __vdso_gettimeofday / __nptl_change_
# stack_perm). Same rationale as nix-launch. vglrun re-adds the right paths.
unset LD_LIBRARY_PATH

# GPU allocated → run the client under VirtualGL for a real GLX visual.
# No GPU → run steam plain (the VGUI2 client will lack GLX, but at least steam
# bootstraps rather than us forcing a broken VGL path).
if nix-gpu-run --available; then
    echo "steam-launch: GPU — steam under vglrun -d egl" >&2
    exec nix-bwrap-run "${RUN}" vglrun -d egl steam "$@"
fi
echo "steam-launch: no GPU allocated — steam without VirtualGL" >&2
exec nix-bwrap-run "${RUN}" steam "$@"
