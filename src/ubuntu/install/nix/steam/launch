#!/bin/sh
# steam-launch — headless-KasmVNC steam launcher for the nix FHS.
#
# Steam's top-level client is the legacy 32-bit VGUI2 process
# (~/.local/share/Steam/ubuntu12_32/steam). It HARD-REQUIRES a GLX visual at
# startup: glXChooseVisual -> fatal assert if none. That does NOT need a GPU —
# a *software* GLX visual is enough (this is what stock apt steam uses on the
# same headless Xvnc). The visual comes from 32-bit mesa (llvmpipe) published at
# /run/opengl-driver-32 by nix-gpu-setup — the NixOS-standard driver location
# that nixpkgs' steam FHS reads natively. (nix-gpu-setup MUST stage the mesa
# megadriver's out-of-tree deps — libLLVM etc. — or the 32-bit driver can't load
# and glXChooseVisual asserts anyway.)
#
# We do NOT wrap steam in vglrun: the client only wants a software visual, and
# forcing the VGL faker across steam's whole multi-process bootstrap (bash,
# pressure-vessel, srt tools, the 32-bit client, the 64-bit CEF helper) is
# fragile (faker ELF-class mismatch on the 32-bit client, "[VGL] Could not
# enable OpenGL API" on the software backend). Real GPU acceleration for 64-bit
# games is delivered the standard way instead: pressure-vessel imports
# /run/opengl-driver (64-bit NVIDIA, also published by nix-gpu-setup) as its
# graphics provider.
#
#   - nix-bwrap-run wraps steam-run so its FHS gets a real /nix/store under the
#     per-app /nix/store->/store symlink layout.
#
# custom_startup.sh runs this foreground in its respawn loop (PGREP=steam).
set -u

RUN=/nix/var/nix/profiles/steam/bin/steam-run

# dbus + XDG_RUNTIME_DIR (mirror nix-launch): steam's CEF/dbus need them.
[ -f /tmp/kasm-dbus.env ] && {
    . /tmp/kasm-dbus.env 2>/dev/null
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && export DBUS_SESSION_BUS_ADDRESS
    [ -n "${DBUS_SESSION_BUS_PID:-}" ]     && export DBUS_SESSION_BUS_PID
}
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    uid=$(id -u)
    XDG_RUNTIME_DIR="/run/user/${uid}"
    [ -d "${XDG_RUNTIME_DIR}" ] || \
        install -d -m 0700 "${XDG_RUNTIME_DIR}" 2>/dev/null || \
        mkdir -p "${XDG_RUNTIME_DIR}" 2>/dev/null
    export XDG_RUNTIME_DIR
fi

# vdso trap: never leak Kasm's baked system LD_LIBRARY_PATH into the nix chain
# (mixes system glibc into nix binaries → __vdso_gettimeofday / __nptl_change_
# stack_perm). Same rationale as nix-launch.
unset LD_LIBRARY_PATH

# ── first-run splash ─────────────────────────────────────────────────────────
# Steam's bootstrap + steamwebhelper (CEF) take ~60s (≈100s on first launch,
# which also downloads the latest client) to draw ANY window — the blank desktop
# reads as "broken" and generates support tickets. Flags (-cef-disable-gpu,
# -nobootstrapupdate, -noverifyfiles) don't move this; it's inherent to steam's
# multi-process boot. So show a lightweight pulsing "Steam is starting…" until
# steam's own window appears (or a 210s cap). Best-effort and fully detached:
# a splash failure must never affect the launch. Only on the first launch of a
# session (guarded by a per-session stamp) so restarts don't re-nag.
_splash_stamp="${XDG_RUNTIME_DIR:-/tmp}/.steam-splash-shown"
if command -v zenity >/dev/null 2>&1 && [ ! -e "${_splash_stamp}" ]; then
    : > "${_splash_stamp}" 2>/dev/null || true
    (
        exec >/dev/null 2>&1
        fifo="$(mktemp -u)"; mkfifo "${fifo}" 2>/dev/null || exit 0
        zenity --progress --pulsate --no-cancel --auto-close \
            --title="Steam" --width=400 \
            --text="Steam is starting…
First launch downloads the latest client and can take a minute." < "${fifo}" &
        zpid=$!
        exec 3>"${fifo}"          # hold the pipe open so the bar keeps pulsing
        i=0
        while [ "${i}" -lt 210 ]; do
            kill -0 "${zpid}" 2>/dev/null || break
            # close once steam's real client window is up (not the tiny
            # steamwebhelper helper windows, whose title ends in "helper").
            if wmctrl -l 2>/dev/null | grep -qiE 'sign in to steam| steam$'; then break; fi
            sleep 2; i=$((i+2))
        done
        echo 100 >&3 2>/dev/null   # auto-close the dialog
        exec 3>&-; rm -f "${fifo}" 2>/dev/null
        kill "${zpid}" 2>/dev/null
    ) &
fi

# The 32-bit client always gets its software GLX visual from /run/opengl-driver-32;
# if a GPU is allocated, 64-bit games additionally see NVIDIA via /run/opengl-driver.
if nix-gpu-run --available; then
    echo "steam-launch: GPU allocated — 64-bit games via /run/opengl-driver" >&2
else
    echo "steam-launch: no GPU — software rendering only" >&2
fi
exec nix-bwrap-run "${RUN}" steam "$@"
