{
	admin off
	# Real certificate via Let's Encrypt. HTTP-01 needs :80 reachable from
	# anywhere, so the security list opens :80 to 0.0.0.0/0 for the challenge
	# while :443 stays restricted to the admin IP and the CIVO egress IP.
	# Renewals therefore keep working without further changes.
	email emrul.islam@kasmweb.com
}

https://grafana.emrul.oci.dev.remotebrowser.net {
	handle /loki/* {
		basic_auth {
			{$LOKI_USER} {$LOKI_HASH}
		}
		reverse_proxy loki:3100
	}

	handle /prom/* {
		basic_auth {
			{$PROM_USER} {$PROM_HASH}
		}
		uri strip_prefix /prom
		reverse_proxy prometheus:9090
	}

	handle {
		reverse_proxy grafana:3000
	}
}
