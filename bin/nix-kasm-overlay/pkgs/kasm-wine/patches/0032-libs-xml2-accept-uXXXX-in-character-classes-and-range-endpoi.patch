 	    case '\\': case '|': case '.': case '-': case '^': case '?':
 	    case '*': case '+': case '{': case '}': case '(': case ')':
 	    case '[': case ']':
@@ -5010,7 +5075,13 @@ xmlFAParseCharRange(xmlRegParserCtxtPtr ctxt) {
