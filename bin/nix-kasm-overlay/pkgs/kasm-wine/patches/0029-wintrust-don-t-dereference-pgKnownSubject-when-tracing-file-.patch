Subject: wintrust: don't dereference pgKnownSubject when tracing file info.
Fork-Commit: 20d69ddfef85ced9a46b3894efb08bd9d045aa9b

diff --git a/dlls/wintrust/tests/softpub.c b/dlls/wintrust/tests/softpub.c
index 407b74ac826..8bff31861a3 100644
--- a/dlls/wintrust/tests/softpub.c
+++ b/dlls/wintrust/tests/softpub.c
@@ -899,6 +899,44 @@ static void test_wintrust(void)
     ok(r == S_OK, "WinVerifyTrust failed: %08lx\n", r);
 }
 
+static void test_wintrust_close_subject(void)
+{
+    GUID action = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+    WINTRUST_FILE_INFO file = {0};
+    WINTRUST_DATA data = {0}, close_data;
+    WCHAR path[MAX_PATH];
+    GUID *subject;
+    LONG ret;
+
+    GetModuleFileNameW(NULL, path, ARRAY_SIZE(path));
+    file.cbStruct = sizeof(file);
+    file.pcwszFilePath = path;
+    data.cbStruct = sizeof(data);
+    data.dwUIChoice = WTD_UI_NONE;
+    data.dwUnionChoice = WTD_CHOICE_FILE;
+    data.pFile = &file;
+    data.dwStateAction = WTD_STATEACTION_VERIFY;
+    data.dwProvFlags = WTD_CACHE_ONLY_URL_RETRIEVAL;
+
+    ret = WinVerifyTrust(NULL, &action, &data);
+    ok(ret == TRUST_E_NOSIGNATURE, "Unexpected verify result %#lx.\n", ret);
+    ok(!!data.hWVTStateData, "Expected provider state.\n");
+    if (!data.hWVTStateData) return;
+
+    subject = VirtualAlloc(NULL, sizeof(*subject), MEM_RESERVE | MEM_COMMIT, PAGE_NOACCESS);
+    ok(!!subject, "Failed to allocate subject page, error %lu.\n", GetLastError());
+    /* CLOSE does not use the subject GUID, including with +wintrust tracing. */
+    file.pgKnownSubject = subject;
+    close_data = data;
+    close_data.dwStateAction = WTD_STATEACTION_CLOSE;
+    SetLastError(0xdeadbeef);
+    ret = WinVerifyTrust(NULL, &action, &close_data);
+    ok(ret == S_OK, "Unexpected close result %#lx.\n", ret);
+    ok(!close_data.hWVTStateData, "Expected cleared provider state, got %p.\n", close_data.hWVTStateData);
+    ok(GetLastError() == 0xdeadbeef, "Unexpected last error %lu.\n", GetLastError());
+    if (subject) VirtualFree(subject, 0, MEM_RELEASE);
+}
+
 /* Self-signed .exe, built with tcc, signed with signtool
  * (and a certificate generated on a self-signed CA).
  *
@@ -1960,6 +1998,7 @@ START_TEST(softpub)
     test_provider_funcs();
     test_sip_create_indirect_data();
     test_wintrust();
+    test_wintrust_close_subject();
     test_wintrust_digest();
     test_get_known_usages();
     test_WTHelperGetProvCertFromChain();
diff --git a/dlls/wintrust/wintrust_main.c b/dlls/wintrust/wintrust_main.c
index a9b1587e5be..613edc885b3 100644
--- a/dlls/wintrust/wintrust_main.c
+++ b/dlls/wintrust/wintrust_main.c
@@ -536,7 +536,7 @@ static void dump_file_info(WINTRUST_FILE_INFO *pFile)
         TRACE("cbStruct: %ld\n", pFile->cbStruct);
         TRACE("pcwszFilePath: %s\n", debugstr_w(pFile->pcwszFilePath));
         TRACE("hFile: %p\n", pFile->hFile);
-        TRACE("pgKnownSubject: %s\n", debugstr_guid(pFile->pgKnownSubject));
+        TRACE("pgKnownSubject: %p\n", pFile->pgKnownSubject);
     }
 }
 
