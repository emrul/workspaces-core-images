#!/usr/bin/env bash
# nix-bake-closure — bake one or more nix-kasm-overlay packages into a distro
# base image.
#
# Some distros ship no per-distro Kasm service artifact (e.g. no KasmVNC .deb for
# Ubuntu Resolute / 26.04). For those we build the service as a Nix package
# (bin/nix-kasm-overlay) and *bake* its closure into the base image: the finish
# Dockerfile COPYs the staged store into /nix and wires the binaries. This
# script productionises what used to be a hand-run sequence on the build host:
#
#   1. nix build --impure .#<pkg>            (each requested overlay attr)
#   2. union of `nix-store -qR` of every out path  → the closure to ship
#   3. deterministically stage that closure into <context>/nix-closure/nix/store
#      (hardlink where possible — same primitive as build-nix-store-volume's
#      link_path; cp -al for dirs, ln -f for files)
#   4. docker/podman build the finish Dockerfile, passing each package's out
#      path as <PKG>_STORE_PATH (e.g. kasmvnc -> KASMVNC_STORE_PATH)
#
# It is generic over the package set so new Nix-packaged services (profile_sync,
# audio_input, …) bake through the same path: add `--pkg <attr>` and the
# matching wiring + ARG in the finish Dockerfile.
#
# Nix runner: uses the host `nix` when present; otherwise runs the build inside a
# `nixos/nix` container (for CI hosts with no host Nix, e.g. the forge DinD),
# reusing a persistent store volume for cache when --nix-volume is given.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# ── defaults ────────────────────────────────────────────────────────────────
OVERLAY_DIR="${OVERLAY_DIR:-${REPO_ROOT}/bin/nix-kasm-overlay}"
CONTEXT="${CONTEXT:-${REPO_ROOT}}"
DOCKERFILE="${DOCKERFILE:-${REPO_ROOT}/dockerfile-nix-ubuntu-resolute}"
DOCKER="${DOCKER:-docker}"
# Fully-qualified: podman in headless CI enforces short-name resolution and
# cannot prompt for a registry, so a bare "nixos/nix:latest" fails there.
NIX_IMAGE="${NIX_IMAGE:-docker.io/nixos/nix:latest}"
NIX_RUNNER="${NIX_RUNNER:-auto}"        # auto | host | container
NIX_VOLUME="${NIX_VOLUME:-}"            # persistent /nix store volume (container runner)
STORE_ID="${STORE_ID:-}"               # non-empty → stage a multi-store store at
                                       #   <ctx>/nix-stores/<id>/store (for nix-compose),
                                       #   instead of the single-mount <ctx>/nix-closure/nix.
BASE_IMAGE=""
TAG=""
KEEP_CLOSURE=0
declare -a PKGS=()
declare -a EXTRA_BUILD_ARGS=()
declare -a LABELS=()

usage() {
  cat >&2 <<EOF
Usage: nix-bake-closure --base IMG --tag IMG [--pkg ATTR]... [options]

  --base IMG            base image to bake onto (required), e.g.
                        localhost/kasm-core-ubuntu-resolute:dev
  --tag IMG             output image tag (required)
  --pkg ATTR            overlay package attr to bake (repeatable;
                        default: kasmvnc). Passed to the finish build as
                        <ATTR_UPPER>_STORE_PATH (profile_sync -> PROFILE_SYNC_STORE_PATH).
  --dockerfile FILE     finish Dockerfile (default: dockerfile-nix-ubuntu-resolute)
  --overlay DIR         overlay flake dir (default: bin/nix-kasm-overlay)
  --context DIR         docker build context (default: repo root)
  --build-arg K=V       extra build-arg for the finish build (repeatable)
  --label K=V           OCI label for the finish image (repeatable) — e.g. the
                        base-stamp labels nix-base-check/publish-base read
  --docker CMD          docker|podman (default: docker)
  --nix-runner MODE     auto|host|container (default: auto)
  --nix-image IMG       nixos/nix image for container runner (default: docker.io/nixos/nix:latest)
  --nix-volume NAME     persistent /nix store volume for the container runner
  --store-id ID         stage as a multi-store store at <context>/nix-stores/ID/store
                        (for nix-compose union) instead of <context>/nix-closure/nix.
                        The finish Dockerfile then COPYs nix-stores/ID/store.
  --keep-closure        keep the staged closure dir after the build (default: remove)
  -h, --help            this help
EOF
  exit "${1:-0}"
}

# ── arg parse ───────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
  case "$1" in
    --base)        BASE_IMAGE="$2"; shift 2 ;;
    --tag)         TAG="$2"; shift 2 ;;
    --pkg)         PKGS+=("$2"); shift 2 ;;
    --dockerfile)  DOCKERFILE="$2"; shift 2 ;;
    --overlay)     OVERLAY_DIR="$2"; shift 2 ;;
    --context)     CONTEXT="$2"; shift 2 ;;
    --build-arg)   EXTRA_BUILD_ARGS+=("--build-arg" "$2"); shift 2 ;;
    --label)       LABELS+=("--label" "$2"); shift 2 ;;
    --docker)      DOCKER="$2"; shift 2 ;;
    --nix-runner)  NIX_RUNNER="$2"; shift 2 ;;
    --nix-image)   NIX_IMAGE="$2"; shift 2 ;;
    --nix-volume)  NIX_VOLUME="$2"; shift 2 ;;
    --store-id)    STORE_ID="$2"; shift 2 ;;
    --keep-closure) KEEP_CLOSURE=1; shift ;;
    -h|--help)     usage 0 ;;
    *) echo "nix-bake-closure: unknown arg: $1" >&2; usage 1 ;;
  esac
done

[ -n "${BASE_IMAGE}" ] || { echo "nix-bake-closure: --base is required" >&2; usage 1; }
[ -n "${TAG}" ]        || { echo "nix-bake-closure: --tag is required" >&2; usage 1; }
[ -f "${DOCKERFILE}" ] || { echo "nix-bake-closure: dockerfile not found: ${DOCKERFILE}" >&2; exit 1; }
[ -d "${OVERLAY_DIR}" ] || { echo "nix-bake-closure: overlay dir not found: ${OVERLAY_DIR}" >&2; exit 1; }
[ "${#PKGS[@]}" -gt 0 ] || PKGS=(kasmvnc)

# Where the closure is staged in the build context, and how the extract tar
# strips the leading path. Default: <ctx>/nix-closure/nix/store (dockerfile COPYs
# nix-closure/nix -> /nix). With --store-id: <ctx>/nix-stores/<id>/store (a
# mountable-shaped store; dockerfile COPYs nix-stores/<id>/store), stripping the
# "nix/" prefix off the "nix/store/<hash>" members so they land under .../store.
if [ -n "${STORE_ID}" ]; then
  CLOSURE_DIR="${CONTEXT}/nix-stores/${STORE_ID}"
  STORE_DST="${CLOSURE_DIR}/store"
  EXTRACT_STRIP="--strip-components=1"
else
  CLOSURE_DIR="${CONTEXT}/nix-closure"
  STORE_DST="${CLOSURE_DIR}/nix/store"
  EXTRACT_STRIP=""
fi

log() { echo "[nix-bake-closure] $*" >&2; }

# upper-case + s/-/_/ so `profile-sync` -> PROFILE_SYNC_STORE_PATH
argname() { echo "$1" | tr '[:lower:]-' '[:upper:]_'; }

# ── pick nix runner ─────────────────────────────────────────────────────────
if [ "${NIX_RUNNER}" = "auto" ]; then
  if command -v nix >/dev/null 2>&1; then NIX_RUNNER="host"; else NIX_RUNNER="container"; fi
fi
log "nix runner: ${NIX_RUNNER}"

# ── build packages + stage their closure into the build context ──────────────
# Staging uses a tar pipe (not cp -al) so it works non-root: nix store dirs are
# read-only, which defeats cp without root, whereas GNU tar reads the read-only
# tree and restores dir modes last. --sort/--mtime/--numeric-owner make the
# staged tree byte-stable → reproducible finish layers. Members are relative to /
# (nix/store/<hash>...) so they land under <context>/nix-closure/nix.
# chmod first: the read-only dirs otherwise block rm -rf on re-runs.
if [ -e "${CLOSURE_DIR}" ]; then chmod -R u+w "${CLOSURE_DIR}" 2>/dev/null || true; rm -rf "${CLOSURE_DIR}"; fi
mkdir -p "${STORE_DST}"

attrs=""; for pkg in "${PKGS[@]}"; do attrs="${attrs} .#${pkg}"; done
declare -a OUT_PATHS=()

if [ "${NIX_RUNNER}" = "host" ]; then
  # Host /nix persists across commands, so build → closure → stage can be steps.
  for pkg in "${PKGS[@]}"; do
    log "nix build .#${pkg}"
    out="$( cd "${OVERLAY_DIR}" && nix build --impure --no-link --print-out-paths ".#${pkg}" | tail -1 )"
    [ -n "${out}" ] || { echo "nix-bake-closure: empty out path for ${pkg}" >&2; exit 1; }
    log "  ${pkg} -> ${out}"
    OUT_PATHS+=("${out}")
    EXTRA_BUILD_ARGS+=("--build-arg" "$(argname "${pkg}")_STORE_PATH=${out}")
  done
  log "computing + staging closure (nix-store -qR)"
  members="$( nix-store -qR "${OUT_PATHS[@]}" | sort -u | sed 's|^/||' )"
  tar -C / --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      -cf - -T <(printf '%s\n' "${members}") \
    | tar -C "${CLOSURE_DIR}" ${EXTRACT_STRIP} -xf -
else
  # Container runner (no host nix): build + closure-capture + tar-export MUST run
  # in ONE `docker run`, because each run's /nix is ephemeral unless --nix-volume
  # is given — a separate build and a separate nix-store -qR would not share the
  # store. Writes outpaths.txt (attr -> store path) + closure.tar into the ctx.
  log "nix build (container, single-shot): ${PKGS[*]}"
  # The nixos/nix image is minimal (no sed/tar/cut), so the inner steps run under
  # `nix shell` (coreutils/gnutar/gnused on PATH) from a mounted script — which
  # also avoids fragile nested quoting. Build + closure + tar-export all happen in
  # this one container so its ephemeral /nix persists across them. $ATTRS is left
  # literal here (single-quoted heredoc) and expanded in-container from -e ATTRS.
  cat > "${CLOSURE_DIR}/_inner.sh" <<'INNER'
set -eu
: > /out/outpaths.txt
for a in $ATTRS; do
  o=$(nix build --impure --no-link --print-out-paths "$a" | tail -1)
  [ -n "$o" ] || { echo "empty out path for $a" >&2; exit 1; }
  printf '%s %s\n' "$a" "$o" >> /out/outpaths.txt
done
nix-store -qR $(cut -d' ' -f2 /out/outpaths.txt) | sort -u | sed 's|^/||' > /out/members.txt
tar -C / --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cf /out/closure.tar -T /out/members.txt
INNER
  vol_arg=(); [ -n "${NIX_VOLUME}" ] && vol_arg=(-v "${NIX_VOLUME}:/nix")
  # --network host: the nested nixos/nix container inside the forge DIND otherwise
  # has no DNS, so nix build/shell can't resolve channels.nixos.org/cache.nixos.org.
  "${DOCKER}" run --rm --network host \
    "${vol_arg[@]}" \
    -e ATTRS="${attrs}" \
    -v "${OVERLAY_DIR}:/overlay" -v "${CLOSURE_DIR}:/out" -w /overlay \
    "${NIX_IMAGE}" \
    sh -euc 'mkdir -p /etc/nix && printf "experimental-features = nix-command flakes\n" > /etc/nix/nix.conf && exec nix shell nixpkgs#coreutils nixpkgs#gnutar nixpkgs#gnused --command sh /out/_inner.sh'
  while read -r a o; do
    [ -n "${o}" ] || continue
    pkg="${a#.#}"
    OUT_PATHS+=("${o}")
    EXTRA_BUILD_ARGS+=("--build-arg" "$(argname "${pkg}")_STORE_PATH=${o}")
    log "  ${pkg} -> ${o}"
  done < "${CLOSURE_DIR}/outpaths.txt"
  tar -C "${CLOSURE_DIR}" ${EXTRACT_STRIP} -xf "${CLOSURE_DIR}/closure.tar"
  rm -f "${CLOSURE_DIR}/closure.tar" "${CLOSURE_DIR}/members.txt" "${CLOSURE_DIR}/outpaths.txt" "${CLOSURE_DIR}/_inner.sh"
fi
chmod -R u+w "${CLOSURE_DIR}" 2>/dev/null || true
log "staged closure into ${STORE_DST} ($(du -sh "${CLOSURE_DIR}" 2>/dev/null | cut -f1))"

# ── 4. finish build (bake) ──────────────────────────────────────────────────
log "building ${TAG} (base=${BASE_IMAGE}, dockerfile=$(basename "${DOCKERFILE}"))"
"${DOCKER}" build \
  --build-arg "BASE_IMAGE=${BASE_IMAGE}" \
  "${EXTRA_BUILD_ARGS[@]}" \
  ${LABELS[@]+"${LABELS[@]}"} \
  -f "${DOCKERFILE}" \
  -t "${TAG}" \
  "${CONTEXT}"

if [ "${KEEP_CLOSURE}" -eq 0 ]; then
  chmod -R u+w "${CLOSURE_DIR}" 2>/dev/null || true
  rm -rf "${CLOSURE_DIR}"
  log "removed staging ${CLOSURE_DIR} (use --keep-closure to retain)"
fi
log "done: ${TAG}"
