#!/usr/bin/env bash
# nix-crane-assemble — content-addressed image assembly for the Nix catalog.
#
# Replaces the podman-`build` (COPY) assembly in build-nix-store-volume. It tars
# each store partition DETERMINISTICALLY (GNU tar --sort=name → reproducible tar,
# and crane uses the tar AS the layer, so diff_id = sha256(tar)); the fat store
# and every per-app image then share byte-identical base/shared/profile layers
# that dedupe by digest — across apps, the fat store, and distro bases. Per-app
# images are fully crane-assembled (no podman finish): store layers + a
# /nix/store->/store symlink layer + a per-app wiring layer + ENV.
#
# Expects the partition tree the inner build staged under $STAGING:
#   base/store, layer-<n>/store, profile-<app>/store, meta/var,
#   appmeta-<app>/var, Dockerfile.<app> (parsed for each app's layer set),
#   apps.txt
#
# Env:
#   STAGING        staging dir (…/.build/layers)          [required]
#   REPO_ROOT      repo root (for src/ubuntu/install/nix) [required]
#   FAT_TAG        fat store image tag (localhost/nix-store-<arch>:dev)
#   APP_REPO       per-app repo prefix (localhost/nix)
#   APP_TAG        per-app tag (dev)
#   APP_BASE_IMAGE nix-<distro> base (local podman image ref)
#   CONTAINER_CLI  podman|docker (default podman)
#   ARCH           amd64|arm64 (for the crane download)
#   ONLY_APPS      space list to assemble (default: all in apps.txt)
#   PUSH_REGISTRY  optional final push target
set -euo pipefail

STAGING="${STAGING:?set STAGING}"
REPO_ROOT="${REPO_ROOT:?set REPO_ROOT}"
FAT_TAG="${FAT_TAG:-localhost/nix-store-${ARCH:-amd64}:dev}"
APP_REPO="${APP_REPO:-localhost/nix}"
APP_TAG="${APP_TAG:-dev}"
CONTAINER_CLI="${CONTAINER_CLI:-podman}"
ARCH="${ARCH:-amd64}"
# ── Resolute multi-store apps (design/nix-workspace-as-code.md) ──────────────
# A DESKTOP image built on the Resolute nix base instead of a single-app Noble
# base. Same byte-identical store partition tars (→ /store, dedupe with the fat
# store + standalone apps), baked as a store nix-compose unions into /nix at boot
# — NOT the /nix/store->/store single-store seam. A tiny registration layer
# symlinks /nix-stores/<id>/{store,var} -> /{store,var} so nix-compose's
# `/nix-stores/*/store` glob picks it up. No single-app wiring (the Resolute base
# owns the desktop + nix-activate); NIX_APP_PROFILES drives activation (requires
# expand via nix-activate now that jq is baked into the base).
RESOLUTE_APPS="${RESOLUTE_APPS:-}"                 # space list, e.g. "tracelabs"
RESOLUTE_BASE_IMAGE="${RESOLUTE_BASE_IMAGE:-}"     # localhost/nix-ubuntu-resolute:dev
RESOLUTE_REPO="${RESOLUTE_REPO:-localhost/nix-resolute}"
RESOLUTE_TAG="${RESOLUTE_TAG:-${APP_TAG}}"
REG_LOCAL="127.0.0.1:5000"
NIXSRC="${REPO_ROOT}/src/ubuntu/install/nix"
BLOBS="${STAGING}/.blobs"; mkdir -p "${BLOBS}"

# ── provenance for OCI labels ────────────────────────────────────────────────
# The inner build (which HAS jq) writes jq-free sidecars into STAGING for us —
# this script runs in the outer podman/stable env with NO jq. labels.env is
# source-safe; applabels.tsv (app\tref\trev\tstorepath\tversion) is read by awk.
# Labels live in the image CONFIG, not layer blobs — stamping them does not
# change any store layer's digest, so cross-image blob dedup is preserved.
GIT_SHA="$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || echo unknown)"
BUILT_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
BASE_REF=""; BASE_REV=""; PROFILE_REFS="{}"
# shellcheck disable=SC1091
[[ -f "${STAGING}/labels.env" ]] && source "${STAGING}/labels.env"
APPLABELS_TSV="${STAGING}/applabels.tsv"
# app_label <profile> <col 2..5> → field from applabels.tsv (empty if absent).
app_label() { [[ -f "${APPLABELS_TSV}" ]] && awk -F'\t' -v p="$1" -v c="$2" '$1==p{print $c; exit}' "${APPLABELS_TSV}" 2>/dev/null || true; }

log(){ printf '[crane-assemble] %s\n' "$*" >&2; }
fail(){ printf '[crane-assemble] ERROR: %s\n' "$*" >&2; exit 1; }

# ── tooling ────────────────────────────────────────────────────────────────
ensure_crane() {
  CRANE="$(command -v crane 2>/dev/null || true)"
  [[ -n "${CRANE}" ]] && return 0
  CRANE=/usr/local/bin/crane
  [[ -x "${CRANE}" ]] && return 0
  local a="x86_64"; [[ "${ARCH}" == arm64 ]] && a="arm64"
  log "downloading crane (${a})"
  curl -fsSL "https://github.com/google/go-containerregistry/releases/download/v0.20.2/go-containerregistry_Linux_${a}.tar.gz" \
    | tar xz -C /usr/local/bin crane
}
ensure_registry() {
  # This registry is STAGING ONLY for the crane→podman handoff — crane re-pushes
  # every blob each run, so it never needs to persist. Recreate it fresh each run;
  # the `-v` on rm drops the previous run's anonymous volume, which otherwise
  # accumulates ~25-35G PER BUILD and fills the box. See design/nix-ci-disk.md.
  "${CONTAINER_CLI}" rm -f -v nix-crane-registry >/dev/null 2>&1 || true
  "${CONTAINER_CLI}" run -d --name nix-crane-registry -p 127.0.0.1:5000:5000 registry:2 >/dev/null
  local i; for i in $(seq 1 30); do
    curl -sf "http://${REG_LOCAL}/v2/" >/dev/null 2>&1 && return 0; sleep 0.5
  done
  fail "local registry did not come up"
}

# ── deterministic tar of a partition (once; crane uses it AS the layer) ──────
# det_tar <staging-subdir> <member-root> <blob-basename>
det_tar() {
  local out="${BLOBS}/$3.tar"
  [[ -s "${out}" ]] && return 0
  [[ -d "${STAGING}/$1/$2" ]] || return 1
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      -C "${STAGING}/$1" -cf "${out}" "$2"
}

# ── symlink layer (shared by all per-app images): /nix/store->/store etc. ────
mk_symlink_tar() {
  [[ -s "${BLOBS}/symlink.tar" ]] && return 0
  local d="${STAGING}/.symlink"; rm -rf "${d}"; mkdir -p "${d}/nix"
  ln -s /store "${d}/nix/store"; ln -s /var "${d}/nix/var"
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      -C "${d}" -cf "${BLOBS}/symlink.tar" nix
}

# ── resolute registration layer: /nix-stores/<id>/{store,var} -> /{store,var} ─
# Lets nix-compose's `/nix-stores/*/store` glob find the store we baked at /store
# WITHOUT re-rooting the (byte-identical, dedupe-preserving) store tars. `-d`
# follows the symlink so the glob + `[ -d ]` guard match; the union then farms
# /store's paths into the composed /nix/store, and reads profiles via
# /nix-stores/<id>/var/nix/profiles -> /var/nix/profiles. Tiny, app-specific tar.
mk_resolute_reg_tar() {
  local id="$1" d="${STAGING}/.resolute-reg-${id}"
  [[ -s "${BLOBS}/resolute-reg-${id}.tar" ]] && return 0
  rm -rf "${d}"; mkdir -p "${d}/nix-stores/${id}"
  ln -s /store "${d}/nix-stores/${id}/store"
  ln -s /var   "${d}/nix-stores/${id}/var"
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      -C "${d}" -cf "${BLOBS}/resolute-reg-${id}.tar" nix-stores
}

# ── resolute desktop-asset wiring: post-build.sh only (NO single-app startup) ─
# The Resolute base owns the desktop, so a multi-store app contributes only its
# static assets (vault seed, wallpaper, browser policy) via post-build.sh —
# never custom_startup/nix-app-launch (those are the single-app seam). Returns
# non-zero (no tar) when the app ships no post-build.sh.
stage_resolute_wiring_tar() {
  local p="$1" w="${STAGING}/.rwiring-${p}"
  [[ -s "${BLOBS}/rwiring-${p}.tar" ]] && return 0
  [[ -f "${NIXSRC}/${p}/post-build.sh" ]] || return 1
  rm -rf "${w}"; mkdir -p "${w}"
  DESTDIR="${w}" sh "${NIXSRC}/${p}/post-build.sh" >&2 || return 1
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -C "${w}" -cf "${BLOBS}/rwiring-${p}.tar" .
}

# ── per-app wiring layer (custom_startup, launchers, post-build output) ──────
stage_wiring_tar() {
  local p="$1" w="${STAGING}/.wiring-${p}"
  [[ -s "${BLOBS}/wiring-${p}.tar" ]] && return 0
  rm -rf "${w}"; mkdir -p "${w}/dockerstartup" "${w}/usr/local/bin"
  install -m0755 "${NIXSRC}/${p}/custom_startup.sh" "${w}/dockerstartup/custom_startup.sh"
  install -m0755 "${NIXSRC}/scripts/nix-app-launch" "${w}/usr/local/bin/nix-app-launch"
  [[ -f "${NIXSRC}/${p}/launch" ]] && install -m0755 "${NIXSRC}/${p}/launch" "${w}/usr/local/bin/${p}-launch"
  [[ -f "${NIXSRC}/${p}/post-build.sh" ]] && DESTDIR="${w}" sh "${NIXSRC}/${p}/post-build.sh"
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -C "${w}" -cf "${BLOBS}/wiring-${p}.tar" .
}

# ── parse an app's store/meta partitions from its staged Dockerfile ─────────
app_store_parts(){ grep -E '^COPY .+/store /store$' "${STAGING}/Dockerfile.$1" | awk '{print $2}' | sed 's#/store$##'; }
app_meta_dir(){ grep -E '^COPY .+/var /var$' "${STAGING}/Dockerfile.$1" | awk '{print $2}' | sed 's#/var$##' | head -1; }

ensure_crane
ensure_registry

# ── fat store: scratch + all store partitions + full meta (mountable /store) ─
log "assembling fat store ${FAT_TAG}"
fat_args=()
det_tar base store base && fat_args+=( -f "${BLOBS}/base.tar" )
for d in "${STAGING}"/layer-*; do [[ -d "${d}/store" ]] || continue; n="$(basename "${d}")"; det_tar "${n}" store "${n}" && fat_args+=( -f "${BLOBS}/${n}.tar" ); done
for d in "${STAGING}"/profile-*; do [[ -d "${d}/store" ]] || continue; n="$(basename "${d}")"; det_tar "${n}" store "${n}" && fat_args+=( -f "${BLOBS}/${n}.tar" ); done
det_tar meta var meta && fat_args+=( -f "${BLOBS}/meta.tar" )
fat_ref="${REG_LOCAL}/nix-store:${APP_TAG}"
"${CRANE}" append --insecure --oci-empty-base "${fat_args[@]}" -t "${fat_ref}"
# Stamp reproducibility/provenance labels (config-only; blobs unchanged). crane
# rejects empty label values, so only add labels whose value is non-empty.
fat_labels=( --label "dev.kasm.nix.build-arch=${ARCH}" )
[[ -n "${BASE_REF}" ]]     && fat_labels+=( --label "dev.kasm.nix.base-ref=${BASE_REF}" )
[[ -n "${BASE_REV}" ]]     && fat_labels+=( --label "dev.kasm.nix.base-rev=${BASE_REV}" )
[[ -n "${PROFILE_REFS}" ]] && fat_labels+=( --label "dev.kasm.nix.profile-refs=${PROFILE_REFS}" )
[[ -n "${BUILT_AT}" ]]     && fat_labels+=( --label "dev.kasm.nix.built-at=${BUILT_AT}" )
[[ -n "${GIT_SHA}" ]]      && fat_labels+=( --label "org.opencontainers.image.revision=${GIT_SHA}" )
"${CRANE}" mutate --insecure "${fat_ref}" -t "${fat_ref}" "${fat_labels[@]}"
"${CONTAINER_CLI}" pull --tls-verify=false "${fat_ref}" >/dev/null
"${CONTAINER_CLI}" tag "${fat_ref}" "${FAT_TAG}"
log "fat store ready: ${FAT_TAG}"

# ── per-app: base + its store subset + meta + symlink + wiring + ENV ────────
# Parallel: shared partitions are already tarred (fat step above); each worker
# only tars its own meta+wiring and references existing blobs. crane dedups at
# push (unchanged blobs = "existing blob", no re-upload) → automatic gating.
mapfile -t apps < <(grep -v '^$' "${STAGING}/apps.txt" 2>/dev/null || true)
# CHANGED_ONLY (eval-gate): assemble per-app images only for profiles that were
# actually (re)built this run — unchanged apps keep their already-published image
# (publish push-skips them on store-path anyway), so re-assembling them is wasted
# work. The fat store above is unaffected (it globs ALL persistent store
# partitions, so it stays complete). changed.txt is written only on full builds;
# ONLY_APPS still overrides. See design/nix-self-hosted-packages.md.
if [[ "${CHANGED_ONLY:-0}" == "1" && -f "${STAGING}/changed.txt" ]]; then
  mapfile -t apps < <(grep -v '^$' "${STAGING}/changed.txt" 2>/dev/null || true)
  log "CHANGED_ONLY: ${#apps[@]} changed app(s) to assemble (unchanged apps keep their published image)"
fi
# Wiring-digest supplement (full-selection builds, 2026-07-18): changed.txt only
# reflects STORE-input changes (the eval-gate's inputKey) — an app whose
# src/ubuntu/install/nix/<app>/ wiring alone changed would never re-assemble and
# the fix would never ship. Wiring tars are deterministic (sort/mtime@0), so:
# stage every app's wiring tar (KBs), compare sha256 against the previous run's
# record (WIRING_STATE_DIR/wiring-digests.json), and pull any mover into the
# assembly set. The record is rewritten only after the assembly loop, so a
# failed run re-detects the same movers next time. No record yet → fail-safe:
# assemble everything once to seed it.
# NB: bash 5.3 + set -u treats ${#assoc[@]} / ${!assoc[@]} on a declared-but-
# EMPTY associative array as unbound (failed pipeline 2687593748) — track the
# entry count in a plain variable and only expand the array when it's > 0.
declare -A wiring_dig; wiring_count=0
if [[ "${CHANGED_ONLY:-0}" == "1" && -n "${WIRING_STATE_DIR:-}" ]]; then
  mapfile -t _all_apps < <(grep -v '^$' "${STAGING}/apps.txt" 2>/dev/null || true)
  for p in "${_all_apps[@]}"; do
    [[ -f "${NIXSRC}/${p}/custom_startup.sh" ]] || continue  # fat-store-only extra
    stage_wiring_tar "${p}" || { log "WARN wiring tar failed for ${p} (digest skipped)"; continue; }
    wiring_dig["${p}"]="$(sha256sum "${BLOBS}/wiring-${p}.tar" | awk '{print $1}')"
    wiring_count=$((wiring_count+1))
  done
  if [[ -f "${WIRING_STATE_DIR}/wiring-digests.tsv" ]]; then
    wiring_extra=()
    for p in "${_all_apps[@]}"; do
      [[ -n "${wiring_dig[$p]:-}" ]] || continue
      prev="$(awk -F'\t' -v p="${p}" '$1==p{print $2}' "${WIRING_STATE_DIR}/wiring-digests.tsv" 2>/dev/null || true)"
      if [[ "${prev}" != "${wiring_dig[$p]}" ]]; then
        case " ${apps[*]:-} " in *" $p "*) ;; *) wiring_extra+=("$p"); apps+=("$p") ;; esac
      fi
    done
    [[ "${#wiring_extra[@]}" -gt 0 ]] && log "wiring changed → also assembling: ${wiring_extra[*]}"
  else
    log "no wiring-digest record — assembling ALL apps once to seed it"
    apps=( "${_all_apps[@]}" )
  fi
fi
[[ -n "${ONLY_APPS:-}" ]] && apps=( ${ONLY_APPS} )
RESULTS="${STAGING}/.crane-results"; rm -rf "${RESULTS}"; mkdir -p "${RESULTS}"

assemble_app() {
  local p="$1"; local logf="${RESULTS}/${p}.log"
  {
    # No custom_startup.sh ⇒ this profile is a fat-store-only extra, not a
    # standalone workspace image. It has no launch wiring, so a per-app image
    # couldn't run as a Kasm workspace anyway — skip emitting one (the profile
    # stays reachable via the fat store). Recorded as skipped, NOT failed.
    [[ -f "${NIXSRC}/${p}/custom_startup.sh" ]] || { printf 'no custom_startup.sh\n' > "${RESULTS}/${p}.skip"; return 0; }
    local a_args=() part md
    for part in $(app_store_parts "${p}"); do det_tar "${part}" store "${part}" && a_args+=( -f "${BLOBS}/${part}.tar" ); done
    md="$(app_meta_dir "${p}")"; [[ -n "${md}" ]] && det_tar "${md}" var "${md}" && a_args+=( -f "${BLOBS}/${md}.tar" )
    a_args+=( -f "${BLOBS}/symlink.tar" )
    stage_wiring_tar "${p}" && a_args+=( -f "${BLOBS}/wiring-${p}.tar" ) || { printf 'wiring\n' > "${RESULTS}/${p}.fail"; return 0; }
    local app_ref="${REG_LOCAL}/nix-${p}:${APP_TAG}" final="${APP_REPO}-${p}:${APP_TAG}"
    # Per-app provenance labels (config-only; store layers still dedupe by digest).
    # Read from applabels.tsv (no jq); crane rejects empty values, so add only
    # labels whose value is non-empty.
    local lbl_ref lbl_rev lbl_sp lbl_ver
    lbl_ref="$(app_label "${p}" 2)"; lbl_rev="$(app_label "${p}" 3)"
    lbl_sp="$(app_label "${p}" 4)";  lbl_ver="$(app_label "${p}" 5)"
    local mut=( --env "NIX_APP_PROFILES=${p}" --label "dev.kasm.nix.app=${p}" )
    [[ -n "${lbl_ref}" ]]  && mut+=( --label "dev.kasm.nix.ref=${lbl_ref}" )
    [[ -n "${lbl_rev}" ]]  && mut+=( --label "dev.kasm.nix.rev=${lbl_rev}" )
    [[ -n "${lbl_sp}" ]]   && mut+=( --label "dev.kasm.nix.store-path=${lbl_sp}" )
    [[ -n "${BASE_REV}" ]] && mut+=( --label "dev.kasm.nix.base-rev=${BASE_REV}" )
    [[ -n "${BUILT_AT}" ]] && mut+=( --label "dev.kasm.nix.built-at=${BUILT_AT}" )
    [[ -n "${GIT_SHA}" ]]  && mut+=( --label "org.opencontainers.image.revision=${GIT_SHA}" )
    [[ -n "${lbl_ver}" ]]  && mut+=( --label "org.opencontainers.image.version=${lbl_ver}" )
    "${CRANE}" append --insecure -b "${base_ref}" "${a_args[@]}" -t "${app_ref}" \
      && "${CRANE}" mutate --insecure "${app_ref}" "${mut[@]}" -t "${app_ref}" \
      || { printf 'assemble\n' > "${RESULTS}/${p}.fail"; return 0; }
    "${CONTAINER_CLI}" pull --tls-verify=false "${app_ref}" >/dev/null \
      && "${CONTAINER_CLI}" tag "${app_ref}" "${final}" \
      || { printf 'pull\n' > "${RESULTS}/${p}.fail"; return 0; }
    if [[ -n "${PUSH_REGISTRY:-}" ]]; then
      "${CRANE}" copy --insecure "${app_ref}" "${PUSH_REGISTRY}/nix-${p}:${APP_TAG}" \
        || { printf 'push\n' > "${RESULTS}/${p}.fail"; return 0; }
    fi
    printf 'ok\n' > "${RESULTS}/${p}.ok"
  } > "${logf}" 2>&1
}

if [[ "${#apps[@]}" -gt 0 ]]; then
  [[ -n "${APP_BASE_IMAGE:-}" ]] || fail "APP_BASE_IMAGE required to assemble per-app images"
  base_ref="${REG_LOCAL}/nixbase:${APP_TAG}"
  "${CONTAINER_CLI}" tag "${APP_BASE_IMAGE}" "${base_ref}"
  "${CONTAINER_CLI}" push --tls-verify=false "${base_ref}" >/dev/null
  mk_symlink_tar

  _np="$( { command -v nproc >/dev/null 2>&1 && nproc; } 2>/dev/null || echo 4 )"
  [[ "${_np}" =~ ^[0-9]+$ ]] || _np=4
  PAR="${BUILD_PARALLEL:-$(( _np < 4 ? _np : 4 ))}"
  [[ "${PAR}" =~ ^[0-9]+$ ]] && [[ "${PAR}" -ge 1 ]] || PAR=4
  log "assembling ${#apps[@]} per-app image(s), parallel=${PAR}"
  inflight=0
  for p in "${apps[@]}"; do
    assemble_app "${p}" &
    inflight=$((inflight+1))
    if [[ "${inflight}" -ge "${PAR}" ]]; then wait -n 2>/dev/null || wait; inflight=$((inflight-1)); fi
  done
  wait

  ok=0; skipped=(); failed=()
  for p in "${apps[@]}"; do
    if [[ -f "${RESULTS}/${p}.ok" ]]; then ok=$((ok+1)); log "  ${p}: OK"
    elif [[ -f "${RESULTS}/${p}.skip" ]]; then skipped+=( "${p}" ); log "  ${p}: skipped ($(cat "${RESULTS}/${p}.skip" 2>/dev/null || echo '?'))"
    else failed+=( "${p}($(cat "${RESULTS}/${p}.fail" 2>/dev/null || echo '?'))" )
      log "  ${p}: FAILED — last lines:"; tail -15 "${RESULTS}/${p}.log" 2>/dev/null | sed "s/^/    [${p}] /" >&2 || true
    fi
  done
  log "per-app: ok=${ok} skipped=${#skipped[@]} failed=${#failed[@]} ${failed[*]:-}"
  [[ "${#skipped[@]}" -gt 0 ]] && log "per-app skipped (fat-store-only, no custom_startup.sh): ${skipped[*]}"
fi

# ── resolute multi-store apps: desktop image on the Resolute nix base ────────
# For each named app, reuse its already-tarred store partitions (same blobs as
# the fat store + the standalone per-app image → registry-wide dedup) but assemble
# onto the Resolute base with the /nix-stores/<id> registration layer instead of
# the /nix/store->/store seam, and no single-app wiring.
if [[ -n "${RESOLUTE_APPS}" ]]; then
  [[ -n "${RESOLUTE_BASE_IMAGE}" ]] || fail "RESOLUTE_APPS set but RESOLUTE_BASE_IMAGE empty"
  "${CONTAINER_CLI}" image exists "${RESOLUTE_BASE_IMAGE}" 2>/dev/null \
    || "${CONTAINER_CLI}" image inspect "${RESOLUTE_BASE_IMAGE}" >/dev/null 2>&1 \
    || fail "RESOLUTE_BASE_IMAGE not found in ${CONTAINER_CLI} store: ${RESOLUTE_BASE_IMAGE}"
  rbase_ref="${REG_LOCAL}/nixresolutebase:${RESOLUTE_TAG}"
  "${CONTAINER_CLI}" tag "${RESOLUTE_BASE_IMAGE}" "${rbase_ref}"
  "${CONTAINER_CLI}" push --tls-verify=false "${rbase_ref}" >/dev/null
  for p in ${RESOLUTE_APPS}; do
    [[ -f "${STAGING}/Dockerfile.${p}" ]] || { log "resolute: no Dockerfile.${p} (build with --emit-app-images and --profile ${p}) — skipping"; continue; }
    id="${p}"
    log "assembling resolute multi-store app '${p}' (store id '${id}') on ${RESOLUTE_BASE_IMAGE}"
    r_args=()
    for part in $(app_store_parts "${p}"); do det_tar "${part}" store "${part}" && r_args+=( -f "${BLOBS}/${part}.tar" ); done
    md="$(app_meta_dir "${p}")"; [[ -n "${md}" ]] && det_tar "${md}" var "${md}" && r_args+=( -f "${BLOBS}/${md}.tar" )
    mk_resolute_reg_tar "${id}" && r_args+=( -f "${BLOBS}/resolute-reg-${id}.tar" ) \
      || { log "resolute ${p}: registration tar failed"; continue; }
    # Optional desktop-asset layer (vault/wallpaper/policy) when the app ships a
    # post-build.sh (e.g. src/ubuntu/install/nix/tracelabs/).
    if stage_resolute_wiring_tar "${p}"; then
      r_args+=( -f "${BLOBS}/rwiring-${p}.tar" ); log "resolute ${p}: + desktop-asset wiring layer"
    fi
    r_ref="${REG_LOCAL}/nix-resolute-${p}:${RESOLUTE_TAG}"
    r_final="${RESOLUTE_REPO}-${p}:${RESOLUTE_TAG}"
    # Provenance labels mirror the per-app path (config-only; store blobs dedupe).
    r_ref_lbl="$(app_label "${p}" 2)"; r_rev_lbl="$(app_label "${p}" 3)"
    r_sp_lbl="$(app_label "${p}" 4)"; r_ver_lbl="$(app_label "${p}" 5)"
    r_mut=( --env "NIX_APP_PROFILES=${p}" --label "dev.kasm.nix.app=${p}" \
            --label "dev.kasm.nix.base-model=resolute-multi-store" \
            --label "dev.kasm.nix.store-id=${id}" )
    [[ -n "${r_ref_lbl}" ]] && r_mut+=( --label "dev.kasm.nix.ref=${r_ref_lbl}" )
    [[ -n "${r_rev_lbl}" ]] && r_mut+=( --label "dev.kasm.nix.rev=${r_rev_lbl}" )
    [[ -n "${r_sp_lbl}" ]]  && r_mut+=( --label "dev.kasm.nix.store-path=${r_sp_lbl}" )
    [[ -n "${BUILT_AT}" ]]  && r_mut+=( --label "dev.kasm.nix.built-at=${BUILT_AT}" )
    [[ -n "${GIT_SHA}" ]]   && r_mut+=( --label "org.opencontainers.image.revision=${GIT_SHA}" )
    [[ -n "${r_ver_lbl}" ]] && r_mut+=( --label "org.opencontainers.image.version=${r_ver_lbl}" )
    "${CRANE}" append --insecure -b "${rbase_ref}" "${r_args[@]}" -t "${r_ref}" \
      && "${CRANE}" mutate --insecure "${r_ref}" "${r_mut[@]}" -t "${r_ref}" \
      || { log "resolute ${p}: crane assemble FAILED"; continue; }
    "${CONTAINER_CLI}" pull --tls-verify=false "${r_ref}" >/dev/null \
      && "${CONTAINER_CLI}" tag "${r_ref}" "${r_final}" \
      || { log "resolute ${p}: pull/tag FAILED"; continue; }
    if [[ -n "${PUSH_REGISTRY:-}" ]]; then
      "${CRANE}" copy --insecure "${r_ref}" "${PUSH_REGISTRY}/nix-resolute-${p}:${RESOLUTE_TAG}" \
        || log "resolute ${p}: push FAILED"
    fi
    log "resolute app ready: ${r_final}"
  done
fi

# Persist the wiring-digest record + the assembled-app list (scan/publish scope)
# AFTER the assembly loop, so an interrupted run re-detects the same wiring
# movers on the next attempt. assembled.txt is written whenever a state dir is
# available — downstream (nix-scan-l3.sh) uses it as the exact
# "what did this build reassemble" answer.
if [[ -n "${WIRING_STATE_DIR:-}" ]]; then
  mkdir -p "${WIRING_STATE_DIR}"
  if [[ "${wiring_count}" -gt 0 ]]; then
    { for p in "${!wiring_dig[@]}"; do printf '%s\t%s\n' "${p}" "${wiring_dig[$p]}"; done; } \
      | sort > "${WIRING_STATE_DIR}/wiring-digests.tsv" \
      || log "WARN could not write wiring-digests.tsv"
  fi
  printf '%s\n' "${apps[@]:-}" | grep -v '^$' > "${WIRING_STATE_DIR}/assembled.txt" || true
fi

# also push the fat store if requested
if [[ -n "${PUSH_REGISTRY:-}" ]]; then
  "${CRANE}" copy --insecure "${fat_ref}" "${PUSH_REGISTRY}/${FAT_TAG#localhost/}" && log "pushed fat store → ${PUSH_REGISTRY}"
fi
log "done"
