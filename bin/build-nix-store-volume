#!/usr/bin/env bash
# build-nix-store-volume — emit a multi-layer OCI image whose payload
# is a Nix store containing the configured profiles.
#
# Architecture: all the heavy lifting happens inside a `nixos/nix`
# container. Host requirements collapse to podman OR docker only —
# no Python, no jq, no APFS sparseimage. The Nix store is staged in a
# named podman volume (lives in the container engine's filesystem,
# which is ext4 / case-sensitive even on macOS+lima), and the inner
# container tars a build context that the host then feeds to
# `podman build` via stdin. The host's filesystem never touches a Nix
# store path.
#
# See design/nix-package-process.md for the layer-split logic.
#
# Usage:
#   build-nix-store-volume [--config FILE] [--profile NAME ...]
#                          [--tag REPO:TAG] [--push REGISTRY]
#                          [--arch amd64|arm64] [--nix-image REF]
#                          [--prune-stage] [--keep-output]

set -euo pipefail

# ───── Defaults ────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/nix-profiles.toml"
# Fully-qualified: podman with short-name-mode=enforcing (e.g. the podman/stable
# DinD image) cannot resolve a bare "nixos/nix" without a TTY prompt.
NIX_IMAGE_DEFAULT="docker.io/nixos/nix:2.28.4"
ONLY_PROFILES=()
TAG=""
PUSH_REGISTRY=""
ARCH=""
PRUNE_STAGE=0
KEEP_OUTPUT=0
EMIT_APP_IMAGES=0
APP_BASE_IMAGE="localhost/nix-ubuntu:dev"
APP_REPO="localhost/nix"
APP_TAG=""

# ───── Helpers ─────────────────────────────────────────────────────────
log()  { printf '%s %s\n' "[build-nix-store-volume]" "$*" >&2; }
fail() { printf '%s FATAL: %s\n' "[build-nix-store-volume]" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
build-nix-store-volume — build a Nix-store OCI image

  --config FILE        TOML config (default: ${CONFIG_FILE})
  --profile NAME       Build only this profile (repeatable). When any
                       --profile is given, all others are skipped.
  --tag REPO:TAG       Output image tag
                       (default: localhost/nix-store-<arch>:dev)
  --push REGISTRY      Push to REGISTRY/<image> after build
  --arch amd64|arm64   Target arch (default: host arch). Cross-arch
                       runs through qemu-user emulation — slow.
  --nix-image REF      Container image for nix builds
                       (default: ${NIX_IMAGE_DEFAULT})
  --prune-stage        Delete the cached staging volume after a
                       successful build (forces a clean rebuild next
                       run; otherwise Nix dedup speeds things up).
  --keep-output        Keep \$HOME/.cache/nix-build-output around
                       after the build for forensics. By default the
                       context tar is removed once consumed.
  --emit-app-images    In addition to the fat store-mount image, emit
                       one runnable store-image per selected profile,
                       FROM the --app-base-image. Each image carries the
                       base layer, the shared layers it actually uses,
                       its required-profile deltas, and its own delta as
                       *separate* OCI layers — so the base + shared
                       layers dedupe across every app at the registry.
                       App wiring (launch / custom_startup / single-app
                       XFCE) is layered on afterwards by a host finish
                       build (dockerfile-nix-app-finish); this step only
                       produces the ${APP_REPO}-store/<profile> images.
  --app-base-image REF nix-ubuntu base for the per-app store-images
                       (default: ${APP_BASE_IMAGE}). Must exist in the
                       host container store; it is fed to the inner
                       build as a docker-archive so no store path ever
                       lands on the host filesystem.
  --app-repo REPO      Repo prefix for emitted images
                       (default: ${APP_REPO}; store-images go to
                       <REPO>-store/<profile>:<tag>).
  -h, --help           This text

Host requirements: podman (preferred) OR docker. That's it.
Staging volume: podman volume nix-build-stage-<arch> (cached).
Tear down with:  ${0##*/} --prune-stage   or
                 podman volume rm nix-build-stage-<arch>
EOF
}

# ───── Arg parsing ─────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)       CONFIG_FILE="$2"; shift 2 ;;
    --profile)      ONLY_PROFILES+=("$2"); shift 2 ;;
    --tag)          TAG="$2"; shift 2 ;;
    --push)         PUSH_REGISTRY="$2"; shift 2 ;;
    --arch)         ARCH="$2"; shift 2 ;;
    --nix-image)    NIX_IMAGE_DEFAULT="$2"; shift 2 ;;
    --prune-stage)  PRUNE_STAGE=1; shift ;;
    --keep-output)  KEEP_OUTPUT=1; shift ;;
    --emit-app-images) EMIT_APP_IMAGES=1; shift ;;
    --app-base-image)  APP_BASE_IMAGE="$2"; shift 2 ;;
    --app-repo)        APP_REPO="$2"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *)              usage >&2; fail "unknown arg: $1" ;;
  esac
done

# ───── Toolchain detection (host needs nothing else) ───────────────────
if command -v podman >/dev/null 2>&1; then
  CONTAINER_CLI=podman
elif command -v docker >/dev/null 2>&1; then
  CONTAINER_CLI=docker
else
  fail "need podman or docker on PATH"
fi

# ───── Arch detection ──────────────────────────────────────────────────
if [[ -z "${ARCH}" ]]; then
  case "$(uname -m)" in
    x86_64|amd64)  ARCH=amd64 ;;
    aarch64|arm64) ARCH=arm64 ;;
    *) fail "unsupported host arch: $(uname -m); pass --arch explicitly" ;;
  esac
fi
[[ -z "${TAG}" ]] && TAG="localhost/nix-store-${ARCH}:dev"
PLATFORM="linux/${ARCH}"
STAGE_VOLUME="nix-build-stage-${ARCH}"
# Per-app store-images reuse the fat-store tag's :suffix (e.g. :dev).
APP_TAG="${TAG##*:}"
[[ "${APP_TAG}" == "${TAG}" ]] && APP_TAG="dev"

# ───── Config ──────────────────────────────────────────────────────────
[[ -f "${CONFIG_FILE}" ]] || fail "config not found: ${CONFIG_FILE}"

# ───── Output dir for the context tar (only the tar; no nix paths) ─────
OUTPUT_DIR="${HOME}/.cache/nix-build-output"
mkdir -p "${OUTPUT_DIR}"
INNER_SCRIPT="${OUTPUT_DIR}/inner-build.sh"

cleanup() {
  if [[ "${KEEP_OUTPUT}" == 1 ]]; then
    log "output kept at ${OUTPUT_DIR}"
  else
    rm -f "${OUTPUT_DIR}/image.tar" "${INNER_SCRIPT}" \
          "${OUTPUT_DIR}/base-image.tar" "${OUTPUT_DIR}"/app-*.tar
  fi
}
trap cleanup EXIT

# ───── Announce ────────────────────────────────────────────────────────
log "config:      ${CONFIG_FILE}"
log "tag:         ${TAG}"
log "arch:        ${ARCH}"
log "platform:    ${PLATFORM}"
log "container:   ${CONTAINER_CLI}"
log "nix image:   ${NIX_IMAGE_DEFAULT}"
log "stage vol:   ${STAGE_VOLUME} (persistent; --prune-stage to reset)"
if [[ "${EMIT_APP_IMAGES}" == 1 ]]; then
  log "emit apps:   yes (store-images → ${APP_REPO}-store/<profile>:${APP_TAG})"
  log "app base:    ${APP_BASE_IMAGE}"
fi

# ───── Ensure named volume exists + seeded with /nix from image ───────
# The volume is mounted at /nix in the inner build, so the image's
# bundled nix binary (which itself lives in /nix/store) would be
# masked. Seed the volume with the image's /nix on first run; the
# sentinel file makes this idempotent (single stat() on every later
# run).
if ! "${CONTAINER_CLI}" volume inspect "${STAGE_VOLUME}" >/dev/null 2>&1; then
  log "creating named volume ${STAGE_VOLUME}"
  "${CONTAINER_CLI}" volume create "${STAGE_VOLUME}" >/dev/null
fi

log "ensuring ${STAGE_VOLUME} is seeded with ${NIX_IMAGE_DEFAULT}'s /nix"
# The :z mount flag tells podman to apply a *shared* SELinux label to
# the volume so multiple containers (seed + the inner build, possibly
# probe containers later) can all access it. Without it, lima's VM
# applies a restrictive label to the volume and subsequent container
# reads fail with "Permission denied" even though file modes look fine.
"${CONTAINER_CLI}" run --rm \
    --platform "${PLATFORM}" \
    --volume "${STAGE_VOLUME}:/volume-data:rw,z" \
    --entrypoint /bin/sh \
    "${NIX_IMAGE_DEFAULT}" \
    -c '
      if [ ! -f /volume-data/.nix-init-done ]; then
        echo "[seed] first-time init: copying /nix → volume" >&2
        cp -a /nix/. /volume-data/
        touch /volume-data/.nix-init-done
        echo "[seed] done" >&2
      fi
    '

# ───── Inner build script (runs inside nixos/nix) ──────────────────────
# Stages into /build (the named volume). Uses Nix builtins.fromTOML to
# parse the config — no host python required. Tars the resulting build
# context into /output/context.tar for the host's outer build.

cat > "${INNER_SCRIPT}" <<'INNER'
#!/bin/sh
set -eu

# The named volume is mounted at /nix. The bundled nix binary, its
# closure, and all our installed profiles/store paths live in the
# volume so they persist across runs. Per-build ephemeral staging
# (closures, layer trees, json) goes under /nix/.build/ — same
# filesystem as /nix/store so cp -al hardlinks work.
STAGE_IN=/nix/.build
CONFIG_IN=/config/profiles.toml
OUTPUT_IN=/output
KASM_PROFILE_DIR=/nix/var/nix/profiles
KASM_GCROOT_DIR=/nix/var/nix/gcroots

# Wipe per-build staging from prior run; the live store stays.
rm -rf "${STAGE_IN}"
mkdir -p "${STAGE_IN}/closures" "${STAGE_IN}/layers"

# Keep temp on the ext4-backed named volume (same fs as the staging tree)
# rather than the container's small/overlay /tmp — avoids filling the inner
# container's writable layer during partitioning.
export TMPDIR="${STAGE_IN}/tmp"
mkdir -p "${TMPDIR}"

# Profiles + gcroots live directly under /nix/var/nix/{profiles,gcroots}/
# (no namespace subdir). The seeded nixos/nix volume already ships
# /nix/var/nix/profiles/{default,per-user/...} and the matching gcroots;
# we add our own profile names alongside them. The selective meta-layer
# copy below picks out only our additions so the bundled default profile
# doesn't leak into the final image.
mkdir -p "${KASM_PROFILE_DIR}" "${KASM_GCROOT_DIR}"

# Many PoC packages have proprietary upstreams (claude-code, opencode,
# codex, vscode, slack, obsidian, etc.). Nix gates these behind an
# unfree-license check; the env var + --impure pair is the standard
# escape hatch. We also allow `insecure` packages because some Electron
# CLIs ship known-CVE'd transitive Node versions in their closure —
# they get fixed quickly upstream, but a fresh ref bump can briefly
# trip the insecure check.
export NIXPKGS_ALLOW_UNFREE=1
export NIXPKGS_ALLOW_INSECURE=1

# Bump the binary-cache download buffer from the 64 MiB default — the
# heavy closures (Chromium, OnlyOffice, Electron apps) keep the
# default buffer full and Nix prints
#   "warning: download buffer is full; consider increasing the
#    'download-buffer-size' setting"
# while it waits to drain. Set via NIX_CONFIG so every nix invocation
# inside this container honours it without per-call flags.
export NIX_CONFIG="download-buffer-size = 536870912"

# ── 0. helper tools ────────────────────────────────────────────────────
# nixos/nix:* is FROM scratch + nix's own closure — no apk, no awk, no
# jq by default. Install whatever we need via nix profile install into
# a dedicated `.helpers` profile under the named volume, so the cost is
# paid once and reused on every subsequent run.
needs=""
command -v jq      >/dev/null 2>&1 || needs="${needs} nixpkgs#jq"
# awk: only used by the auto-promote loop which now goes through POSIX
# `set --` instead, but keep gawk available as a helper in case any
# future addition reaches for it.
command -v awk     >/dev/null 2>&1 || needs="${needs} nixpkgs#gawk"
# NOTE: image assembly no longer happens here. The inner build only stages
# the layer tree + Dockerfiles into the named volume; the OUTER podman builds
# them directly into its overlay store (copy-on-write, layer cache, no tar
# round-trip). So buildah is no longer installed in this container.

if [ -n "${needs}" ]; then
  echo "[inner] installing helper tools:${needs}" >&2
  # shellcheck disable=SC2086
  nix --extra-experimental-features 'nix-command flakes' \
      profile install --impure \
      --profile "${KASM_PROFILE_DIR}/.helpers" \
      ${needs}
fi
# Always source the helpers profile path (idempotent across runs).
if [ -d "${KASM_PROFILE_DIR}/.helpers/bin" ]; then
  export PATH="${KASM_PROFILE_DIR}/.helpers/bin:${PATH}"
fi

# ── 1. TOML → JSON via builtins.fromTOML ───────────────────────────────
nix --extra-experimental-features 'nix-command flakes' \
    eval --raw --impure --expr \
    "builtins.toJSON (builtins.fromTOML (builtins.readFile ${CONFIG_IN}))" \
    > "${STAGE_IN}/profiles.json"

# ── 2. profile selection ───────────────────────────────────────────────
# ONLY_PROFILES env var (CSV) restricts to a subset.
if [ -n "${ONLY_PROFILES:-}" ]; then
  printf '%s\n' "${ONLY_PROFILES}" | tr ',' '\n' | grep -v '^$' \
      > "${STAGE_IN}/selected.txt"
else
  jq -r '.profiles | keys[]' "${STAGE_IN}/profiles.json" \
      > "${STAGE_IN}/selected.txt"
fi

# Filter by per-profile `platforms = [...]`. An empty/missing platforms
# list means "no restriction"; if the list is present, the target arch
# (from TARGET_ARCH env, set by the host) must be in it.
TARGET_ARCH="${TARGET_ARCH:-amd64}"
TMP_SEL="${STAGE_IN}/selected.txt.tmp"
: > "${TMP_SEL}"
while IFS= read -r p; do
  [ -z "$p" ] && continue
  plats="$(jq -r --arg p "$p" \
              '.profiles[$p].platforms // [] | join(" ")' \
              "${STAGE_IN}/profiles.json")"
  if [ -z "$plats" ]; then
    printf '%s\n' "$p" >> "${TMP_SEL}"
  elif printf '%s\n' $plats | grep -qxF "${TARGET_ARCH}"; then
    printf '%s\n' "$p" >> "${TMP_SEL}"
  else
    echo "[inner] SKIP profile '$p' — platforms=[${plats}] does not include ${TARGET_ARCH}" >&2
  fi
done < "${STAGE_IN}/selected.txt"
mv "${TMP_SEL}" "${STAGE_IN}/selected.txt"

THRESHOLD="$(jq -r '.promote.threshold_percent // 80' "${STAGE_IN}/profiles.json")"
DEFAULT_REF="$(jq -r '.nixpkgs.ref' "${STAGE_IN}/profiles.json")"

# ── ref pinning + provenance ───────────────────────────────────────────
# The config `ref` is a FLOATING branch (e.g. github:NixOS/nixpkgs/nixos-25.05).
# For a reproducible, self-describing build we resolve every unique ref to its
# concrete commit ONCE, up front, and install against the pinned commit — so
# base and apps can't drift apart mid-build, and the exact rev is stamped onto
# the image as an OCI label (see nix-crane-assemble). To reproduce a build
# later, set the config ref to the recorded dev.kasm.nix.*-rev commit.
#
# Pinning changes the ref STRING, which would collide with a warm staging
# volume's profiles (nix profile install appends → "already provides" errors);
# every profile is therefore reset before install (reset_profile below).
REFMAP="${STAGE_IN}/refmap.tsv"        # cache: <orig-ref>\t<rev>
APPLABELS="${STAGE_IN}/applabels.tsv"  # per-app: name\tref\trev\tstorepath\tversion
: > "${REFMAP}"
: > "${APPLABELS}"

# resolve_rev <ref> → concrete rev (github .locked.rev, else .locked.narHash).
# Cached in REFMAP. Empty (offline / unresolvable) degrades gracefully.
resolve_rev() {
  _r="$1"
  _cached="$(awk -F'\t' -v r="$_r" '$1==r{print $2; exit}' "${REFMAP}" 2>/dev/null || true)"
  if [ -n "${_cached}" ]; then printf '%s' "${_cached}"; return 0; fi
  _rev="$(nix --extra-experimental-features 'nix-command flakes' \
            flake metadata "$_r" --json 2>/dev/null \
          | jq -r '.locked.rev // .locked.narHash // ""' 2>/dev/null || true)"
  printf '%s\t%s\n' "$_r" "${_rev}" >> "${REFMAP}"
  printf '%s' "${_rev}"
}

# pin_ref <ref> → github:owner/repo/<rev> (concrete commit) when resolvable;
# non-github refs (path: overlays, already-locked flakes) pass through unchanged
# — their rev is still recorded for the label.
pin_ref() {
  _r="$1"; _rev="$(resolve_rev "$_r")"
  case "$_r" in
    github:*)
      [ -n "${_rev}" ] \
        && printf '%s' "$_r" | awk -F/ -v R="${_rev}" 'BEGIN{OFS="/"}{print $1,$2,R}' \
        || printf '%s' "$_r" ;;
    *) printf '%s' "$_r" ;;
  esac
}

# reset_profile <name> — drop a warm profile symlink + its generation links so
# a re-pinned install rebuilds it fresh instead of appending/colliding.
reset_profile() {
  rm -f "${KASM_PROFILE_DIR}/$1" "${KASM_PROFILE_DIR}/$1"-*-link
}

# Resolve + pin the base ref once; everything downstream uses the pinned form.
BASE_REF_ORIG="${DEFAULT_REF}"
BASE_REV="$(resolve_rev "${BASE_REF_ORIG}")"
DEFAULT_REF="$(pin_ref "${BASE_REF_ORIG}")"

echo "[inner] base ref:     ${BASE_REF_ORIG}" >&2
echo "[inner] base rev:     ${BASE_REV:-<unresolved>}" >&2
echo "[inner] pinned ref:   ${DEFAULT_REF}" >&2
echo "[inner] target arch:  ${TARGET_ARCH}" >&2
echo "[inner] profiles:     $(tr '\n' ' ' < "${STAGE_IN}/selected.txt")" >&2

# (profile + gcroot dirs were ensured earlier, before the helpers
# install runs.)

nix_install() {
  prof_path="$1"; shift
  echo "  installing $(basename "$prof_path") (attrs: $*)" >&2
  nix --extra-experimental-features 'nix-command flakes' \
      profile install --impure --profile "$prof_path" "$@"
  ln -sfn "$prof_path" "${KASM_GCROOT_DIR}/$(basename "$prof_path")"
}

rewrite_attr() {
  attr="$1"; ref="$2"
  case "$attr" in
    nixpkgs#*) printf '%s#%s\n' "$ref" "${attr#nixpkgs#}" ;;
    *)         printf '%s\n' "$attr" ;;
  esac
}

collect_attrs() {
  jq_path="$1"; ref="$2"
  jq -r "$jq_path" "${STAGE_IN}/profiles.json" | while IFS= read -r a; do
    [ -z "$a" ] && continue
    rewrite_attr "$a" "$ref"
  done
}

# ── 3. bootstrap profile (bundled nix CLI) ─────────────────────────────
# Reset first: the pinned ref string changes when the base branch advances, so
# a warm bootstrap/_base from a prior run must be rebuilt fresh (see pinning).
reset_profile bootstrap
nix_install "${KASM_PROFILE_DIR}/bootstrap" \
            "$(rewrite_attr "nixpkgs#nix" "${DEFAULT_REF}")"

# ── 4. _base profile ───────────────────────────────────────────────────
reset_profile _base
collect_attrs '.base.pkgs[]' "${DEFAULT_REF}" \
  | xargs nix --extra-experimental-features 'nix-command flakes' \
      profile install --impure --profile "${KASM_PROFILE_DIR}/_base"
ln -sfn "${KASM_PROFILE_DIR}/_base" "${KASM_GCROOT_DIR}/_base"

# ── 4b. _gpu support profile (optional) ────────────────────────────────
# VirtualGL + vulkan-loader for /usr/local/bin/nix-gpu-run. Folded into the
# base set below so it ships in the base layer and is excluded from per-profile
# deltas. It is NOT a toml `.profiles` entry, so it stays out of _meta.json
# (not activatable). Skipped cleanly when [gpu] is absent.
HAS_GPU=0
if jq -e '.gpu.pkgs | length > 0' "${STAGE_IN}/profiles.json" >/dev/null 2>&1; then
  HAS_GPU=1
  # Reset _gpu each run: its pkg set can change in a way that collides with the
  # warm staging volume's profile — e.g. swapping stock virtualgl for the trimmed
  # path:…#virtualgl-min both provide bin/vglrun, so `nix profile install` errors
  # with "existing package already provides …". The profile is a cheap symlink
  # tree over the persistent store, so rebuild it fresh.
  reset_profile _gpu
  collect_attrs '.gpu.pkgs[]' "${DEFAULT_REF}" \
    | xargs nix --extra-experimental-features 'nix-command flakes' \
        profile install --impure --profile "${KASM_PROFILE_DIR}/_gpu"
  ln -sfn "${KASM_PROFILE_DIR}/_gpu" "${KASM_GCROOT_DIR}/_gpu"
fi

# ── 4c. named intermediate layers (optional) ───────────────────────────
# Build each [layers.<name>] as an internal profile (_layer-<name>).
# Their closures are subtracted from every profile that contains them,
# so shared runtimes (Electron, Qt6, …) land in one dedicated OCI layer
# rather than being repeated in each app's delta.
# Skipped cleanly when no [layers] section is present.
LAYER_NAMES=""
if jq -e '(.layers // {}) | length > 0' "${STAGE_IN}/profiles.json" >/dev/null 2>&1; then
  echo "[inner] building intermediate layers" >&2
  while IFS= read -r lname; do
    [ -z "$lname" ] && continue
    l_ref="$(jq -r --arg l "$lname" '.layers[$l].ref // empty' \
                "${STAGE_IN}/profiles.json")"
    if [ -z "$l_ref" ]; then l_ref="${DEFAULT_REF}"; else l_ref="$(pin_ref "$l_ref")"; fi
    echo "  (layer ${lname} uses ref ${l_ref})" >&2
    reset_profile "_layer-${lname}"
    collect_attrs ".layers.\"$lname\".pkgs[]" "$l_ref" \
      | xargs nix --extra-experimental-features 'nix-command flakes' \
          profile install --impure \
          --profile "${KASM_PROFILE_DIR}/_layer-${lname}"
    ln -sfn "${KASM_PROFILE_DIR}/_layer-${lname}" \
            "${KASM_GCROOT_DIR}/_layer-${lname}"
    LAYER_NAMES="${LAYER_NAMES} ${lname}"
  done <<EOF
$(jq -r '(.layers // {}) | keys[]' "${STAGE_IN}/profiles.json")
EOF
fi

# ── 5. named profiles ──────────────────────────────────────────────────
# Resilient: a profile whose `nix profile install` fails (broken/renamed attr,
# build failure, unfree gate, …) is recorded and SKIPPED rather than aborting
# the whole catalog. selected.txt is rewritten to the profiles that actually
# built, so every downstream step (closures, partition, emit) operates only on
# successes. Failures are summarised at the end and written to failed.txt.
: > "${STAGE_IN}/built.txt"
: > "${STAGE_IN}/failed.txt"
while IFS= read -r p; do
  [ -z "$p" ] && continue
  p_ref_orig="$(jq -r --arg p "$p" '.profiles[$p].ref // empty' \
              "${STAGE_IN}/profiles.json")"
  [ -z "$p_ref_orig" ] && p_ref_orig="${BASE_REF_ORIG}"
  p_rev="$(resolve_rev "$p_ref_orig")"
  p_ref="$(pin_ref "$p_ref_orig")"      # install against the concrete commit
  echo "  ($p uses ref $p_ref_orig @ ${p_rev:-<unresolved>})" >&2
  # Reset the profile each run (same rationale as _gpu above): when a profile's
  # pkg set changes on the warm staging volume — swapping nixpkgs#steam for
  # path:…#steam-vgl, an onlyoffice ref bump, etc. — `nix profile install` appends
  # to the existing profile and dies with "An existing package already provides
  # …" on any shared file. The profile is a cheap symlink tree over the persistent
  # store (closures are cached), so rebuilding it fresh is safe and avoids the
  # collision.
  reset_profile "$p"
  if collect_attrs ".profiles.\"$p\".pkgs[]" "$p_ref" \
       | xargs nix --extra-experimental-features 'nix-command flakes' \
           profile install --impure --profile "${KASM_PROFILE_DIR}/$p"; then
    ln -sfn "${KASM_PROFILE_DIR}/$p" "${KASM_GCROOT_DIR}/$p"
    echo "$p" >> "${STAGE_IN}/built.txt"
    # Provenance for the per-app image label: the profile's realized store path
    # is content-addressed over the WHOLE app closure (changes iff anything in
    # the app changes); version is best-effort from the profile's first pkg.
    p_sp="$(readlink -f "${KASM_PROFILE_DIR}/$p" 2>/dev/null || true)"
    p_first="$(jq -r --arg p "$p" '.profiles[$p].pkgs[0] // empty' \
                 "${STAGE_IN}/profiles.json")"
    p_ver=""
    case "$p_first" in
      nixpkgs#*) p_ver="$(nix --extra-experimental-features 'nix-command flakes' \
                            eval --raw "$(rewrite_attr "$p_first" "$p_ref").version" \
                            2>/dev/null || true)" ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$p" "$p_ref_orig" "$p_rev" "$p_sp" "$p_ver" >> "${APPLABELS}"
  else
    echo "[inner] WARN profile install FAILED: $p — skipping (catalog continues)" >&2
    echo "$p" >> "${STAGE_IN}/failed.txt"
  fi
done < "${STAGE_IN}/selected.txt"
# Downstream steps operate on the profiles that actually built.
cp "${STAGE_IN}/built.txt" "${STAGE_IN}/selected.txt"
if [ -s "${STAGE_IN}/failed.txt" ]; then
  echo "[inner] profiles that FAILED to install (skipped): $(tr '\n' ' ' < "${STAGE_IN}/failed.txt")" >&2
fi

# ── 6. capture closures ────────────────────────────────────────────────
echo "[inner] capturing closures" >&2
nix-store -qR "${KASM_PROFILE_DIR}/bootstrap" | sort -u \
    > "${STAGE_IN}/closures/bootstrap.txt"
nix-store -qR "${KASM_PROFILE_DIR}/_base"     | sort -u \
    > "${STAGE_IN}/closures/_base.txt"
: > "${STAGE_IN}/closures/_gpu.txt"
if [ "${HAS_GPU}" = 1 ]; then
  nix-store -qR "${KASM_PROFILE_DIR}/_gpu" | sort -u \
      > "${STAGE_IN}/closures/_gpu.txt"
fi
sort -u -m "${STAGE_IN}/closures/_base.txt" \
            "${STAGE_IN}/closures/bootstrap.txt" \
            "${STAGE_IN}/closures/_gpu.txt" \
    > "${STAGE_IN}/closures/base_set.txt"

# Capture intermediate layer closures, then build combined_subtract.txt =
# base_set + every layer closure.  Profile deltas subtract this combined set,
# so a profile that contains an intermediate layer's paths doesn't re-copy them.
cp "${STAGE_IN}/closures/base_set.txt" "${STAGE_IN}/closures/combined_subtract.txt"
for lname in ${LAYER_NAMES:-}; do
  nix-store -qR "${KASM_PROFILE_DIR}/_layer-${lname}" | sort -u \
      > "${STAGE_IN}/closures/_layer-${lname}.txt"
  echo "[inner] layer '${lname}': $(wc -l < "${STAGE_IN}/closures/_layer-${lname}.txt") paths" >&2
  sort -u -m "${STAGE_IN}/closures/combined_subtract.txt" \
             "${STAGE_IN}/closures/_layer-${lname}.txt" \
      > "${STAGE_IN}/closures/combined_subtract.txt.tmp"
  mv "${STAGE_IN}/closures/combined_subtract.txt.tmp" \
     "${STAGE_IN}/closures/combined_subtract.txt"
done

while IFS= read -r p; do
  [ -z "$p" ] && continue
  nix-store -qR "${KASM_PROFILE_DIR}/$p" | sort -u \
      > "${STAGE_IN}/closures/$p.txt"
done < "${STAGE_IN}/selected.txt"

# ── 7. auto-promote heuristic ──────────────────────────────────────────
# A store path present in >= THRESHOLD% of profiles but NOT in [base]/[layers.*]
# is DUPLICATED into every app's delta layer → registry bloat. This surfaces
# such paths so an operator can promote them in bin/nix-profiles.toml (promotion
# is deliberately manual). ONLY meaningful on a FULL-catalog build: on a subset,
# prevalence is over the few selected profiles, so everything looks like ~100%.
if [ -n "${ONLY_PROFILES:-}" ]; then
  echo "[inner] auto-promote analysis SKIPPED (subset build: ${ONLY_PROFILES}) — run a full-catalog build for meaningful promotion candidates" >&2
else
  echo "[inner] auto-promote analysis (threshold ${THRESHOLD}%)" >&2
  total="$(wc -l < "${STAGE_IN}/selected.txt")"
  promo_report="${STAGE_IN}/promote-candidates.tsv"
  : > "${promo_report}"
  {
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      cat "${STAGE_IN}/closures/$p.txt"
    done < "${STAGE_IN}/selected.txt"
  } | sort | uniq -c | while IFS= read -r line; do
    # Pure POSIX field extraction — uniq -c output is "  <count> <path>"
    # with leading whitespace. `set --` word-splits the line on IFS
    # (default whitespace), so $1=count and $2=path with the leading
    # blanks dropped.
    # shellcheck disable=SC2086
    set -- $line
    count="${1:-}"
    path="${2:-}"
    [ -z "$path" ] && continue
    pct=$(( count * 100 / total ))
    if [ "$pct" -ge "$THRESHOLD" ] && \
       ! grep -qxF "$path" "${STAGE_IN}/closures/combined_subtract.txt"; then
      printf '%s\t%s/%s\t%s\n' "${pct}" "${count}" "${total}" "${path}" >> "${promo_report}"
    fi
  done
  # Actionable summary block (the per-line writes happened in a pipe subshell,
  # so read the collected report back here).
  n_promo="$(wc -l < "${promo_report}" 2>/dev/null | tr -d ' ')"
  if [ "${n_promo:-0}" -gt 0 ]; then
    echo "[inner] ==== PROMOTE CANDIDATES: ${n_promo} path(s) in >=${THRESHOLD}% of ${total} profiles, not shared ====" >&2
    echo "[inner] each is duplicated per-app; consider adding to [base] or a [layers.*] in bin/nix-profiles.toml:" >&2
    sort -rn "${promo_report}" | while IFS="$(printf '\t')" read -r pct frac path; do
      echo "[inner]   ${pct}% (${frac})  ${path}" >&2
    done
    echo "[inner] ==== end promote candidates (report: ${promo_report}) ====" >&2
  else
    echo "[inner] auto-promote: no new candidates over ${THRESHOLD}% threshold" >&2
  fi
fi

# ── 8. partition store across layer-staging dirs ──────────────────────
echo "[inner] partitioning store across layers" >&2
# Clean any stale layer staging from a previous run (named volume persists).
rm -rf "${STAGE_IN}/layers"
mkdir -p "${STAGE_IN}/layers/base/store" \
         "${STAGE_IN}/layers/meta/var/nix/db" \
         "${STAGE_IN}/layers/meta/var/nix/profiles"

link_path() {
  src="$1"; dst="$2"
  bn="$(basename "$src")"
  [ -e "${dst}/${bn}" ] && return 0
  if [ -d "${src}" ]; then
    cp -al "${src}" "${dst}/${bn}"
  else
    ln -f "${src}" "${dst}/${bn}"
  fi
}

while IFS= read -r path; do
  [ -z "$path" ] && continue
  link_path "$path" "${STAGE_IN}/layers/base/store"
done < "${STAGE_IN}/closures/base_set.txt"

# Intermediate layer staging: each layer's delta = layer closure - base_set.
# Layers are siblings (not stacked), so each subtracts only the base, not
# each other.  combined_subtract.txt (base + all layers) handles cross-layer
# dedup at the profile-delta stage below.
for lname in ${LAYER_NAMES:-}; do
  mkdir -p "${STAGE_IN}/layers/layer-${lname}/store"
  comm -23 "${STAGE_IN}/closures/_layer-${lname}.txt" \
           "${STAGE_IN}/closures/base_set.txt" \
           > "${STAGE_IN}/closures/_layer-${lname}-delta.txt"
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    link_path "$path" "${STAGE_IN}/layers/layer-${lname}/store"
  done < "${STAGE_IN}/closures/_layer-${lname}-delta.txt"
  echo "[inner] layer '${lname}' delta: $(wc -l < "${STAGE_IN}/closures/_layer-${lname}-delta.txt") paths" >&2
done

while IFS= read -r p; do
  [ -z "$p" ] && continue
  mkdir -p "${STAGE_IN}/layers/profile-${p}/store"
  # Subtract the full combined set (base + all intermediate layers) so profiles
  # that share a layer runtime don't re-copy those paths.
  comm -23 "${STAGE_IN}/closures/${p}.txt" \
           "${STAGE_IN}/closures/combined_subtract.txt" \
           > "${STAGE_IN}/closures/${p}-delta.txt"
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    link_path "$path" "${STAGE_IN}/layers/profile-${p}/store"
  done < "${STAGE_IN}/closures/${p}-delta.txt"
done < "${STAGE_IN}/selected.txt"

# ── 9. meta layer ──────────────────────────────────────────────────────
# Selective copy: pick only our profile entries (bootstrap + _base +
# everything in selected.txt) plus their generation `-link` symlinks.
# The seeded volume also holds the bundled `default` profile (and its
# generations) and a `per-user/` dir from the nixos/nix base image; the
# helpers profile is build-side only. None of those should ship.
echo "[inner] assembling meta layer" >&2
cp -a /nix/var/nix/db/db.sqlite \
      "${STAGE_IN}/layers/meta/var/nix/db/"

copy_meta_profile() {
  name="$1"
  src="${KASM_PROFILE_DIR}/${name}"
  if [ -e "${src}" ] || [ -L "${src}" ]; then
    cp -a "${src}" "${STAGE_IN}/layers/meta/var/nix/profiles/${name}"
  fi
  for link in "${KASM_PROFILE_DIR}/${name}-"*-link; do
    [ -e "${link}" ] || [ -L "${link}" ] || continue
    cp -a "${link}" "${STAGE_IN}/layers/meta/var/nix/profiles/$(basename "${link}")"
  done
}

copy_meta_profile bootstrap
copy_meta_profile _base
[ "${HAS_GPU}" = 1 ] && copy_meta_profile _gpu
for lname in ${LAYER_NAMES:-}; do
  copy_meta_profile "_layer-${lname}"
done
while IFS= read -r p; do
  [ -z "$p" ] && continue
  copy_meta_profile "$p"
done < "${STAGE_IN}/selected.txt"

# _meta.json with the profile dep graph (read at runtime by nix-activate).
jq '
  .profiles
  | to_entries
  | map({
      key: .key,
      value: {
        ref:      (.value.ref      // null),
        requires: (.value.requires // [])
      }
    })
  | from_entries
  | {profiles: .}
' "${STAGE_IN}/profiles.json" \
  > "${STAGE_IN}/layers/meta/var/nix/profiles/_meta.json"

# ── 10. emit Dockerfile ────────────────────────────────────────────────
# Image content lands at /store and /var (root paths, NOT /nix/store).
# Consumers mount this image at /nix via `--mount type=image,
# destination=/nix`, which puts image's /store at the consumer's
# /nix/store. If we built with /nix/store inside the image, the mount
# would nest as /nix/nix/store — wrong.
#
# Internal references inside store paths (e.g. shebangs pointing at
# /nix/store/<hash>-bash) are unaffected: they're absolute paths
# correct at runtime once the volume is mounted at /nix.
{
  echo "FROM scratch"
  echo "COPY base/store /store"
  for lname in ${LAYER_NAMES:-}; do
    echo "COPY layer-${lname}/store /store"
  done
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    echo "COPY profile-${p}/store /store"
  done < "${STAGE_IN}/selected.txt"
  echo "COPY meta/var /var"
} > "${STAGE_IN}/layers/Dockerfile"

# ── 10b. provenance manifest → labels.json ─────────────────────────────
# Consumed by nix-crane-assemble to stamp OCI labels onto the fat store and
# every per-app image. apps: only profiles that actually built (APPLABELS).
# profileRefs: apps whose ref differs from base (the decoupled-cadence set).
apps_json="$(jq -R -s '
    split("\n") | map(select(length > 0) | split("\t"))
    | map({key: .[0], value: {
        ref: .[1], rev: .[2], storePath: .[3], version: (.[4] // "")
      }}) | from_entries
  ' "${APPLABELS}")"
jq -n \
  --arg baseRef "${BASE_REF_ORIG}" \
  --arg baseRev "${BASE_REV}" \
  --arg arch    "${TARGET_ARCH}" \
  --argjson apps "${apps_json}" \
  '{
     base: {ref: $baseRef, rev: $baseRev, arch: $arch},
     apps: $apps,
     profileRefs: ($apps | to_entries
        | map(select(.value.ref != $baseRef))
        | map({key: .key, value: {ref: .value.ref, rev: .value.rev}})
        | from_entries)
   }' > "${STAGE_IN}/layers/labels.json"
echo "[inner] wrote labels.json (base ${BASE_REV:-<unresolved>}, $(jq '.apps|length' "${STAGE_IN}/layers/labels.json") apps)" >&2

# jq-free sidecars for the OUTER crane-assemble (its podman/stable env has no
# jq). labels.env is source-safe (single-quoted; nixpkgs refs/revs and jq's
# compact JSON contain no single quotes); applabels.tsv is read with awk.
{
  printf "BASE_REF='%s'\n"     "${BASE_REF_ORIG}"
  printf "BASE_REV='%s'\n"     "${BASE_REV}"
  printf "PROFILE_REFS='%s'\n" "$(jq -c '.profileRefs // {}' "${STAGE_IN}/layers/labels.json")"
} > "${STAGE_IN}/layers/labels.env"
cp "${APPLABELS}" "${STAGE_IN}/layers/applabels.tsv" 2>/dev/null \
  || : > "${STAGE_IN}/layers/applabels.tsv"

# ── 10c. build-side report sidecars → /output (host-visible) ────────────
# Surface labels.json and a closure diff vs the PREVIOUS build to the persistent
# output dir, so the publish stage can fold them into nix-build-report.json.
# Fully isolated (subshell + set +e): a diff hiccup must never fail the build.
( set +e
  [ -d "${OUTPUT_IN}" ] || exit 0
  cp "${STAGE_IN}/layers/labels.json" "${OUTPUT_IN}/labels.json" 2>/dev/null

  PREV="${OUTPUT_IN}/labels.prev.json"
  # Flat TSV (app\tstatus\tprev\tnew\tdetail) — the publish stage reads this with
  # awk (no jq), plus the JSON form below for jq consumers.
  TMP="${OUTPUT_IN}/closure-diffs.tsv"; : > "${TMP}"
  TAB="$(printf '\t')"
  if [ -f "${PREV}" ]; then
    jq -r '.apps | to_entries[] | "\(.key)\t\(.value.storePath)"' \
        "${OUTPUT_IN}/labels.json" 2>/dev/null \
    | while IFS="${TAB}" read -r app newsp; do
        [ -n "${newsp}" ] || continue
        prevsp="$(jq -r --arg a "$app" '.apps[$a].storePath // ""' "${PREV}" 2>/dev/null)"
        if   [ -z "${prevsp}" ];        then st="new";       detail=""
        elif [ "${prevsp}" = "${newsp}" ]; then st="unchanged"; detail=""
        elif nix --extra-experimental-features 'nix-command flakes' \
                 path-info "${prevsp}" >/dev/null 2>&1; then
          st="changed"
          # diff-closures lists per-package version/size deltas — the "which
          # packages changed" answer. Flatten to one line ("; "-joined) for TSV/
          # JSON transport: strip tabs (they are the TSV column separator) and
          # per-line indent, then join with awk (paste -d cycles a char list).
          detail="$(nix --extra-experimental-features 'nix-command flakes' \
                      store diff-closures "${prevsp}" "${newsp}" 2>/dev/null \
                    | tr '\t' ' ' | sed 's/^[[:space:]]*//' \
                    | awk 'NR>1{printf "; "}{printf "%s",$0}END{if(NR)print ""}')"
        else
          st="changed"; detail="prev closure not in store — diff skipped"
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$app" "$st" "$prevsp" "$newsp" "$detail" >> "${TMP}"
      done
  fi
  jq -R -s '
      split("\n") | map(select(length > 0) | split("\t"))
      | map({key: .[0], value: {
          status: .[1], prevStorePath: .[2], newStorePath: .[3], detail: (.[4] // "")
        }}) | from_entries
    ' "${TMP}" > "${OUTPUT_IN}/closure-diffs.json" 2>/dev/null
  cp "${OUTPUT_IN}/labels.json" "${PREV}" 2>/dev/null   # rotate for next run
  echo "[inner] wrote closure-diffs.json + rotated labels.prev.json" >&2
) || true

# ── 11. (no in-container image build) ─────────────────────────────────
# The fat-store Dockerfile is staged at ${STAGE_IN}/layers/Dockerfile. The
# OUTER podman builds it directly into its overlay store from this staging
# dir (the named volume's mountpoint) — copy-on-write, layer cache, no tar.
echo "[inner] fat-store Dockerfile staged; outer podman will build ${TARGET_TAG}" >&2

# ── 11b. per-app Dockerfiles + thin meta (optional) ────────────────────
# Stage one Dockerfile per selected profile, FROM the nix-ubuntu base. Each
# image's store content is split across *discrete* COPY instructions — base
# layer, the shared layers the app actually uses, each required profile's
# delta, then the app's own delta. With overlay + the outer's layer cache,
# the identical base/shared COPY layers are built once and reused across every
# app (no per-app recopy), and dedupe registry-wide on push. Wiring is added
# afterwards by the finish build; here we only stage the store COPYs + a thin
# meta layer (profile symlinks + subset _meta.json, no sqlite db — see
# nix-activate's optional-db handling).
if [ "${EMIT_APP_IMAGES:-0}" = "1" ]; then
  echo "[inner] staging per-app Dockerfiles" >&2
  cd "${STAGE_IN}/layers"

  # Transitive `requires` closure for a profile (POSIX fixed-point).
  expand_requires() {
    current="$*"; prev=""
    while [ "$prev" != "$current" ]; do
      prev="$current"
      for rp in $current; do
        deps="$(jq -r --arg p "$rp" '.profiles[$p].requires[]? // empty' \
                   "${STAGE_IN}/profiles.json" 2>/dev/null)"
        for d in $deps; do
          case " $current " in *" $d "*) ;; *) current="$current $d" ;; esac
        done
      done
    done
    printf '%s' "$current"
  }

  # cp a profile symlink + its generation -links into a thin meta dir.
  copy_app_profile() {
    name="$1"; destprof="$2"
    src="${KASM_PROFILE_DIR}/${name}"
    if [ -e "${src}" ] || [ -L "${src}" ]; then
      cp -a "${src}" "${destprof}/${name}"
    fi
    for link in "${KASM_PROFILE_DIR}/${name}-"*-link; do
      if [ -e "${link}" ] || [ -L "${link}" ]; then
        cp -a "${link}" "${destprof}/$(basename "${link}")"
      fi
    done
  }

  while IFS= read -r P; do
    [ -z "$P" ] && continue
    echo "[inner] === app image: ${P} ===" >&2

    # 1. transitive requires, restricted to profiles we actually built.
    reqs_all="$(expand_requires "$P")"
    reqs=""              # requires only (excludes P), built ones only
    for r in $reqs_all; do
      [ "$r" = "$P" ] && continue
      if [ -d "${STAGE_IN}/layers/profile-${r}/store" ] && \
         [ -f "${STAGE_IN}/closures/${r}.txt" ]; then
        reqs="${reqs} ${r}"
      else
        echo "[inner] WARN ${P}: required profile '${r}' not in build set — its store will be MISSING from the image (add it to the build, or --profile ${r})" >&2
      fi
    done

    # 2. combined closure (app + built requires) → drives layer selection.
    img_closure="${STAGE_IN}/closures/${P}.image.txt"
    {
      cat "${STAGE_IN}/closures/${P}.txt"
      for r in $reqs; do cat "${STAGE_IN}/closures/${r}.txt"; done
    } | sort -u > "${img_closure}"

    # 3. shared layers this image actually uses (delta intersects closure).
    used_layers=""
    for lname in ${LAYER_NAMES:-}; do
      ldelta="${STAGE_IN}/closures/_layer-${lname}-delta.txt"
      [ -s "${ldelta}" ] || continue
      if comm -12 "${ldelta}" "${img_closure}" | grep -q .; then
        used_layers="${used_layers} ${lname}"
      fi
    done
    echo "[inner] ${P}: requires=[${reqs# }] layers=[${used_layers# }]" >&2

    # 4. thin per-app meta dir (profile symlinks + subset _meta.json).
    appmeta="appmeta-${P}"
    rm -rf "${appmeta}"
    mkdir -p "${appmeta}/var/nix/profiles"
    copy_app_profile bootstrap "${appmeta}/var/nix/profiles"
    # _gpu profile symlink: its store paths already ship in the base layer (folded
    # into base_set), but nix-gpu-run resolves vglrun via the /nix/var/nix/profiles/_gpu
    # symlink — without it every per-app image silently falls back to software even
    # when a GPU is allocated. Deliberately NOT added to _meta.json (not activatable).
    [ "${HAS_GPU:-0}" = 1 ] && copy_app_profile _gpu "${appmeta}/var/nix/profiles"
    copy_app_profile "$P"      "${appmeta}/var/nix/profiles"
    for r in $reqs; do copy_app_profile "$r" "${appmeta}/var/nix/profiles"; done

    keep_names="$P${reqs}"
    sel_json="$(printf '%s\n' $keep_names | jq -R . | jq -s .)"
    jq --argjson sel "$sel_json" '
      .profiles
      | to_entries
      | map(select(.key as $k | $sel | index($k)))
      | map({key: .key,
             value: {ref: (.value.ref // null), requires: (.value.requires // [])}})
      | from_entries
      | {profiles: .}
    ' "${STAGE_IN}/profiles.json" \
      > "${appmeta}/var/nix/profiles/_meta.json"

    # 5. per-app Dockerfile — discrete COPYs preserve cross-app dedup.
    appdf="Dockerfile.${P}"
    {
      echo "FROM ${APP_BASE_REF}"
      echo "USER 0"
      # Store lands at /store (root), NOT /nix/store — the SAME source dirs and
      # destination the fat-store Dockerfile uses, so these COPY layers are
      # byte-identical to the fat store's and dedupe by blob digest (see
      # design/nix-delivery-model.md). A /nix/store -> /store symlink keeps the
      # image self-contained (runs with no /nix mount).
      echo "COPY base/store /store"
      for lname in $used_layers; do
        echo "COPY layer-${lname}/store /store"
      done
      for r in $reqs; do
        echo "COPY profile-${r}/store /store"
      done
      echo "COPY profile-${P}/store /store"
      echo "COPY ${appmeta}/var /var"
      # Point /nix/store and /nix/var at the /store-layout roots. Replace only
      # these entries; never wipe /nix (the base may bootstrap from it).
      echo "RUN rm -rf /nix/store /nix/var 2>/dev/null || true; mkdir -p /nix && ln -sfn /store /nix/store && ln -sfn /var /nix/var"
      echo "ENV NIX_APP_PROFILES=${P}"
    } > "${appdf}"
    echo "[inner] ${P}: staged ${appdf}" >&2
  done < "${STAGE_IN}/selected.txt"

  # App list for the outer build loop (profiles that have a staged Dockerfile).
  cp "${STAGE_IN}/selected.txt" "${STAGE_IN}/layers/apps.txt"
fi

# ── 12. prune stale gcroots + GC unreachable store paths ──────────────
# Profiles removed from the config still have gcroots pinning their
# closures from prior runs; unlink them so nix-collect-garbage can
# reclaim the space. Then -d removes old profile generations too
# (every ref bump on a profile leaves the previous closure around).
#
# gcroots/ shares the dir with bundled entries from the seeded volume
# (e.g. the `profiles` indirect gcroot pointing at /nix/var/nix/profiles,
# plus `auto/`). Only act on plain symlinks that resolve into our
# profile dir and don't match a name we still want to keep.
echo "[inner] pruning stale gcroots" >&2
for gr in "${KASM_GCROOT_DIR}"/*; do
  [ -L "$gr" ] || continue
  target="$(readlink "$gr")"
  case "$target" in
    "${KASM_PROFILE_DIR}"/*) ;;
    *) continue ;;
  esac
  name="$(basename "$gr")"
  case "$name" in
    bootstrap|_base|.helpers|default) continue ;;
  esac
  case "$name" in
    _layer-*)
      lname="${name#_layer-}"
      if jq -e --arg l "$lname" '(.layers // {})[$l] != null' \
          "${STAGE_IN}/profiles.json" >/dev/null 2>&1; then
        continue
      fi
      echo "  prune gcroot: $name (layer removed from config)" >&2
      rm -f "$gr" "${KASM_PROFILE_DIR}/${name}" "${KASM_PROFILE_DIR}/${name}-"*-link
      continue ;;
  esac
  if ! grep -qxF "$name" "${STAGE_IN}/selected.txt"; then
    echo "  prune gcroot: $name (not in current config)" >&2
    rm -f "$gr" "${KASM_PROFILE_DIR}/${name}" "${KASM_PROFILE_DIR}/${name}-"*-link
  fi
done

# nix-collect-garbage WITHOUT -d: only remove paths unreachable from
# any gcroot. -d would also delete "old generations" of every profile
# and has been observed to nuke the image's default profile
# (default-1-link) when /nix/var/nix/gcroots/profiles isn't preserved
# from the seed — wedging the volume. The non-destructive form is
# enough for our use case: stale profile generations from prior
# config diffs accumulate slowly and a periodic --prune-stage handles
# them.
echo "[inner] running nix-collect-garbage (removes unreachable paths only)" >&2
nix-collect-garbage 2>&1 | tail -3

echo "[inner] complete; context.tar ready for outer build" >&2
INNER

chmod +x "${INNER_SCRIPT}"

# ───── Inner build run ─────────────────────────────────────────────────
# Build the ONLY_PROFILES env var (CSV) if the user asked for a subset.
ONLY_CSV=""
if [[ ${#ONLY_PROFILES[@]} -gt 0 ]]; then
  ONLY_CSV="$(IFS=, ; echo "${ONLY_PROFILES[*]}")"
fi

# ───── Per-app: the base image is built FROM directly by the outer podman ──
# No docker-archive hand-off anymore — the outer builds per-app images in its
# own overlay store, so the base just needs to be present here.
if [[ "${EMIT_APP_IMAGES}" == 1 ]]; then
  if ! "${CONTAINER_CLI}" image exists "${APP_BASE_IMAGE}" 2>/dev/null \
     && ! "${CONTAINER_CLI}" image inspect "${APP_BASE_IMAGE}" >/dev/null 2>&1; then
    fail "--emit-app-images: base image not found in ${CONTAINER_CLI} store: ${APP_BASE_IMAGE} (load/build nix-ubuntu first)"
  fi
fi

log "[1/3] running nix build inside ${NIX_IMAGE_DEFAULT}"
log "  (named volume ${STAGE_VOLUME} caches between runs — first run is slow)"
# Same `:z` here as on the seed step — keeps the SELinux label
# consistent across runs so the inner container can read what the seed
# wrote (and any prior inner build wrote).
inner_run_args=(
    run --rm
    --platform "${PLATFORM}"
    --volume "${STAGE_VOLUME}:/nix:rw,z"
    --volume "${CONFIG_FILE}:/config/profiles.toml:ro"
    --volume "${OUTPUT_DIR}:/output:rw"
    --volume "${INNER_SCRIPT}:/inner-build.sh:ro"
    -e "ONLY_PROFILES=${ONLY_CSV}"
    -e "TARGET_ARCH=${ARCH}"
    -e "TARGET_TAG=${TAG}"
    -e "EMIT_APP_IMAGES=${EMIT_APP_IMAGES}"
    -e "APP_REPO=${APP_REPO}"
    -e "APP_TAG=${APP_TAG}"
    -e "APP_BASE_REF=${APP_BASE_IMAGE}"
)
# Mount the GPU overlay flake (trimmed VirtualGL) so a [gpu] profile entry can
# reference it as `path:/config/gpu-overlay#…`. Pinned to the same nixpkgs rev as
# the build (see bin/nix-gpu-overlay + design/nix-dedup-gap.md). Optional: absent
# dir → not mounted (a [gpu] path: entry would then fail, which is intended).
[[ -d "${SCRIPT_DIR}/nix-gpu-overlay" ]] && \
  inner_run_args+=( --volume "${SCRIPT_DIR}/nix-gpu-overlay:/config/gpu-overlay:ro" )
# Mount the steam overlay flake (VirtualGL + steam-run in steam's FHS, so the
# launcher can `steam-run vglrun steam` — see bin/nix-steam-overlay and
# src/ubuntu/install/nix/steam/launch). Referenced by [profiles.steam] as
# `path:/config/steam-overlay#steam-vgl`. Same nixpkgs pin as the base so the
# faker's glibc matches the FHS. Optional: absent dir → not mounted.
[[ -d "${SCRIPT_DIR}/nix-steam-overlay" ]] && \
  inner_run_args+=( --volume "${SCRIPT_DIR}/nix-steam-overlay:/config/steam-overlay:ro" )
inner_run_args+=( --entrypoint /bin/sh "${NIX_IMAGE_DEFAULT}" /inner-build.sh )

"${CONTAINER_CLI}" "${inner_run_args[@]}"

# ───── Build images directly into the outer overlay store from staging ──
# The inner build staged the layer tree + Dockerfiles under .build/layers in
# the named volume. We build with the OUTER podman so everything lands in its
# overlay store: copy-on-write + a layer cache SHARED across every per-app
# build, so the identical base/shared `COPY` layers are materialised once and
# reused — no per-app recopy, no docker-archive tar round-trip.
STAGING="$("${CONTAINER_CLI}" volume inspect "${STAGE_VOLUME}" --format '{{ .Mountpoint }}')/.build/layers"
[[ -d "${STAGING}" ]] || fail "inner build staged nothing at ${STAGING}"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Content-addressed assembly (crane + deterministic tars): the fat store and
# every per-app image share store layers by blob digest — across apps, the fat
# store, and distro bases. Fat store stays mountable (/store); per-app images
# are self-contained (/nix/store->/store symlink) with runtime wiring. Replaces
# the non-reproducible podman COPY build. See design/nix-delivery-model.md.
log "[2/3] assembling images (crane, content-addressed) from ${STAGING}"
asm_env=(
  "STAGING=${STAGING}" "REPO_ROOT=${REPO_ROOT}"
  "FAT_TAG=${TAG}" "APP_REPO=${APP_REPO}" "APP_TAG=${APP_TAG}"
  "CONTAINER_CLI=${CONTAINER_CLI}" "ARCH=${ARCH}" "BUILD_PARALLEL=${BUILD_PARALLEL:-}"
)
[[ "${EMIT_APP_IMAGES}" == 1 ]] && asm_env+=( "APP_BASE_IMAGE=${APP_BASE_IMAGE}" )
[[ -n "${PUSH_REGISTRY}" ]] && asm_env+=( "PUSH_REGISTRY=${PUSH_REGISTRY}" )
env "${asm_env[@]}" bash "${SCRIPT_DIR}/nix-crane-assemble"


# ───── Optional volume prune ───────────────────────────────────────────
if [[ "${PRUNE_STAGE}" == 1 ]]; then
  log "removing named volume ${STAGE_VOLUME}"
  "${CONTAINER_CLI}" volume rm "${STAGE_VOLUME}" >/dev/null
fi

log "done: ${TAG}"
log "to inspect layers:"
log "  ${CONTAINER_CLI} image inspect ${TAG} | grep RootFS -A 20"
if [[ "${EMIT_APP_IMAGES}" == 1 ]]; then
  log "per-app images assembled via crane (${APP_REPO}-<app>:${APP_TAG});"
  log "  see the 'per-app: ok=… failed=…' line above for each result."
fi
