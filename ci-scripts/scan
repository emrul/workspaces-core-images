#!/bin/bash

set -eo pipefail

build_report() {
  set +e
  $trivy_cmd --exit-code 0 --format template --template "@/$trivy_dir/contrib/junit.tpl" -o "$report_xml" $scan_target
  RESULT=$?
  set -e
  if [ $RESULT -ne 0 ]; then
    echo "Trivy command failed with default db, falling back to using ECR vuln db"
    $trivy_cmd --db-repository public.ecr.aws/aquasecurity/trivy-db:2 --java-db-repository public.ecr.aws/aquasecurity/trivy-java-db:1 --exit-code 0 --format template --template "@/$trivy_dir/contrib/junit.tpl" -o "$report_xml" $scan_target
  fi
  # Human-readable CVE table in the job log (report-only; never fails the job) —
  # the JUnit XML feeds the Tests tab, this makes findings glanceable in stdout.
  $trivy_cmd --exit-code 0 --format table $scan_target || true
  #$trivy_cmd --exit-code 0 --format json -o "$source_dir/report.json" $scan_target
}

print_report_and_fail_on_vulnerabilities() {
  $trivy_cmd --exit-code 1 "$target"
}

scan_cmd="$1"
target="$2"
if [[ -z "$scan_cmd" || -z "$target" ]]; then
  echo >&2 "Usage: $(basename "$0") <repo|image> <target>"
  exit 1
fi

case "$scan_cmd" in
  repo) options="--scanners config,secret,vuln" ;;
  image) options="--scanners vuln --timeout 10m" ;;
  *) options="--scanners vuln,config,secret" ;;
esac

set -u
set -x

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
# TRIVY_HOME: trivy binary location (writable dir when SCRIPT_DIR is read-only).
trivy_dir="${TRIVY_HOME:-${SCRIPT_DIR}/trivy}"
trivy_cmd="$trivy_dir/trivy $scan_cmd --no-progress --ignore-status will_not_fix,fix_deferred --ignore-policy ${SCRIPT_DIR}/vulnerability-filter.rego --cache-dir $HOME/.trivycache $options" #--ignore-unfixed --severity HIGH,CRITICAL,MEDIUM
source_dir="${CI_PROJECT_DIR:-$trivy_dir}"
# TRIVY_REPORT: JUnit output path (override to keep per-target reports distinct).
report_xml="${TRIVY_REPORT:-$source_dir/trivy-report.xml}"
mkdir -p "$(dirname "$report_xml")"
# TRIVY_INPUT: scan a saved image archive (docker/oci tar) instead of a registry
# ref — socket-independent, used by the nix pipeline against its local podman
# store (podman save → tar). $target is then just a display label.
if [ -n "${TRIVY_INPUT:-}" ]; then
  scan_target="--input ${TRIVY_INPUT}"
else
  scan_target="$target"
fi

build_report
#print_report_and_fail_on_vulnerabilities