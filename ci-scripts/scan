#!/bin/bash

set -eo pipefail

build_report() {
  set +e
  $trivy_cmd --exit-code 0 --format template --template "@/$trivy_dir/contrib/junit.tpl" -o "$report_xml" $scan_target
  RESULT=$?
  set -e
  if [ $RESULT -ne 0 ]; then
    echo "Trivy command failed with default db, falling back to using ECR vuln db"
    $trivy_cmd --db-repository public.ecr.aws/aquasecurity/trivy-db:2 --java-db-repository public.ecr.aws/aquasecurity/trivy-java-db:1 --exit-code 0 --format template --template "@/$trivy_dir/contrib/junit.tpl" -o "$report_xml" $scan_target
  fi
  # Human-readable CVE table in the job log (report-only; never fails the job) —
  # the JUnit XML feeds the Tests tab, this makes findings glanceable in stdout.
  $trivy_cmd --exit-code 0 --format table $scan_target || true
  #$trivy_cmd --exit-code 0 --format json -o "$source_dir/report.json" $scan_target
}

print_report_and_fail_on_vulnerabilities() {
  $trivy_cmd --exit-code 1 "$target"
}

scan_cmd="$1"
target="$2"
if [[ -z "$scan_cmd" || -z "$target" ]]; then
  echo >&2 "Usage: $(basename "$0") <repo|image> <target>"
  exit 1
fi

case "$scan_cmd" in
  repo) options="--scanners config,secret,vuln" ;;
  image) options="--scanners vuln --timeout 10m" ;;
  *) options="--scanners vuln,config,secret" ;;
esac

set -u
set -x

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
# TRIVY_HOME: trivy binary location (writable dir when SCRIPT_DIR is read-only).
trivy_dir="${TRIVY_HOME:-${SCRIPT_DIR}/trivy}"
trivy_cmd="$trivy_dir/trivy $scan_cmd --no-progress --ignore-status will_not_fix,fix_deferred --ignore-policy ${SCRIPT_DIR}/vulnerability-filter.rego --cache-dir $HOME/.trivycache $options" #--ignore-unfixed --severity HIGH,CRITICAL,MEDIUM
source_dir="${CI_PROJECT_DIR:-$trivy_dir}"

# SCAN_REPORT_XML: JUnit output path (override to keep per-target reports
# distinct). TRIVY_REPORT is still honoured for callers that predate the rename,
# but it is UNSET before trivy runs, and that unset is the actual fix:
#
# The TRIVY_ prefix is trivy's own env-var namespace — it maps TRIVY_<FLAG> onto
# --<flag>. Setting TRIVY_REPORT as a command prefix therefore leaked it into
# trivy's environment, and once trivy grew a real `--report` flag (granularity:
# all|summary) our unchanged code started dying with
#   FATAL flag error: invalid argument "/artifacts/trivy-report-*.xml"
#   for "--report" flag: must be one of ["all" "summary"]
# scan-base only scans when a base actually rebuilds, so this sat latent until
# the four-distro rebuild on 2026-07-29 (pipeline 2714340414).
#
# Rule this encodes: never name OUR variables with the TRIVY_ prefix. Anything
# there can become a real flag in a future release. TRIVY_INPUT below is the same
# hazard — trivy does have --input, and it happens to mean what we want, so it is
# passed explicitly and unset too rather than relied on by coincidence.
report_xml="${SCAN_REPORT_XML:-${TRIVY_REPORT:-$source_dir/trivy-report.xml}}"
scan_input="${SCAN_INPUT_TAR:-${TRIVY_INPUT:-}}"
# TRIVY_HOME is ours too (where the binary lives). It has no --home flag today,
# but it is exported by nix-scan-base.sh, so unset it here for the same reason —
# trivy_dir above already holds the value.
unset TRIVY_REPORT TRIVY_INPUT TRIVY_HOME
mkdir -p "$(dirname "$report_xml")"
# Scan a saved image archive (docker/oci tar) instead of a registry ref —
# socket-independent, used by the nix pipeline against its local podman store
# (podman save → tar). $target is then just a display label.
if [ -n "${scan_input}" ]; then
  scan_target="--input ${scan_input}"
else
  scan_target="$target"
fi

build_report
#print_report_and_fail_on_vulnerabilities