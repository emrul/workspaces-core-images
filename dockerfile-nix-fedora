# nix-fedora: fedora core + Nix activation hooks.
#
# Fedora sibling of dockerfile-nix-ubuntu. Like it, this image does NOT
# install Nix — it expects the OCI fat-store image built by
# bin/build-nix-store-volume to be mounted read-only at /nix at run time
# (the store is glibc/x86_64 and distro-independent, so the SAME
# nix-store image works here as on ubuntu). Boot-time activation reads
# NIX_APP_PROFILES / the launch-form file; per-user overrides live at
# $HOME/.config/nix-app/active.
#
# The nix-activate/nix-launch/nix-gpu-* scripts are distro-agnostic
# (POSIX sh, glibc), so they are shared from src/ubuntu/install/nix.
# Fedora differences vs ubuntu: the base image, and the system-wide
# interactive bashrc path (/etc/bashrc, not Debian's /etc/bash.bashrc).
#
# BASE_IMAGE must be a container-init-based fedora core from THIS fork
# (dockerfile-kasm-core-fedora) — we drop a unit into
# /etc/container-init.d/, which only exists in container-init images.
#
# See design/nix-package-process.md and dockerfile-nix-ubuntu.

ARG BASE_IMAGE="localhost/kasm-core-fedora:dev"
FROM $BASE_IMAGE

ARG DISTRO=fedora42
USER 0

# nix-launch execs nix-bwrap-run for every app, and buildFHSEnv apps (onlyoffice,
# steam, …) need a real /usr/bin/bwrap to get a real /nix/store under the
# /nix/store->/store symlink layout. Normally inherited from the core base as a
# desktop dependency; self-heal if a future base drops it. No-op when present.
RUN command -v bwrap >/dev/null 2>&1 || { dnf install -y bubblewrap && dnf clean all; }

# Drop-in unit + scripts (shared with ubuntu). The supervisor scans
# /etc/container-init.d/ for additive units; ours is gated by
# ConditionPathIsDirectory so the image still boots without /nix mounted.
COPY src/ubuntu/install/nix/units/nix-activate.service \
     src/ubuntu/install/nix/units/nix-gpu-setup.service \
     src/ubuntu/install/nix/units/accessibility.service \
     src/ubuntu/install/nix/units/kasm-session-runtime.service \
     /etc/container-init.d/
# Same public S3 mirror pkgs/kasm-session-runtime/pin.json fetches for the
# nix package -- pull needs no GitLab auth at all, unlike the private
# project's own container registry (dropped after that needed
# cross-project CI_JOB_TOKEN wiring this build tooling doesn't have).
ARG RUNTIME_COMMIT="806f812a1bf96bdc26dd655c3eaa00cfe4a29462"
ARG RUNTIME_BRANCH="v0.2.96-rc.1"
ARG RUNTIME_SHORT="806f81"
ARG TARGETARCH
ADD https://kasm-labs-sandbox.s3.eu-north-1.amazonaws.com/kasm_session_runtime/${RUNTIME_COMMIT}/kasm-session-runtime-linux-${TARGETARCH}.${RUNTIME_BRANCH}.${RUNTIME_SHORT} /usr/local/bin/kasm-session-runtime
RUN chmod 0755 /usr/local/bin/kasm-session-runtime
# The runtime's in-session sidebar, same release, same S3 prefix, fetched the
# same way (pkgs/kasm-ai-runtime-sidebar/pin.json is the nix-side pin of the
# same object). Plain files under /usr/local/share/kasm-ai-runtime-sidebar;
# kasm-setup builds a second KasmVNC web root from them only when a session
# sets KASM_VNC_PATH=/usr/share/kasmvnc-agent. Inert otherwise. Remote ADD
# never unpacks, hence the explicit tar.
ADD https://kasm-labs-sandbox.s3.eu-north-1.amazonaws.com/kasm_session_runtime/${RUNTIME_COMMIT}/kasm-ai-runtime-sidebar.tar.gz.${RUNTIME_BRANCH}.${RUNTIME_SHORT} /tmp/kasm-ai-runtime-sidebar.tgz
RUN mkdir -p /usr/local/share \
 && tar -xzf /tmp/kasm-ai-runtime-sidebar.tgz -C /usr/local/share \
 && chmod 0755 /usr/local/share/kasm-ai-runtime-sidebar/install.sh \
 && chmod 0644 /usr/local/share/kasm-ai-runtime-sidebar/sidebar.js /usr/local/share/kasm-ai-runtime-sidebar/sidebar.css \
 && rm -f /tmp/kasm-ai-runtime-sidebar.tgz
COPY src/ubuntu/install/nix/scripts/nix-activate \
     src/ubuntu/install/nix/scripts/nix-app \
     src/ubuntu/install/nix/scripts/nix-launch \
     src/ubuntu/install/nix/scripts/nix-bwrap-run \
     src/ubuntu/install/nix/scripts/nix-gpu-run \
     src/ubuntu/install/nix/scripts/nix-gpu-setup \
     src/ubuntu/install/nix/scripts/nix-gpu-app-launch \
     src/ubuntu/install/nix/scripts/accessibility-enable \
     /usr/local/bin/

RUN chmod 0755 /usr/local/bin/nix-activate /usr/local/bin/nix-app /usr/local/bin/nix-launch /usr/local/bin/nix-bwrap-run /usr/local/bin/nix-gpu-run /usr/local/bin/nix-gpu-setup /usr/local/bin/nix-gpu-app-launch /usr/local/bin/accessibility-enable && \
    /usr/local/bin/container-init \
        --units /etc/container-init/units \
        --drop-in /etc/container-init.d \
        --strict-units --validate

# Fedora's system-wide interactive bashrc is /etc/bashrc (Debian uses
# /etc/bash.bashrc). Source our generated /etc/profile.d/nix-app.sh from
# it so PATH and XDG_DATA_DIRS are visible in every terminal, not just
# login shells. The `[ -f ]` guard makes this a no-op with no /nix mount.
RUN { \
      echo ''; \
      echo '# nix-app: ensure interactive shells see the activated profiles.'; \
      echo '[ -f /etc/profile.d/nix-app.sh ] && . /etc/profile.d/nix-app.sh'; \
    } >> /etc/bashrc
