# CI fixture: layers /etc/container-init.d/ drop-ins exercising every
# documented worked example onto the production-probe image, asserting
# the supervisor wires each pattern correctly.
FROM kasm-prod-probe:latest
USER 0

# Drop-in unit files — patterns 1..5 from the upstream container-init
# README at https://github.com/emrul/container-init#worked-examples.
RUN mkdir -p /etc/container-init.d /usr/local/bin
COPY dropins/ /etc/container-init.d/
COPY scripts/ /usr/local/bin/

RUN chmod +x /usr/local/bin/myimage-init \
              /usr/local/bin/myimage-app \
              /usr/local/bin/myhelper \
              /usr/local/bin/dbus-system-stub
