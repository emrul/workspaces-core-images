# nix-ubuntu-resolute — the resolute runtime base, Kasm services provided by Nix
# under the MULTI-STORE model (design/nix-workspace-as-code.md).
#
# The resolute core (dockerfile-kasm-core-ubuntu-resolute) is built with
# INCLUDE_KASMVNC/PROFILE_SYNC/AUDIO_INPUT/RECORDER/WEBCAM/GAMEPAD=0 — Kasm ships
# no per-distro artifacts for 26.04 — so those services come from Nix instead.
#
# This finish build BAKES the Nix service closure as ONE store at
# /nix-stores/services (staged by bin/nix-bake-closure --store-id services). At
# boot, nix-compose.service unions that baked store with any fat store mounted at
# /nix-stores/base into a single /nix/store symlink farm, so:
#   • services run standalone (the baked store is always present), and
#   • apps appear when a fat store is mounted (the select-apps desktop).
#
# Service binaries are symlinked to their path inside the BAKED store
# (/nix-stores/services/store/<hash>) — a real path at build/parse time, so the
# units' ConditionPathExists pass — while each binary's baked interpreter/RUNPATH
# (/nix/store/<hash>) is resolved at exec by the farm nix-compose builds first
# (nix-compose.service is ordered Before these service units).
ARG BASE_IMAGE="localhost/kasm-core-ubuntu-resolute:dev"
FROM $BASE_IMAGE

ARG DISTRO=ubuntu
USER 0

# Store out-paths (/nix/store/<hash>-…) of each baked service, from the build
# helper. The staged location is /nix-stores/services/store/<basename>; the wiring
# below derives it from the basename.
ARG KASMVNC_STORE_PATH
ARG PROFILE_SYNC_STORE_PATH
ARG AUDIO_INPUT_STORE_PATH
ARG RECORDER_STORE_PATH
ARG WEBCAM_STORE_PATH
ARG GAMEPAD_STORE_PATH
ARG JQ_STORE_PATH

# ── Nix activation hooks (lockstep with dockerfile-nix-ubuntu + nix-compose) ──
# nix-bwrap-run needs a real /usr/bin/bwrap for buildFHSEnv apps; self-heal if a
# future base drops it (no-op when present).
RUN command -v bwrap >/dev/null 2>&1 || { \
        apt-get update && \
        apt-get install -y --no-install-recommends bubblewrap && \
        rm -rf /var/lib/apt/lists/*; }

COPY src/ubuntu/install/nix/units/nix-compose.service \
     src/ubuntu/install/nix/units/nix-activate.service \
     src/ubuntu/install/nix/units/nix-gpu-setup.service \
     src/ubuntu/install/nix/units/accessibility.service \
     src/ubuntu/install/nix/units/kasm-session-runtime.service \
     /etc/container-init.d/
# Same public S3 mirror pkgs/kasm-session-runtime/pin.json fetches for the
# nix package -- pull needs no GitLab auth at all, unlike the private
# project's own container registry (dropped after that needed
# cross-project CI_JOB_TOKEN wiring this build tooling doesn't have).
ARG RUNTIME_COMMIT="5ad5aacc2b546c090c7586ff83dbe3d30a1d8e7a"
ARG RUNTIME_BRANCH="v0.2.86-rc.1"
ARG RUNTIME_SHORT="5ad5aa"
ARG TARGETARCH
ADD https://kasm-labs-sandbox.s3.eu-north-1.amazonaws.com/kasm_session_runtime/${RUNTIME_COMMIT}/kasm-session-runtime-linux-${TARGETARCH}.${RUNTIME_BRANCH}.${RUNTIME_SHORT} /usr/local/bin/kasm-session-runtime
RUN chmod 0755 /usr/local/bin/kasm-session-runtime
# The runtime's in-session sidebar, same release, same S3 prefix, fetched the
# same way (pkgs/kasm-ai-runtime-sidebar/pin.json is the nix-side pin of the
# same object). Plain files under /usr/local/share/kasm-ai-runtime-sidebar;
# kasm-setup builds a second KasmVNC web root from them only when a session
# sets KASM_VNC_PATH=/usr/share/kasmvnc-agent. Inert otherwise. Remote ADD
# never unpacks, hence the explicit tar.
ADD https://kasm-labs-sandbox.s3.eu-north-1.amazonaws.com/kasm_session_runtime/${RUNTIME_COMMIT}/kasm-ai-runtime-sidebar.tar.gz.${RUNTIME_BRANCH}.${RUNTIME_SHORT} /tmp/kasm-ai-runtime-sidebar.tgz
RUN mkdir -p /usr/local/share \
 && tar -xzf /tmp/kasm-ai-runtime-sidebar.tgz -C /usr/local/share \
 && chmod 0755 /usr/local/share/kasm-ai-runtime-sidebar/install.sh \
 && chmod 0644 /usr/local/share/kasm-ai-runtime-sidebar/sidebar.js /usr/local/share/kasm-ai-runtime-sidebar/sidebar.css \
 && rm -f /tmp/kasm-ai-runtime-sidebar.tgz
COPY src/ubuntu/install/nix/scripts/nix-compose \
     src/ubuntu/install/nix/scripts/nix-activate \
     src/ubuntu/install/nix/scripts/nix-app \
     src/ubuntu/install/nix/scripts/nix-launch \
     src/ubuntu/install/nix/scripts/nix-bwrap-run \
     src/ubuntu/install/nix/scripts/nix-gpu-run \
     src/ubuntu/install/nix/scripts/nix-gpu-setup \
     src/ubuntu/install/nix/scripts/accessibility-enable \
     /usr/local/bin/
RUN chmod 0755 /usr/local/bin/nix-compose /usr/local/bin/nix-activate \
        /usr/local/bin/nix-app /usr/local/bin/nix-launch /usr/local/bin/nix-bwrap-run \
        /usr/local/bin/nix-gpu-run /usr/local/bin/nix-gpu-setup \
        /usr/local/bin/accessibility-enable && \
    /usr/local/bin/container-init \
        --units /etc/container-init/units \
        --drop-in /etc/container-init.d \
        --strict-units --validate
RUN { \
      echo ''; \
      echo '# nix-app: ensure interactive shells see the activated profiles.'; \
      echo '[ -f /etc/profile.d/nix-app.sh ] && . /etc/profile.d/nix-app.sh'; \
    } >> /etc/bash.bashrc

# ── Baked service store (one of the stores nix-compose unions into /nix) ──
COPY nix-stores/services/store /nix-stores/services/store

# ── Wire the services from the baked store ──
# Symlinks target /nix-stores/services/store/<hash> (real now); nix-compose builds
# the /nix/store farm at boot so the binaries' interpreters resolve at exec.
RUN set -eu; \
    svc=/nix-stores/services/store; \
    kv="${svc}/$(basename "${KASMVNC_STORE_PATH}")"; \
    test -x "${kv}/bin/Xkasmvnc" || { echo "KASMVNC store missing at ${kv}"; exit 1; }; \
    ln -sf "${kv}/bin/Xkasmvnc" /usr/bin/Xkasmvnc; \
    ln -sf "${kv}/bin/Xkasmvnc" /usr/bin/Xvnc; \
    for b in kasmvncserver kasmvncconfig kasmvncpasswd kasmxproxy; do \
        [ -e "${kv}/bin/${b}" ] && ln -sf "${kv}/bin/${b}" "/usr/bin/${b}"; \
    done; \
    # KasmVNC web assets + libs → writable copies (boot adds www/Downloads).
    rm -rf /usr/share/kasmvnc; cp -a "${kv}/share/kasmvnc" /usr/share/kasmvnc; \
    [ -d "${kv}/lib/kasmvncserver" ] && { rm -rf /usr/lib/kasmvncserver; cp -a "${kv}/lib/kasmvncserver" /usr/lib/kasmvncserver; } || true; \
    mkdir -p /usr/share/kasmvnc/www/Downloads; \
    chown -R 0:0 /usr/share/kasmvnc; chmod -R og-w /usr/share/kasmvnc; \
    ln -sf /home/kasm-user/Downloads /usr/share/kasmvnc/www/Downloads/Downloads; \
    chown -R 1000:0 /usr/share/kasmvnc/www/Downloads; \
    mkdir -p /etc/kasm; \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout /etc/kasm/self-default.pem -out /etc/kasm/self-default.pem \
        -subj "/C=US/ST=VA/L=None/O=None/OU=DoFu/CN=kasm/emailAddress=none@none.none"; \
    chown 0:1000 /etc/kasm/self-default.pem; chmod 0640 /etc/kasm/self-default.pem; \
    # profile-sync (both versions the boot selects via KASM_PROFILE_LDR).
    ps="${svc}/$(basename "${PROFILE_SYNC_STORE_PATH:-__unset__}")"; \
    if [ -x "${ps}/bin/kasm-profile-sync" ]; then \
        ln -sf "${ps}/bin/kasm-profile-sync"   /usr/bin/kasm-profile-sync; \
        ln -sf "${ps}/bin/kasm-profile-sync-2" /usr/bin/kasm-profile-sync-2; \
        echo "profile-sync wired"; \
    else echo "profile-sync store unset — skipping"; fi; \
    # jq → /usr/bin/jq so nix-activate has it at runtime (nix-native, not apt).
    jqp="${svc}/$(basename "${JQ_STORE_PATH:-__unset__}")"; \
    if [ -x "${jqp}/bin/jq" ]; then ln -sf "${jqp}/bin/jq" /usr/bin/jq; echo "jq wired"; \
    else echo "jq store unset — skipping"; fi; \
    # staticx services at the /dockerstartup/<svc>/<binary> paths their units exec.
    wire() { p="$1"; d="$2"; b="$3"; \
      if [ -x "${p}/bin/${b}" ]; then mkdir -p "$(dirname "${d}")"; ln -sf "${p}/bin/${b}" "${d}"; echo "wired ${d}"; \
      else echo "skip ${d} (store unset)"; fi; }; \
    wire "${svc}/$(basename "${AUDIO_INPUT_STORE_PATH:-__unset__}")" /dockerstartup/audio_input/kasm_audio_input_server kasm_audio_input_server; \
    wire "${svc}/$(basename "${RECORDER_STORE_PATH:-__unset__}")"    /dockerstartup/recorder/kasm_recorder_service       kasm_recorder_service; \
    wire "${svc}/$(basename "${WEBCAM_STORE_PATH:-__unset__}")"      /dockerstartup/webcam/kasm_webcam_server            kasm_webcam_server; \
    wire "${svc}/$(basename "${GAMEPAD_STORE_PATH:-__unset__}")"     /dockerstartup/gamepad/kasm_gamepad_server          kasm_gamepad_server; \
    echo "resolute multi-store services wired under ${svc}"
