# nix-ubuntu: ubuntu core + Nix activation hooks.
#
# This image does NOT install Nix. It expects an OCI image built by
# bin/build-nix-store-volume to be mounted read-only at /nix at run
# time. Boot-time activation reads NIX_APP_PROFILES (CSV); per-user
# overrides live at $HOME/.config/nix-app/active.
#
# IMPORTANT: BASE_IMAGE must be a core image built from THIS fork's
# dockerfile-kasm-core (or dockerfile-kasm-core-minimal) — not the
# upstream kasmweb/core-ubuntu-noble. We drop a unit into
# /etc/container-init.d/, which only exists in container-init-based
# images.
#
# For single-app Nix images (browsers, Electron apps) prefer
# core-ubuntu-noble-minimal as BASE_IMAGE — Nix closures are
# self-contained so the stripped system LLVM/WebKit are not needed.
# See docs/nix-packaging-apps.md § "Choosing the base image".
# See docs/nix-how-to.md § "Step 1: build the core image" for build
# commands.
#
# See design/nix-package-process.md for the full design.

ARG BASE_IMAGE="localhost/kasm-core-ubuntu-noble:dev"
FROM $BASE_IMAGE

ARG DISTRO=ubuntu
USER 0

# nix-bwrap-run needs a real /usr/bin/bwrap to give buildFHSEnv apps
# (onlyoffice, steam, …) a real /nix/store under the /nix/store->/store
# symlink layout. It's normally inherited from the core base as a desktop
# dependency; self-heal if a future base drops it. No-op (fast) when present.
RUN command -v bwrap >/dev/null 2>&1 || { \
        apt-get update && \
        apt-get install -y --no-install-recommends bubblewrap && \
        rm -rf /var/lib/apt/lists/*; }

# Drop-in unit + scripts. The supervisor scans /etc/container-init.d/
# for additive units; ours is gated by ConditionPathIsDirectory so the
# image is still functional without the /nix volume mounted.
COPY src/ubuntu/install/nix/units/nix-activate.service \
     src/ubuntu/install/nix/units/nix-gpu-setup.service \
     /etc/container-init.d/
COPY src/ubuntu/install/nix/scripts/nix-activate \
     src/ubuntu/install/nix/scripts/nix-app \
     src/ubuntu/install/nix/scripts/nix-launch \
     src/ubuntu/install/nix/scripts/nix-bwrap-run \
     src/ubuntu/install/nix/scripts/nix-gpu-run \
     src/ubuntu/install/nix/scripts/nix-gpu-setup \
     /usr/local/bin/

RUN chmod 0755 /usr/local/bin/nix-activate /usr/local/bin/nix-app /usr/local/bin/nix-launch /usr/local/bin/nix-bwrap-run /usr/local/bin/nix-gpu-run /usr/local/bin/nix-gpu-setup && \
    /usr/local/bin/container-init \
        --units /etc/container-init/units \
        --drop-in /etc/container-init.d \
        --strict-units --validate

# Ubuntu's /etc/bash.bashrc (system-wide bashrc) is sourced by every
# interactive shell — including the non-login bash that XFCE-Terminal
# spawns. Source our generated /etc/profile.d/nix-app.sh from there
# so PATH and XDG_DATA_DIRS are visible in every terminal, not just
# login shells. The conditional `[ -f ]` makes this a no-op when no
# /nix volume is mounted (the file simply doesn't exist).
RUN { \
      echo ''; \
      echo '# nix-app: ensure interactive shells see the activated profiles.'; \
      echo '[ -f /etc/profile.d/nix-app.sh ] && . /etc/profile.d/nix-app.sh'; \
    } >> /etc/bash.bashrc
