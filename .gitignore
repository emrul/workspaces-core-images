target
.idea
*.iml
*.log
# but keep the pre-trusted Obsidian leveldb (its data file is a *.log)
!src/ubuntu/install/nix/tracelabs/assets/obsidian-userdata/**/*.log

# Editor swap files
*.swp
*.swo
# Local credential files — never commit. Artifact Keeper tokens, cosign keys etc.
.env
.env.*
!.env.example
bin/nix-profiles-tracelabs-spike.toml

# RapidFort credential helper, staged by ci-scripts/rf-fetch-credhelper.sh
.rf/
